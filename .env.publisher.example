# Separate protected cloud publisher configuration (never share with Studio or browser builds).
# Provision a dedicated NOINHERIT login granted `catalog_deployer` via `npm run cloud:provision-sql`.
CATALOG_PUBLISHER_DATABASE_URL=postgresql://catalog_publisher_prod:REPLACE_PRIVATELY@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres
CATALOG_RELEASE_REALM_FILE=/etc/gamemap/realm.json
CATALOG_CLOUD_TARGET_FILE=/etc/gamemap/cloud-target.json
CLOUD_PUBLICATION_RETENTION_DIR=/srv/gamemap/publication-retention

# Only required when pushing a verified artifact directly to a gh-pages branch outside GitHub Actions:
# GITHUB_PAGES_DEPLOY_TOKEN=
