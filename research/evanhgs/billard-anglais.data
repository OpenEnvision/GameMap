 a capability or authorship claim)","Original AI-associated candidate group","Current identity recorded in the ledger","canonical_repo","provenance","Recorded availability","public_available","availability","Research disposition (not resource or playable-case status)","qualified","disposition","Execution validation","Not run — read-only source inspection","execution_validation","Inspection performed","html_guidance_requirements_and_bounded_static_source_reviewed","inspection_scope","Review scope","Source inspected — not executed","review_status","lead","summary","requested_repo","ai_games","source-reviewed",[219,220,221,222],[212,166,155,144,132,121,109,94],"readme_blob_sha",{"_299":188,"_300":-5,"_301":186},"is_fork","parent_repo",1180116203,"existing_locations",[],"related_existing_entries",[],"related_repositories",[],"alternative_repo","alternative_url","metadata_scope","not_run",[274,275,276,277,278,279,280],[65,66,67,68],{"_281":169,"_282":297,"_284":298,"_24":166,"_286":165},{"_281":135,"_282":295,"_284":296,"_24":155,"_286":154},{"_281":135,"_282":293,"_284":294,"_24":144,"_286":143},{"_281":135,"_282":291,"_284":292,"_24":132,"_286":131},{"_281":112,"_282":289,"_284":290,"_24":121,"_286":120},{"_281":112,"_282":287,"_284":288,"_24":109,"_286":108},{"_281":100,"_282":283,"_284":285,"_24":94,"_286":91},"path","line_start",1,"line_end",4,"finding",360,373,301,317,135,185,105,132,54,73,133,138,"login","display_name","relationship",{"_303":304},"documents",{"_305":306,"_307":308},"en",[310,314,315,316,313,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,312,349,311,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367],"zh",[309,310,311,312,313],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositori