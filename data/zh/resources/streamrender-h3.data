205,206,207,208,209,210],"tags","hybrid-renderer","executable-state","streaming","three.js","MiniMax-H3","NVIDIA","延伸阅读",[213,214,215,216],{"_55":223,"_27":224},{"_55":221,"_27":222},{"_55":219,"_27":220},{"_55":217,"_27":218},"Weights and component licenses","https://huggingface.co/Efficient-Large-Model/StreamRender-H3","Pinned runtime source","https://github.com/NVlabs/Sana/tree/0527465fdcbbf27180a76419a4e73643aa1aac73/models/streamrender_h3","Agent workflow","https://nvlabs.github.io/Sana/Sol-Engine/docs/agent-workflow/","Sol-Engine","https://nvlabs.github.io/Sana/Sol-Engine/","项目源码",[227],{"_55":225,"_27":71},"用途与特点","NVIDIA Sol-Engine 的 Interactive Coding Worlds 使用 three.js 赛车游戏：引擎处理地图、物理、碰撞和输入，两步流式 MiniMax-H3 根据首帧与提示词渲染语义视频。公开训练和测试覆盖这一个游戏及第三人称视角，语义颜色代表类别而非独立物体。扩散渲染计时使用八张 GB200，因果解码器另在单张 GB200 测量；独立阶段耗时不能等同端到端输入显示延迟。运行源码与权重包已公开，各组件条款不同。","detail","资源类型","框架","分类","category","summary","name","framework",[246,247,248,249],[205,206,207,208,209,210],[244,245,108],[243,108],2026,"3d","code","scene",{"_55":223,"_27":224},{"_55":221,"_27":222},{"_55":219,"_27":220},{"_55":217,"_27":218},{"_251":252},"documents",{"_64":253,"_37":254},[256,260,261,262,259,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,258,295,257,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316],[255,256,257,258,259],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts