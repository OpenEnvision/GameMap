ble game.","教程",[248],{"_64":249,"_26":250,"_121":251},"Image to animated character","https://www.meshy.ai/developers/cookbook/recipes/animate-3d-character/","Official guide with reference files, Python and TypeScript examples, and GLB/FBX outputs. API access uses credits.","来源核查","2026-10-18","verified","适用方向",[258],"dimensions","3D","开发阶段",[262,263],"stages","资产与动画","引擎与场景","主题",[267,268,269,270,271,272],"tags","Image-to-3D","Rigging","Character animation","GLB","FBX","Commercial service","延伸阅读",[275],{"_64":276,"_26":277},"Rigging requirements","https://docs.meshy.ai/en/api/rigging",[279],{"_64":125,"_26":280},"https://docs.meshy.ai/en","用途与特点","官方动画角色流程把参考图转成带纹理、骨骼和待机、跳跃、攻击片段的角色，输出 GLB 和 FBX；动画阶段使用 Meshy 动作库。API 绑定更适合肢体清晰分离的标准带纹理双足角色。生成资产仍需引擎导入、碰撞、控制与性能检查；公开 cookbook 提供的是资产示例，而非完整玩法。","detail","资源类型","工具","分类","游戏制作","summary","name","production","tool",[303],{"_143":300,"_133":301,"_33":302},[267,268,269,270,271,272],[298,299],[297],"3d","assets","scene",{"_64":249,"_26":250,"_18":143,"_121":251},{"_64":243,"_26":244,"_18":239,"_121":245},{"_64":236,"_26":237,"_18":231,"_121":238},{"_64":276,"_26":277},{"_305":306},"documents",{"_76":307,"_36":308},[310,314,315,316,313,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,312,349,311,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370],[309,310,311,312,313],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","ass