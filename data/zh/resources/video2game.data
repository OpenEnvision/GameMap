lUrl",{"_55":72,"_26":76},"https://video2game.github.io/src/video2game/demo/garden_shoot1.mp4","video","src","poster","/GameMap/media/demos/recording-video2game-garden.webp","aspectRatio",1.507462686567164,"mobile","previewSrc","预览说明","Video2Game 官方浏览器录屏：方块角色站在重建花园中，前方圆桌上放着花瓶，画面保留操作说明和计分面板","alt","记录类型","原始项目记录","role","provenance","方向","3D","track","metadata","相关项目",[99],"resourceId",{"_55":100,"_26":101},"Video2Game","/zh/resources/video2game/","演示内容与范围","这是加入刚体交互的场景重建研究演示录屏。它并不表示任意输入视频都能直接变成完整游戏；重建、碰撞体设置与玩法集成仍是独立步骤。","limitations","引擎 / 渲染器","Three.js · WebGL","engine","演示类别","场景生成","demoType","lead","3d","scenes","source-recording","recordingId","video2game","resource:video2game","resource","把真实世界视频重建成可在浏览器交互的 3D 环境。","/zh/resources/",{"_20":116,"_192":100,"_190":112,"_53":193,"_191":119,"_186":185,"_26":183,"_65":194,"_167":195,"_161":196,"_158":197,"_152":198,"_149":148},[124,125,126,127,128,129,130,131,132,133,134,135,136,137],"website/src/data/resources.json",{"_53":22,"_57":100,"_59":192,"_61":-7,"_63":64},{"_53":111,"_57":119,"_59":191,"_61":-7,"_63":36},{"_53":54,"_55":188,"_57":189,"_59":190,"_61":95,"_63":36},{"_53":54,"_55":187,"_57":178,"_59":53,"_61":95,"_63":36},{"_53":54,"_55":184,"_57":185,"_59":186,"_61":62,"_63":36},{"_53":65,"_55":180,"_67":181,"_59":26,"_61":-7},{"_53":65,"_55":172,"_67":173,"_59":65,"_61":-7},{"_53":153,"_55":165,"_155":156,"_67":166,"_59":167,"_61":-7,"_63":64},{"_53":153,"_55":159,"_155":156,"_67":160,"_59":161,"_61":-7,"_63":64},{"_53":153,"_55":154,"_155":156,"_67":157,"_59":158,"_61":-7,"_63":64},{"_53":54,"_55":150,"_57":151,"_59":152,"_61":95,"_63":64},{"_53":54,"_55":147,"_57":148,"_59":149,"_61":95,"_63":64},{"_53":54,"_59":144,"_55":145,"_57":146,"_63":64},{"_53":65,"_59":138,"_55":139,"_67":140},"identitySource","身份来源",[141],{"_55":142,"_26":143},"University of Illinois Urbana-Champaign","https://arxiv.org/html/2404.09833","identity","项目身份与署名","The paper lists first author Hongchi Xia at both UIUC and Shanghai Jiao Tong University, with coauthors at UIUC and Cornell. UIUC is one verified first-author affiliation. This is its official brand CDN icon, linked by illinois.edu.","来源核查","2026-10-19","verified","年份","2024","year","list","适用方向","ordered",false,[93],"dimensions","开发阶段",[162,163,164],"stages","资产与动画","引擎与场景","世界模型","主题",[168,169,170,171],"tags","Video-to-3D","Reconstruction","Three.js","Collision","延伸阅读",[174,175],{"_55":178,"_26":179},{"_55":176,"_26":177},"Pinned engine-handoff recommendations","https://github.com/video2game/video2game/blob/7bcf8ae754240b9fd2de75a154eb73c75a146b79/readme.md#L256-L273","论文","https://arxiv.org/abs/2404.09833","项目源码",[182],{"_55":180,"_26":183},"https://github.com/video2game/video2game","用途与特点","视频与相机信息经过重建、网格提取、外观烘焙和碰撞生成，进入 three.js 游戏环境。文档中的 UE 路线建议完全漫反射的烘焙网格，将烘焙高光维度设为零。它采用显式环境重建，仍有手工场景设置与物理集成，与预测下一帧的交互视频世界模型不同。","detail","资源类型","分类","3D 开发","category","summary","name","paper",[202,203],[168,169,170,171],[199,200,201],[112],2024,"assets","scene","world",{"_55":204,"_26":179},{"_55":176,"_26":177},"Paper",{"_206":207},"documents",{"_64":208,"_36":209},[211,215,216,217,214,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,213,250,212,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271],[210,211,212,213,214],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-rese