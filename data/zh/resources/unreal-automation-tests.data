alse,[80,81],"dimensions","2D","3D","开发阶段",[85,86,87,88],"stages","玩法与代码","引擎与场景","测试验证","构建与发布","主题",[92,93,94,95,96],"tags","Unreal Engine","Automated testing","Blueprint","Visual regression","Content validation","延伸阅读",[99],{"_55":100,"_25":101},"Command-line reports and interrupted-run resumption","https://dev.epicgames.com/documentation/en-us/unreal-engine/run-automation-tests-in-unreal-engine","项目源码",[104],{"_55":102,"_25":105},"https://dev.epicgames.com/documentation/en-us/unreal-engine/automation-test-framework-in-unreal-engine","用途与特点","可将 Blueprint 编译、关卡加载、模拟输入与视觉回归接入代理反馈循环，并结合 Functional Testing 等接口。测试在引擎内运行，需要正确插件和状态清理。ResumeRunTest 读取已有 JSON 报告，继续 NotRun 测试，并把中断时仍在运行的测试标为失败；应保存报告并区分编辑器与客户端测试环境。","detail","guidance","资源类型","工具","分类","引擎与制作工具","category","lead","summary","name","engines","tool",[92,93,94,95,96],[127,128,129,130],[125,126],[124],{"_55":100,"_25":101},"2d","3d","code","scene","test","ship",{"_132":133},"documents",{"_68":134,"_35":135},[137,141,142,143,140,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,139,176,138,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197],[136,137,138,139,140],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","ag