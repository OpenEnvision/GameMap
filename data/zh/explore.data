5":1251,"_1127":33,"_1128":1252,"_1130":1253,"_1132":1254,"_1134":1255,"_1136":1250,"_1138":1253},{"_1125":1245,"_1127":33,"_1128":1246,"_1130":1247,"_1132":1248,"_1134":1249,"_1136":1250,"_1138":1247},{"_1125":1240,"_1127":33,"_1128":1241,"_1130":1242,"_1132":1243,"_1134":1244,"_1136":1137,"_1138":1242},{"_1125":1235,"_1127":33,"_1128":1236,"_1130":1237,"_1132":1238,"_1134":1239,"_1136":1137,"_1138":1237},{"_1125":1230,"_1127":33,"_1128":1231,"_1130":1232,"_1132":1233,"_1134":1234,"_1136":1137,"_1138":1232},{"_1125":1224,"_1127":33,"_1128":1225,"_1130":1226,"_1132":1227,"_1134":1228,"_1136":1137,"_1138":1229},{"_1125":1218,"_1127":33,"_1128":1219,"_1130":1220,"_1132":1221,"_1134":1222,"_1136":1137,"_1138":1223},{"_1125":1212,"_1127":33,"_1128":1213,"_1130":1214,"_1132":1215,"_1134":1216,"_1136":1137,"_1138":1217},{"_1125":1206,"_1127":33,"_1128":1207,"_1130":1208,"_1132":1209,"_1134":1210,"_1136":1137,"_1138":1211},{"_1125":1200,"_1127":33,"_1128":1201,"_1130":1202,"_1132":1203,"_1134":1204,"_1136":1137,"_1138":1205},{"_1125":1194,"_1127":33,"_1128":1195,"_1130":1196,"_1132":1197,"_1134":1198,"_1136":1137,"_1138":1199},{"_1125":1188,"_1127":33,"_1128":1189,"_1130":1190,"_1132":1191,"_1134":1192,"_1136":1137,"_1138":1193},{"_1125":1182,"_1127":33,"_1128":1183,"_1130":1184,"_1132":1185,"_1134":1186,"_1136":1137,"_1138":1187},{"_1125":1176,"_1127":33,"_1128":1177,"_1130":1178,"_1132":1179,"_1134":1180,"_1136":1137,"_1138":1181},{"_1125":1170,"_1127":33,"_1128":1171,"_1130":1172,"_1132":1173,"_1134":1174,"_1136":1137,"_1138":1175},{"_1125":1164,"_1127":33,"_1128":1165,"_1130":1166,"_1132":1167,"_1134":1168,"_1136":1137,"_1138":1169},{"_1125":1158,"_1127":33,"_1128":1159,"_1130":1160,"_1132":1161,"_1134":1162,"_1136":1137,"_1138":1163},{"_1125":1152,"_1127":33,"_1128":1153,"_1130":1154,"_1132":1155,"_1134":1156,"_1136":1137,"_1138":1157},{"_1125":1146,"_1127":33,"_1128":1147,"_1130":1148,"_1132":1149,"_1134":1150,"_1136":1137,"_1138":1151},{"_1125":1140,"_1127":33,"_1128":1141,"_1130":1142,"_1132":1143,"_1134":1144,"_1136":1137,"_1138":1145},{"_1125":1126,"_1127":33,"_1128":1129,"_1130":1131,"_1132":1133,"_1134":1135,"_1136":1137,"_1138":1139},"key","document:skills/level-design/templates/review","kind","id","skills/level-design/templates/review","title","关卡评审模板","description","Review a level's goals, spatial flow, readability, encounters, technical limits and next revisions using a reusable checklist.","url","/zh/docs/skills/level-design/templates/review/","descriptionLanguage","en","originalTitle","Level Review Template","document:skills/level-design/templates/playtest-report","skills/level-design/templates/playtest-report","试玩报告模板","Record a playtest's task, observed behavior, participant comments, blockers and follow-up checks without mixing evidence and interpretation.","/zh/docs/skills/level-design/templates/playtest-report/","Playtest Report Template","document:skills/level-design/templates/level-brief","skills/level-design/templates/level-brief","关卡简报模板","Fill in a level brief with player intent, scope, routes, encounter goals, constraints and observable acceptance criteria.","/zh/docs/skills/level-design/templates/level-brief/","Level Brief Template","document:skills/level-design/references/wayfinding-playtesting","skills/level-design/references/wayfinding-playtesting","寻路、玩家理解与试玩","Test how players understand a space using observed routes, wayfinding cues and playtest evidence rather than designer assumptions.","/zh/docs/skills/level-design/references/wayfinding-playtesting/","Wayfinding, Player Understanding, and Playtesting","document:skills/level-design/references/tools-quake","skills/level-design/references/tools-quake","工具、资源、TrenchBroom、Quake 与文件格式","Review TrenchBroom, Quake workflows and level file formats with the tool and engine boundaries each requires.","/zh/docs/skills/level-design/references/tools-quake/","Tools, Resources, TrenchBroom, Quake, and File Formats","document:skills/level-design/references/spatial-layout","skills/level-design/references/spatial-layout","布局、流线、垂直性、关键路线与门槛","Shape critical paths, alternate routes, gates, verticality and flow around the choices a player should make.","/zh/docs/skills/level-design/references/spatial-layout/","Layout, Flow, Verticality, Critical Paths, and Gates","document:skills/level-design/references/source-map","skills/level-design/references/source-map","来源索引与阅读范围","Trace the level-design skill's topics and adaptations to the original Level Design Book reading coverage.","/zh/docs/skills/level-design/references/source-map/","Source Map and Reading Coverage","document:skills/level-design/references/scripting-doors","skills/level-design/references/scripting-doors","脚本、导航与门","Specify scripted interactions, navigation dependencies and door states with readable feedback and recoverable behavior.","/zh/docs/skills/level-design/references/scripting-doors/","Scripting, Navigation, and Doors","document:skills/level-design/references/optimization-release","skills/level-design/references/optimization-release","优化、文档、打包与发布","Prepare a level for release through performance work, documentation, packaging and checks on the target build.","/zh/docs/skills/level-design/references/optimization-release/","Optimization, Documentation, Packaging, and Release","document:skills/level-design/references/lighting-art","skills/level-design/references/lighting-art","光照、暗部、环境美术、纹理与叙事","Use lighting, darkness, materials and environmental storytelling to support navigation, readability and the intended experience.","/zh/docs/skills/level-design/references/lighting-art/","Lighting, Darkness, Environment Art, Texturing, and Storytelling","document:skills/level-design/references/learning","skills/level-design/references/learning","学习、教学、练习、评审与作品集","Use exercises, critique, teaching methods and portfolio evidence to develop and explain level-design decisions.","/zh/docs/skills/level-design/references/learning/","Learning, Teaching, Exercises, Critique, and Portfolios","document:skills/level-design/references/foundations","skills/level-design/references/foundations","基础、前期制作、研究、世界构建与范围","Set player intent, research questions, worldbuilding constraints and project scope before drawing a level layout.","/zh/docs/skills/level-design/references/foundations/","Foundations, Pre-production, Research, Worldbuilding, and Scope","document:skills/level-design/references/culture-history","skills/level-design/references/culture-history","关卡设计的文化与历史实践","Place level-design practices in their cultural and historical context instead of treating familiar conventions as universal rules.","/zh/docs/skills/level-design/references/culture-history/","Level Design as Culture and Historical Practice","document:skills/level-design/references/combat-balance","skills/level-design/references/combat-balance","战斗、敌人职责、遭遇、掩体与地图平衡","Design encounters around enemy roles, sightlines, cover, movement and multiplayer balance, then test the resulting decisions.","/zh/docs/skills/level-design/references/combat-balance/","Combat, Enemy Roles, Encounters, Cover, and Map Balance","document:skills/level-design/references/case-studies","skills/level-design/references/case-studies","研究关卡与迁移设计关系","Study existing levels by reconstructing spatial and gameplay relationships, then adapt those relationships to a new brief.","/zh/docs/skills/level-design/references/case-studies/","Studying Levels and Transferring Their Relationships","document:skills/level-design/references/blockout-metrics","skills/level-design/references/blockout-metrics","灰盒、体量、地形、构图与尺度","Plan graybox massing, terrain, composition and player-scale metrics before committing to finished environment art.","/zh/docs/skills/level-design/references/blockout-metrics/","Blockout, Massing, Landscape, Composition, and Metrics","document:editorial-art-prompts","editorial-art-prompts","GameMap editorial art prompts","Inspect the prompts and provenance for GameMap's AI-generated editorial artwork, separate from authentic project previews.","/zh/docs/editorial-art-prompts/","document:design/v2/design-system","design/v2/design-system","Historical design archive · World Studio concept","Historical archive of the World Studio concept, preserving an earlier design iteration and its superseded build assumptions.","/zh/docs/design/v2/design-system/","document:design/design-system","design/design-system","Historical design archive · first concept","Historical archive of GameMap's first visual concept; its palette, fonts and layout are superseded rather than current requirements.","/zh/docs/design/design-system/","document:zh/publishing-platforms","zh/publishing-platforms","发现游戏，发布自己的作品","从官方入口了解 Steam、itch.io 等游戏平台，分清试玩、下载、源码与发行状态。","/docs/zh/publishing-platforms/","zh","document:zh/deployment","zh/deployment","在本地运行和发布 GameMap","预览完整静态网站，检查页面、导航与搜索，并通过 GitHub Pages 发布。","/docs/zh/deployment/","document:zh/level-design-skill","zh/level-design-skill","关卡设计 Skill","了解关卡设计 Skill 的适用范围、下载入口、简报与试玩模板，以及来源和非商业许可条件。","/docs/zh/level-design-skill/","document:zh/practical-guide","zh/practical-guide","从想法到可玩的游戏","用一个无需安装依赖的 HTML 小游戏跑通开始、游玩、胜负与重试，再完成一次边界明确的修改。","/docs/zh/practical-guide/","document:zh/reading-guide","zh/reading-guide","怎样使用这份资料库","按当前问题选择工具、案例或研究资料，分清来源、可运行性、许可与实际验证范围。","/docs/zh/reading-guide/","document:skills/level-design/LICENSE","skills/level-design/LICENSE","署名、许可与改编说明","Read attribution and CC BY-NC-SA 4.0 reuse conditions for the unofficial Level Design Book skill adaptation.","/zh/docs/skills/level-design/LICENSE/","Attribution, License, and Adaptation Notice","document:skills/level-design/SKILL","skills/level-design/SKILL","关卡设计：从体验意图到可测试空间","Route a level-design task from player intent and research through layout, grayboxing, playtesting and revision.","/zh/docs/skills/level-design/SKILL/","Level Design: From Intended Experience to Tested Space","document:content-model","content-model","内容模型与完整性检查","Understand registered content kinds, source ownership, localization, generated outputs and completeness checks.","/zh/docs/content-model/","Content model and coverage contract","document:icon-sources","icon-sources","GameMap 资源标志来源","Find the official sources, local files and attribution records for resource logos and visual identity assets.","/zh/docs/icon-sources/","GameMap resource logo sources","document:media-sources","media-sources","GameMap 演示媒体来源","Trace project previews and recordings to their original creators, capture methods, credits and reuse limitations.","/zh/docs/media-sources/","GameMap demo media sources","document:contributing","contributing","参与 GameMap 贡献","Contribute resources and game cases with primary evidence, accurate source scope, runnable access and clear attribution.","/zh/docs/contributing/","Contributing to GameMap","document:catalog","catalog","AI 游戏开发资源目录","Browse the complete resource catalog with categories, source links and scope notes for AI-assisted game development.","/zh/docs/catalog/","Awesome AI Game Development","document:overview","overview","GameMap","Explore GameMap, an OpenEnvision project connecting AI game-development tools, playable projects and practical production knowledge.","/zh/docs/overview/","document:community-case-research","community-case-research","社区 AI 游戏案例研究","Inspect the research log behind community game cases, including source completeness, AI attribution, play checks and rejected candidates.","/zh/docs/community-case-research/","Community AI game case review","document:source-revision-notes","source-revision-notes","来源版本与实现条件","Trace research claims to reviewed source revisions and distinguish stable release evidence from moving documentation.","/zh/docs/source-revision-notes/","Source revision and implementation boundaries","document:catalog-review-coverage","catalog-review-coverage","资源核查记录","Read the catalog's source-review ledger, including verification scope, rejected claims and remaining coverage gaps.","/zh/docs/catalog-review-coverage/","Catalog review coverage","document:agent-interface-evidence","agent-interface-evidence","编程代理的游戏接口","Review engine-agent interfaces for permissions, observations, reset behavior and evidence of the operations they actually expose.","/zh/docs/agent-interface-evidence/","Coding-agent game interfaces: source evidence","document:gameplay-state-contracts","gameplay-state-contracts","游戏状态、叙事检查点与持久效果","Specify durable gameplay state across saves, retries, narrative transitions, cancellation and restored world effects.","/zh/docs/gameplay-state-contracts/","Gameplay state, narrative checkpoints and durable effects","document:benchmark-reproducibility","benchmark-reproducibility","复现游戏开发基准","Audit game-agent benchmarks by environments, actions, resets, seeds, versions and the evidence needed to reproduce a result.","/zh/docs/benchmark-reproducibility/","Reproducing game-development benchmarks","document:game-development-evaluation","game-development-evaluation","游戏创作代理的评估研究","Choose evaluation tasks and metrics that distinguish code completion, game behavior, visual quality and player experience.","/zh/docs/game-development-evaluation/","Additional evaluation research for agents that create games","document:visual-feedback-mechanisms","visual-feedback-mechanisms","游戏创作框架的视觉反馈机制","Design a visual feedback loop that joins observations, task context, proposed edits and checks without treating an image as proof of success.","/zh/docs/visual-feedback-mechanisms/","Visual-feedback mechanisms for game-creation harnesses","document:visual-evidence-research","visual-evidence-research","视觉证据与代理运行框架","Choose screenshot, segmentation, video and frame-readback evidence with explicit capture identity and observation limits.","/zh/docs/visual-evidence-research/","Visual evidence and agent-harness research","document:asset-selection-feedback","asset-selection-feedback","资产候选选择与视觉反馈","Turn asset search and review into a bounded selection process with candidate identity, reasons, feedback and acceptance checks.","/zh/docs/asset-selection-feedback/","Asset candidate selection and visual-feedback creation","document:asset-validation-contracts","asset-validation-contracts","资产交换与验证方法","Validate sprites, tilemaps, meshes, rigs, collision, materials and audio against the runtime behavior each asset must support.","/zh/docs/asset-validation-contracts/","Asset interchange and validation contracts","document:generation-delivery-contracts","generation-delivery-contracts","生成任务、产物交付与资产获取","Track generated jobs and artifacts through retrieval, cancellation, provenance and delivery to an engine or content pipeline.","/zh/docs/generation-delivery-contracts/","Generation jobs, artifact delivery and asset acquisition","document:generative-api-boundaries","generative-api-boundaries","生成 API 与模型使用条件","Check authentication, job lifecycle, quotas, output access and usage conditions before integrating a generative service.","/zh/docs/generative-api-boundaries/","Generative API and model boundaries","document:generative-tools-research","generative-tools-research","生成工具研究","Review generation tools by the assets they produce, their documented interfaces and the work still required for game integration.","/zh/docs/generative-tools-research/","Generative tools: additional source-reviewed research","document:production-coverage-gaps","production-coverage-gaps","制作流程与待解决问题","See which production interfaces and evidence contracts are documented and which executable integrations remain unfinished.","/zh/docs/production-coverage-gaps/","Production coverage and remaining work","document:production-debugging-contracts","production-debugging-contracts","生产调试与验证方法","Match profiler, GPU, physics, memory and build evidence to a specific failure and a repeatable diagnostic task.","/zh/docs/production-debugging-contracts/","Production debugging and evidence contracts","document:native-operation-details","native-operation-details","原生工具操作与生命周期","Look up native commands and lifecycle boundaries for import, rendering, input, audio, dialogue and browser captions.","/zh/docs/native-operation-details/","Native operation details and lifecycle boundaries","document:studio-production-case-studies","studio-production-case-studies","工作室制作案例与验收经验","Translate documented game-studio engineering accounts into proposed workflows while preserving each source's scope and limits.","/zh/docs/studio-production-case-studies/","Studio production case studies and acceptance lessons","document:production-work-orders","production-work-orders","生产任务模板：交付物、恢复与验收","Adapt bounded production task templates for asset integration, navigation, multiplayer, builds and other engine workflows.","/zh/docs/production-work-orders/","Production work orders: artifacts, recovery and acceptance","document:engine-operation-contracts","engine-operation-contracts","引擎操作：完成、恢复与验证","Define engine operations with explicit inputs, completion, failure, cancellation and persisted output instead of relying on tool success messages.","/zh/docs/engine-operation-contracts/","Engine operations: completion, recovery, and evidence","document:production-research-notes","production-research-notes","制作工具与验收条件","Connect production-stage tools and interfaces to concrete artifacts, completion signals and the gaps that still need testing.","/zh/docs/production-research-notes/","Production tools and acceptance boundaries","document:research-index","research-index","游戏生产研究","Navigate production research by task, from engine operations and asset delivery to state, debugging and evaluation evidence.","/zh/docs/research-index/","Production research dossiers","document:world-model-notes","world-model-notes","代码世界模型：分类、选择与研究","Distinguish executable code worlds, hybrid renderers, neural simulation and generated 3D scenes, with release and hardware limits.","/zh/docs/world-model-notes/","Coding World Models: Categories, Selection, and Research Notes","document:cadle-repositories","cadle-repositories","Cadle 仓库研究资料","Inspect a source-reviewed ledger of Cadle-related games, browser projects, engines and agent harnesses, including unresolved candidates.","/zh/docs/cadle-repositories/","Cadle-like repository research import","document:game-ai-notes","game-ai-notes","2D / 3D 游戏开发 AI 研究","Review AI contributions across 2D and 3D development, including executable interfaces, version limits and evaluation claims.","/zh/docs/game-ai-notes/","2D / 3D Game Development AI: Research Notes","document:engines-notes","engines-notes","引擎、渲染库与内容工具","Compare game engines, rendering libraries and content tools by runtime role, source status and integration needs.","/zh/docs/engines-notes/","Engines, rendering libraries, and content tools: sources and scope","document:agents-notes","agents-notes","编程代理与游戏工具集成","Separate coding models, agent clients, skills and engine interfaces before choosing a game-development workflow.","/zh/docs/agents-notes/","Coding agents and game tool integrations: source review notes","document:game-testing-library","game-testing-library","游戏测试资源库","Choose runnable games, agent environments and asset sets for a concrete test, with setup and license boundaries.","/zh/docs/game-testing-library/","Game testing library","document:coding-agent-game-code","coding-agent-game-code","编程代理与游戏开发：工具与项目源码","Find coding-agent skills, engine bridges and implementation examples, with client, model and game-source attribution.","/zh/docs/coding-agent-game-code/","Coding agents × game development: code resources and game sources","document:tutorials-and-demos","tutorials-and-demos","AI 游戏开发案例","Play creator-documented AI game projects and inspect their complete source, setup steps and development evidence.","/zh/docs/tutorials-and-demos/","AI game builds","collection:claude-community-use-cases","claude-community-use-cases","Claude 社区案例","寻找创作者演示和开发记录；此项目集也包含游戏之外的影片、工具与实验。","/zh/examples/#collection-claude-community-use-cases","Claude community use cases","collection:open-source-ai-game-jam","open-source-ai-game-jam","Open Source AI Game Jam","浏览在代码、资产或玩法中使用 AI 的 Game Jam 作品；活动名称中的开源指 AI 工具，并不保证每个游戏都公开源码。","/zh/examples/#collection-open-source-ai-game-jam","collection:awesome-ai-built-games","awesome-ai-built-games","Awesome AI-Built Games","按动作、竞速、冒险、策略、解谜和街机等方向整理的社区游戏集，各项目公开源码的程度不同。","/zh/examples/#collection-awesome-ai-built-games","collection:astra-game-source-collection","astra-game-source-collection","Astra 游戏源码合集","按题材发现带试玩、源码和作者证据的游戏；具体编码客户端、生成范围与运行要求需查看每款作品的原始记录。","/zh/examples/#collection-astra-game-source-collection","Astra game-source collection","collection:ai-browser-game-jams","ai-browser-game-jams","AI 浏览器游戏创作赛","从历届 AI Browser Game Jam 发现短篇浏览器游戏及作者的工具、素材说明；参赛页面并不保证提供完整游戏源码。","/zh/examples/#collection-ai-browser-game-jams","AI Browser Game Jam","collection:vibe-jam-games","vibe-jam-games","Vibe Jam 游戏作品","浏览以 AI 编写主要代码为参赛条件的浏览器游戏。具体作品的工具归属与完整源码仍需逐项核对。","/zh/examples/#collection-vibe-jam-games","Vibe Jam games","demo:recording-holodeck","recording-holodeck","Holodeck · 从提示词到房间","作者发布的生成式波西米亚风客厅导览。","/zh/showcase/recording-holodeck/","Holodeck · A room from a prompt","demo:recording-infinigen","recording-infinigen","Infinigen · 程序化关节资产","官方演示通过程序化生成制作的关节资产。","/zh/showcase/recording-infinigen/","Infinigen · Articulated assets","demo:recording-trellis","recording-trellis","TRELLIS · 3D 资产生成","Microsoft Research 官方展示生成的 3D 资产，项目资料面向学术与研究用途提供。","/zh/showcase/recording-trellis/","TRELLIS · 3D asset generation","demo:recording-opengame","recording-opengame","OpenGame · 猫咪塔防演示","OpenGame 官方演示，展示生成的像素游戏如何运行。","/zh/showcase/recording-opengame/","OpenGame · Hajimi Defense: The Tuna Crisis","demo:recording-solarrenderer","recording-solarrenderer","SolarRenderer · 官方演示片","先预览官方赛博朋克街景，再观看完整影片中的更多结构控制与生成渲染示例。","/zh/showcase/recording-solarrenderer/","SolarRenderer · Official film","demo:solar-voxel","solar-voxel","SolarRenderer · 体素世界的视觉转换","简单体素场景转成风格丰富、持续运动的世界。","/zh/showcase/solar-voxel/","SolarRenderer · Voxel world, reimagined","demo:recording-streamrender-h3","recording-streamrender-h3","StreamRender-H3 · 引擎与神经渲染对照","官方同步比较：左侧为引擎输出，右侧为流式神经渲染，两幅画面均完整展示。","/zh/showcase/recording-streamrender-h3/","StreamRender-H3 · Engine → neural render","demo:streamrender-car","streamrender-car","StreamRender-H3 · 从引擎到神经渲染","同步比较引擎输入与相应的神经渲染画面。","/zh/showcase/streamrender-car/","StreamRender-H3 · Engine to neural render","demo:gamefactory-ue5-rpg","gamefactory-ue5-rpg","3AGameFactory · 村庄任务","穿过风格化村庄，收集宝藏并观察任务推进。","/zh/showcase/gamefactory-ue5-rpg/","3AGameFactory · Village quest","demo:gamefactory-ue5-combat","gamefactory-ue5-combat","3AGameFactory · 庭院战斗","在 Unreal Engine 5 游戏中接近敌人、交换攻击，观察生命值变化。","/zh/showcase/gamefactory-ue5-combat/","3AGameFactory · Courtyard combat","demo:opengame-skirmish","opengame-skirmish","OpenGame · 空间站交战","在生成的俯视角动作游戏中移动、瞄准与躲避。","/zh/showcase/opengame-skirmish/","OpenGame · Space-station skirmish","demo:opengame-portal","opengame-portal","OpenGame · 平台跑酷","在生成的像素平台游戏中跳跃、战斗与探索。","/zh/showcase/opengame-portal/","OpenGame · Portal runner","demo:recording-solarwm-overview","recording-solarwm-overview","SolarWM · 相机控制的世界","官方概览展示相机控制下的移动，穿行于生成的雪村、风景、遗迹等世界。","/zh/showcase/recording-solarwm-overview/","SolarWM · Camera-controlled worlds","demo:recording-triposr-assets","recording-triposr-assets","TripoSR · 单图三维重建","对照五张输入图片与对应的旋转三维重建结果，完整保留官方 TripoSR 演示的上下两行画面。","/zh/showcase/recording-triposr-assets/","TripoSR · Single-image 3D reconstruction","demo:recording-hunyuan3d-assets","recording-hunyuan3d-assets","Hunyuan3D 2.0 · 带纹理的生成资产","作者展示 Hunyuan3D 2.0 形状与纹理生成流程产出的三维角色，并通过旋转展示表面细节。","/zh/showcase/recording-hunyuan3d-assets/","Hunyuan3D 2.0 · Generated textured assets","demo:recording-sprite-forge","recording-sprite-forge","Agent Sprite Forge · 早期 0.3 精灵制作流程","早期 0.3 版本的短片展示 Ryo 案例从静态图、视频动画到抠色精灵条的制作流程。","/zh/showcase/recording-sprite-forge/","Agent Sprite Forge · Earlier 0.3 sprite workflow","demo:recording-autoue-workflow","recording-autoue-workflow","AutoUE · Unreal Engine 自动生成流程","官方演示记录了 Unreal Engine 编辑器中的自动生成工作流程。","/zh/showcase/recording-autoue-workflow/","AutoUE · Unreal Engine generation workflow","demo:recording-diamond-csgo","recording-diamond-csgo","DIAMOND · CS:GO 的扩散世界模型","作者使用键盘和鼠标操作扩散世界模型的录片；模型以 CS:GO 画面训练。","/zh/showcase/recording-diamond-csgo/","DIAMOND · A diffusion model of CS:GO","demo:recording-genie3-jetski","recording-genie3-jetski","Genie 3 · 灯节水上摩托","Google DeepMind 录制了夜间可控的水上摩托世界，生成的水面与灯笼画面上保留方向输入提示。","/zh/showcase/recording-genie3-jetski/","Genie 3 · Festival-of-lights jetski","demo:recording-wonderworld-cathedral","recording-wonderworld-cathedral","WonderWorld · 扩展教堂场景","官方分屏录片展示用户选择新内容与相机方向时，教堂场景如何逐步扩展。","/zh/showcase/recording-wonderworld-cathedral/","WonderWorld · Extending a cathedral scene","demo:recording-video2game-garden","recording-video2game-garden","Video2Game · 在重建花园中交互","官方浏览器录屏展示在视频重建的花园中移动，并发射球体与场景物体互动。","/zh/showcase/recording-video2game-garden/","Video2Game · Interacting in a reconstructed garden","demo:recording-sakura-crossing","recording-sakura-crossing","樱花道口 · 可漫步的街区","在本地 Qwen 辅助编写的卡通日式街区中，沿着运行中的铁路道口行走。","/zh/showcase/recording-sakura-crossing/","Sakura Crossing · A walkable neighbourhood","demo:recording-pokemon-tactics","recording-pokemon-tactics","宝可梦战术 · 等距战场","在 Babylon.js 渲染的 2D-HD 战场中调整站位并选择攻击目标。","/zh/showcase/recording-pokemon-tactics/","Pokemon Tactics · Isometric battle","demo:recording-marble-blue-diner","recording-marble-blue-diner","Marble · 蓝色餐厅三维场景","World Labs 的镜头游览展示由文本提示生成的蓝色餐厅，以及具有持久结构的三维室内空间。","/zh/showcase/recording-marble-blue-diner/","Marble · A blue diner in 3D","demo:recording-raccoon-heist","recording-raccoon-heist","浣熊大盗 · 夜色中搜刮","在巡逻手电的扫射下收集战利品，体验 Claude 制作的 Three.js 后院潜行游戏。","/zh/showcase/recording-raccoon-heist/","Raccoon Heist · Loot after dark","demo:recording-castle-clash","recording-castle-clash","城堡对决 · 原型攻防","招募小队，让 Tiny Swords 动画单位向敌方城堡推进。","/zh/showcase/recording-castle-clash/","Castle Clash · Prototype battle","demo:recording-cwm-brain-cloud-harbor","recording-cwm-brain-cloud-harbor","Code World Model · 云海港湾","官方录片中，一艘风帆艇在云海港湾航行，画面保留移动操作提示。","/zh/showcase/recording-cwm-brain-cloud-harbor/","Code World Model · Cloud-sea harbor","demo:recording-agent-arcade-galaxy","recording-agent-arcade-galaxy","Agent Arcade · 银河射击","Phaser 太空射击小游戏以透明桌面叠层运行，编辑器仍在背景中可见。","/zh/showcase/recording-agent-arcade-galaxy/","Agent Arcade · Galaxy Blaster","demo:recording-moonlight-mayhem","recording-moonlight-mayhem","月光与混乱 · 博物馆劫案","在 Three.js 博物馆中避开移动巡逻，救出浣熊同伴。","/zh/showcase/recording-moonlight-mayhem/","Moonlight & Mayhem · Museum heist","step:world/experience","world/experience","做成交互体验","结合模型许可、计算成本和实时要求，选择研究演示或产品原型，保留可复现配置与限制说明。","/zh/paths/world/#experience","Build an experience","step:world/consistency","world/consistency","检查一致性","测量长期漂移、动作响应、物体身份和碰撞，区分项目演示、论文评估与可复现的开放实现。","/zh/paths/world/#consistency","Test consistency","step:world/rendering","world/rendering","渲染世界","将引擎结构条件传给神经渲染器，分别检查几何、动作对齐、时间一致性和推理延迟。","/zh/paths/world/#rendering","Render the world","step:world/dynamics","world/dynamics","编写世界动态","探索表达状态转换和奖励的程序，或由代理更新环境的方法，检查长期状态、物体持续性和编辑能力。","/zh/paths/world/#dynamics","Code the dynamics","step:world/actions","world/actions","连接动作接口","定义动作空间与环境接口，区分语言命令、键盘输入和相机轨迹，让模型控制与预期交互一致。","/zh/paths/world/#actions","Connect actions","step:world/state","world/state","定义世界状态","明确世界由代码、显式场景还是视频潜变量表示，分别评估可编辑性、可解释性和视觉质量。","/zh/paths/world/#state","Define the state","path:world","world","探索代码世界模型","定义状态与动作，连接渲染，并检查世界中哪些信息会持续保留。","/zh/paths/world/","Explore code world models","step:3d/release","3d/release","发布游戏","面向目标平台打包，清理未使用资产并验证加载，记录引擎、插件版本、硬件要求和复现步骤。","/zh/paths/3d/#release","Ship your world","step:3d/testing","3d/testing","试玩与迭代","在引擎中测试场景连通、角色行为、物理稳定性和帧时间，结合任务检查与视觉证据评估生成结果。","/zh/paths/3d/#testing","Playtest & iterate","step:3d/assets","3d/assets","制作游戏资产","生成或寻找模型后，检查比例、拓扑、材质、骨骼和动画，准备引擎可以稳定加载与使用的资产。","/zh/paths/3d/#assets","Create the assets","step:3d/gameplay","3d/gameplay","实现游戏循环","在灰盒关卡中实现移动、相机、碰撞和关键交互，将运行状态和错误作为反馈提供给代理。","/zh/paths/3d/#gameplay","Build the loop","step:3d/engine","3d/engine","选择引擎","选择引擎、渲染器和物理方案，再接入 MCP 或编辑器自动化；同时考虑代码修改与场景、资产操作。","/zh/paths/3d/#engine","Choose an engine","step:3d/scope","3d/scope","规划与范围","定义相机、角色控制、核心交互和目标硬件，先做一个房间或关卡，控制 3D 项目的初始范围。","/zh/paths/3d/#scope","Plan & scope","path:3d","3d","制作 3D 游戏","先做好一个空间和核心循环，再准备可进入引擎的游戏资产。","/zh/paths/3d/","Build a 3D game","step:2d/release","2d/release","为目标平台构建，检查资产路径、控制和加载，记录依赖版本、生成提示词和已知限制，为后续迭代保留上下文。","/zh/paths/2d/#release","step:2d/testing","2d/testing","结合脚本输入、状态断言和关键截图，分别记录构建、玩法与视觉问题，再邀请玩家试玩并调整节奏。","/zh/paths/2d/#testing","step:2d/assets","2d/assets","制作美术资产","生成或寻找资产前，先确定美术方向、精灵尺寸、帧数和锚点；导入时检查透明通道、碰撞形状和动画状态。","/zh/paths/2d/#assets","step:2d/gameplay","2d/gameplay","逐步实现移动、交互、计分和重启，每次修改后都运行游戏并检查截图，逐渐连接成可玩的循环。","/zh/paths/2d/#gameplay","step:2d/engine","2d/engine","根据平台、编程语言和编辑需求选择引擎，为代理提供固定版本、官方 API 和可运行的起点。","/zh/paths/2d/#engine","step:2d/scope","2d/scope","定义玩家动作、胜负条件和目标平台，让首个版本集中在一个可重复的核心循环上。","/zh/paths/2d/#scope","path:2d","2d","制作 2D 游戏","从游戏简报到可分发构建，沿着小步、可重复的流程推进。","/zh/paths/2d/","Build a 2D game","testing-pack:asset-through-pipeline","asset-through-pipeline","让一个资产走完整条流程。","Kenney Animated Characters · Quaternius UAL · 100STYLE","/zh/testing/#pack-asset-through-pipeline","Move an asset through the pipeline.","testing-pack:give-an-agent-a-goal","give-an-agent-a-goal","给代理一个明确目标。","MiniGrid · Crafter · ViZDoom","/zh/testing/#pack-give-an-agent-a-goal","Give an agent a goal.","testing-pack:change-a-game","change-a-game","修改一个可运行的游戏。","Godot 官方示例 · SuperTux · Wesnoth","/zh/testing/#pack-change-a-game","Change a working game.","testing:mixamo","mixamo","Mixamo","常见的游戏动画制作流程，用于 AI 测试的权限仍需另行确认。","/zh/testing/mixamo/","testing:smpl-model","smpl-model","SMPL-Model","用于形状与姿态转换、人体到游戏骨骼流程的研究表示。","/zh/testing/smpl-model/","testing:smpl-body","smpl-body","SMPL-Body","采用 CC BY 许可的人体子集，适合人体网格、骨骼、蒙皮与姿态交换测试。","/zh/testing/smpl-body/","testing:amass","amass","AMASS","在统一参数空间中提供研究规模的人体动作，适合姿态流程与动作模型。","/zh/testing/amass/","testing:lafan1","lafan1","LaFAN1","面向动作补间、轨迹连续性和障碍过渡的研究数据与基线。","/zh/testing/lafan1/","testing:cmu-mocap","cmu-mocap","CMU Motion Capture Database","覆盖广泛的动作数据，适合骨骼解析、坐标转换、控制或重定向研究。","/zh/testing/cmu-mocap/","testing:100style","100style","100STYLE","带风格的移动数据，可用于动作匹配、步态多样性与跨骨骼重定向。","/zh/testing/100style/","testing:quaternius-ual","quaternius-ual","Quaternius Universal Animation Library","CC0 人形动画基线，适合重定向、移动混合和根运动测试。","/zh/testing/quaternius-ual/","testing:kenney-animated-characters","kenney-animated-characters","Kenney Animated Characters","小型 CC0 角色，适合首轮蒙皮、动画播放与导入回归检查。","/zh/testing/kenney-animated-characters/","testing:unity-asset-store","unity-asset-store","Unity Asset Store","在确认提供方权利与允许的自动化方式后，可用于资源包与导入回归测试。","/zh/testing/unity-asset-store/","testing:fab","fab","Fab","当具体条目、许可和 AI 使用字段符合任务条件时，可作为资产导入测试材料。","/zh/testing/fab/","testing:open-game-art","open-game-art","OpenGameArt","覆盖广泛的社区 2D 内容，适合内容测试，但需逐项记录和确认许可。","/zh/testing/open-game-art/","testing:ambientcg","ambientcg","ambientCG","CC0 纹理与资产来源，可建立通道、地形、光照和材质分辨率测试用例。","/zh/testing/ambientcg/","testing:poly-haven","poly-haven","Poly Haven","CC0 写实资产，适合材质、光照、依赖与视觉域回归测试。","/zh/testing/poly-haven/","testing:quaternius","quaternius","Quaternius","CC0 模型与角色，可用于可重复的导入、材质、碰撞和动画测试。","/zh/testing/quaternius/","testing:kenney","kenney","Kenney","适合小型测试场景、资产替换、碰撞和 UI 回归的 CC0 资源起点。","/zh/testing/kenney/","testing:unity-ml-agents","unity-ml-agents","Unity ML-Agents","官方工具与示例场景，覆盖物理、视觉控制、合作与竞争，可将自定义 Unity 场景接入 Python 策略和自动化测试。","/zh/testing/unity-ml-agents/","testing:godot-rl-agents","godot-rl-agents","Godot RL Agents","将可编辑 Godot 游戏连接到 Python 代理，适合在自有场景中修改玩法、暴露观察并评估 NPC 控制。","/zh/testing/godot-rl-agents/","testing:nethack-learning-environment","nethack-learning-environment","NetHack Learning Environment","面向探索、背包、战术选择和长期规划的复杂 Roguelike 接口，应使用持续维护的 NetHack-LE 组织版本，而不是已归档的 Facebook 仓库。","/zh/testing/nethack-learning-environment/","testing:vizdoom","vizdoom","ViZDoom","提供可编程动作与情景控制的第一人称环境，适合瞄准、导航、战斗和记忆任务；采用 3D 视角及 Doom 风格渲染技术。","/zh/testing/vizdoom/","testing:craftax","craftax","Craftax","支持向量化模拟的生存与合成环境，适合较长动作依赖，以及像素策略与符号策略的比较。","/zh/testing/craftax/","testing:crafter","crafter","Crafter","结合探索、生命、采集、建造与合成的小型生存世界，成就进度可揭示游玩代理的不同能力。","/zh/testing/crafter/","testing:minigrid","minigrid","MiniGrid / BabyAI","包含钥匙、门、物体和部分观察的小型导航与语言落地任务，适合作为可重复规划测试的初始基线。","/zh/testing/minigrid/","testing:unreal-lyra","unreal-lyra","Unreal Engine Lyra Starter Game","官方多人游戏起点，覆盖能力系统、输入、Game Feature 插件、角色动画和较复杂的引擎集成。","/zh/testing/unreal-lyra/","testing:unity-boatattack","unity-boatattack","Unity BoatAttack","完整船只竞速示例，适合浮力、航点 AI、相机、水面渲染、着色器和资产加载回归测试。","/zh/testing/unity-boatattack/","testing:zero-k","zero-k","Zero-K","即时战略游戏，适合资源规划、建造、单位控制、地形交互和多单位战术，提供可编辑的 Lua 游戏逻辑。","/zh/testing/zero-k/","testing:red-eclipse","red-eclipse","Red Eclipse","第一人称竞技场游戏，适合瞄准、导航、跑酷、机器人情景、实时地图编辑，以及原生客户端与服务端修改。","/zh/testing/red-eclipse/","testing:luanti-minetest-game","luanti-minetest-game","Luanti + Minetest Game","可编辑体素沙盒，支持第一人称导航、挖掘、放置、合成，以及 Lua 实体、纹理和世界修改。","/zh/testing/luanti-minetest-game/","testing:supertuxkart","supertuxkart","SuperTuxKart","完整竞速游戏，适合视觉转向、连续控制、物理回归、赛道、车辆与模型材质流程测试。","/zh/testing/supertuxkart/","testing:openttd","openttd","OpenTTD","交通运输模拟，适合路线与铁路建设、经济规划、寻路、存档和多人同步测试。","/zh/testing/openttd/","testing:mindustry","mindustry","Mindustry","物流与防御游戏，可在实际项目中研究生产链、建造、资源规划和客户端与服务端改动。","/zh/testing/mindustry/","testing:wesnoth","wesnoth","The Battle for Wesnoth","回合制战术游戏，提供可编辑场景与脚本，适合测试寻路、战术决策、对话和规则修改。","/zh/testing/wesnoth/","testing:ddnet","ddnet","DDraceNetwork (DDNet)","支持钩索、精确移动、地图和回放的合作平台游戏，适合输入时序与多人回归任务。","/zh/testing/ddnet/","testing:endless-sky","endless-sky","Endless Sky","完整太空游戏，支持导航、战斗、交易与长时任务规划，并提供可编辑数据和插件系统。","/zh/testing/endless-sky/","testing:supertux","supertux","SuperTux","完整平台游戏，适合在实际原生代码库中测试跳跃时序、碰撞、关卡编辑及画面与输入回归。","/zh/testing/supertux/","testing:godot-demos","godot-demos","Godot official demos","小型独立引擎项目，覆盖角色控制、物理、导航、网络、动画及导入导出，可作为回归测试起点。","/zh/testing/godot-demos/","agent:aider-pong-game-editing-transcript","aider-pong-game-editing-transcript","Aider · 含实际代码改动的官方 Pong 开发记录","Aider 官方示例记录制作 Pong，并调整球拍颜色、尺寸和球的行为。公开编辑块与已应用 Git 提交，使增量编程流程可以直接检查，而非只看最终截图。","/zh/agents/aider-pong-game-editing-transcript/","Aider: an official Pong build transcript with real code edits","agent:gamedev-agent-skills-router","gamedev-agent-skills-router","GameDev Agent Skills · 引擎分流与测试方案","社区技能库的路由器识别项目引擎，再加载任务专用指南。除链接目录外，还包含完整技能、带来源的代码方案、技能验证器及资产报告与预览工具。","/zh/agents/gamedev-agent-skills-router/","GameDev Agent Skills: engine router and test/code recipes","agent:playgama-web-game-assets-skill","playgama-web-game-assets-skill","Playgama · 资产制作技能与 GLB / 音频流程","帮助编程代理选择一致的资产集、记录署名并准备发布。可执行流程在保留名称的前提下清理、压缩 GLB，转换音频，并可重新编码纹理。","/zh/agents/playgama-web-game-assets-skill/","Playgama: asset-production skill and GLB/audio build pipeline","agent:playgama-web-game-performance-skill","playgama-web-game-performance-skill","Playgama · 网页游戏性能技能与可执行探测","在预热后测量实际游戏，以帧时间、JavaScript 开销、绘制调用和三角形数指导优化；包含无头测量脚本和用于真机观察的游戏内探针。","/zh/agents/playgama-web-game-performance-skill/","Playgama: web-game performance skill and executable probes","agent:godot-prompter-agent-skills","godot-prompter-agent-skills","GodotPrompter · 多代理技能与可复用移动代码","Godot 专用技能框架，覆盖玩法、场景架构、着色器、动画、测试、导出与代码审查；包含 GDScript / C# 方案、代理分流、平台元数据、OpenCode 插件和可机读的宿主验证状态。","/zh/agents/godot-prompter-agent-skills/","GodotPrompter: multi-agent Godot skills and reusable movement code","agent:phaser-official-agent-skills","phaser-official-agent-skills","Phaser 4 · 含引擎代码示例的官方代理技能","Phaser 引擎仓库提供场景、Arcade / Matter 物理、输入、资产、相机、动画、UI 与迁移技能。官方 README 列出多种编程代理，技能内含链接引擎源码的实际 API 示例。","/zh/agents/phaser-official-agent-skills/","Phaser 4: official coding-agent skills with engine code examples","agent:gemini-cli-godot-dock-bridge","gemini-cli-godot-dock-bridge","Gemini Assistant · 接入实际 Gemini CLI 的 Godot 面板","小型社区 Godot 插件，将面板提示发送给 Python 子进程，调用已安装的 gemini 命令，并处理返回的文件与目录创建指令；源码实现的是 CLI 集成，而非直接 Gemini API 聊天包装。","/zh/agents/gemini-cli-godot-dock-bridge/","Gemini Assistant: a Godot dock backed by the actual Gemini