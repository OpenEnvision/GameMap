7,1708,1709],"Play the fleet game and test sailing, combat, repairs, and upgrades.","Read the author’s collection-wide AI disclosure.","Inspect the individual HTML file’s game loop and fleet economy.","Download that file and change one ship statistic before replaying.","Joey Salmons 表示作品集从 AI Studio 中的 Gemini 2.5 Pro 与 Claude Sonnet 4.5 开始制作，手工修改仅涉及少量平衡调整；未明确这个版本使用的确切模型。",[1706,1707,1708,1709],{"_68":1598,"_32":1585,"_24":1468},{"_68":1701,"_32":747,"_24":1151,"_93":1702},{"_68":1696,"_32":1697,"_93":1698,"_1489":1490},{"_68":1584,"_32":1585,"_93":1693},[],"example:beach-kitty-ai-campaign","Beach Kitty","以猫为主角的 Phaser 关卡流程，结合跑酷、平台跳跃、射击和其他街机机制，可选生成猫咪美术。","/zh/examples/beach-kitty-ai-campaign/",{"_26":533,"_28":1718,"_30":1719,"_1183":1774,"_1180":151,"_141":1480,"_1175":1773,"_1168":1775,"_154":1776,"_156":1777,"_39":1778,"_1450":1779,"_1133":1780},[1723,1724,1725,1726,1727,1728,1729,1730,1731,1732,1733,1734,1735,1736,1737,1738,1739,1740,1741],{"_64":28,"_77":1718,"_66":28,"_84":-7,"_79":80},{"_64":142,"_77":1719,"_66":30,"_84":-7,"_79":42},{"_64":74,"_68":1181,"_77":1774,"_66":1183,"_84":136,"_79":80},{"_64":74,"_68":1179,"_77":111,"_66":1180,"_84":104,"_79":80},{"_64":74,"_68":1176,"_77":1478,"_66":141,"_84":1178,"_79":42},{"_64":74,"_68":1173,"_77":1773,"_66":1175,"_84":136,"_79":42},{"_64":105,"_68":1165,"_107":1166,"_70":1768,"_66":1168,"_84":-7,"_79":80},{"_64":65,"_68":1160,"_70":1764,"_66":154,"_84":-7},{"_64":74,"_68":1467,"_77":1763,"_66":154,"_84":-7,"_79":80},{"_64":74,"_68":1158,"_77":1159,"_66":156,"_84":-7,"_79":42},{"_64":65,"_68":1152,"_70":1759,"_66":156,"_84":-7},{"_64":74,"_68":81,"_77":1151,"_66":156,"_84":-7,"_79":80},{"_64":65,"_68":130,"_70":1754,"_66":39,"_84":-7},{"_64":74,"_68":1454,"_77":1455,"_66":39,"_84":-7,"_79":80},{"_64":65,"_68":1448,"_70":1749,"_66":1450,"_84":-7},{"_64":65,"_68":1131,"_70":1745,"_66":1133,"_84":-7},{"_64":105,"_66":1437,"_68":1438,"_70":1743,"_79":80},{"_64":1432,"_66":1433,"_68":753,"_599":1742,"_601":752,"_39":7