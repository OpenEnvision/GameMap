d the creator’s original Swedish request and AI attribution.","Open index.html locally and trace the game loop, level data and procedural graphics in game.js.","Ask an agent to change one brick pattern or power-up, then test launching, losing a life and restarting.","The creator’s Swedish README attributes the code, graphics, sound, music and levels to Claude Code using Claude Opus 5.5, and publishes the original one-sentence request. Treat this as a creator build disclosure, not an independently audited generation transcript.","Custom Canvas 2D · JavaScript · Web Audio",[4359,4360,4361,4362],{"_63":4357,"_31":830,"_23":2728},{"_63":4352,"_31":4353,"_23":1128,"_85":4354},{"_63":4347,"_31":4348,"_1463":1464,"_85":4349},{"_63":4343,"_31":830,"_85":4344},[1754],"example:supermarket-simulator-cursor","Supermarket Simulator","Manage a supermarket in first person: order goods, unpack deliveries, stock shelves and serve customers. The creator built this Unity experiment with Cursor and generated the 3D models with Hunyuan.","/examples/supermarket-simulator-cursor/",{"_25":473,"_27":4372,"_29":4373,"_1160":4427,"_1157":145,"_133":1454,"_1152":4426,"_1145":4428,"_87":4429,"_80":4430,"_38":4431,"_1424":4432,"_1110":4433},[4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396],{"_59":27,"_72":4372,"_61":27,"_77":-7},{"_59":134,"_72":4373,"_61":29,"_77":-7},{"_59":69,"_63":1158,"_72":4427,"_61":1160,"_77":128},{"_59":69,"_63":1156,"_72":104,"_61":1157,"_77":96},{"_59":69,"_63":1153,"_72":1452,"_61":133,"_77":1155},{"_59":69,"_63":1150,"_72":4426,"_61":1152,"_77":128},{"_59":97,"_63":1142,"_99":1143,"_65":4421,"_61":1145,"_77":-7},{"_59":60,"_63":1137,"_65":4418,"_61":87,"_77":-7},{"_59":69,"_63":1441,"_72":1442,"_61":87,"_77":-7},{"_59":69,"_63":1135,"_72":1922,"_61":80,"_77":-7},{"_59":60,"_63":1129,"_65":4413,"_61":80,"_77":-7},{"_59":69,"_63":74,"_72":1434,"_61":80,"_77":-7},{"_59":60,"_63":122,"_65":4409,"_61":38,"_77":-7},{"_59