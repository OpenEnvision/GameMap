 Claude Code and Gemini disclosure.","Inspect the Phaser scenes and React shell to understand their responsibilities.","Run npm install and npm run dev; the core game runs without a Gemini key.","The creator credits Claude Code and Google Gemini. The public project includes development progress logs, architecture notes, game scenes, and assets; Gemini also powers optional cat customization.","Phaser 3 · React · TypeScript",[1742,1743,1744,1745],{"_63":1739,"_31":1740,"_23":1755},{"_63":1734,"_31":733,"_23":1128,"_85":1735},{"_63":1729,"_31":1730,"_85":1731,"_1463":1464},{"_63":1724,"_31":1725,"_85":1726},[1754,1229],"claude-code","build-log","example:cursor-destruction-derby","Destruction Derby Arena","A browser car-combat arena with local two-player controls, computer opponents, collisions, and vehicle damage.","/examples/cursor-destruction-derby/",{"_25":513,"_27":1757,"_29":1758,"_1160":1453,"_1157":144,"_133":1454,"_1152":1805,"_1145":1806,"_87":1807,"_80":1808,"_38":1809,"_1424":1810,"_1110":1811},[1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779],{"_59":27,"_72":1757,"_61":27,"_77":-7},{"_59":134,"_72":1758,"_61":29,"_77":-7},{"_59":69,"_63":1158,"_72":1453,"_61":1160,"_77":128},{"_59":69,"_63":1156,"_72":103,"_61":1157,"_77":96},{"_59":69,"_63":1153,"_72":1452,"_61":133,"_77":1155},{"_59":69,"_63":1150,"_72":1805,"_61":1152,"_77":128},{"_59":97,"_63":1142,"_99":1143,"_65":1800,"_61":1145,"_77":-7},{"_59":60,"_63":1137,"_65":1797,"_61":87,"_77":-7},{"_59":69,"_63":1441,"_72":1442,"_61":87,"_77":-7},{"_59":69,"_63":1135,"_72":1136,"_61":80,"_77":-7},{"_59":60,"_63":1129,"_65":1793,"_61":80,"_77":-7},{"_59":69,"_63":74,"_72":1128,"_61":80,"_77":-7},{"_59":60,"_63":122,"_65":1788,"_61":38,"_77":-7},{"_59":69,"_63":1428,"_72":1429,"_61":38,"_77":-7},{"_59":60,"_63":1422,"_65":1783,"_61":1424,"_77":-7},{"_59":97,"_61":1411,"_63":1412,"_65":1781},{"_59":1406,"_61":1407,"_63":739,"_581":1780,"_583":738,"_38":737,"_591":592,"_5