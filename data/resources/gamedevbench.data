,79],"dimensions","2D","3D","Development stages",[83,84,85],"stages","Gameplay & code","Engines & scenes","Testing","Topics",[89,90,91,92],"tags","Development benchmark","Godot","Multimodal","Visual feedback","Further reading",[95],{"_52":96,"_25":97},"Paper","https://arxiv.org/abs/2602.11103","Project source",[100],{"_52":98,"_25":101},"https://github.com/waynchi/gamedevbench","Why it belongs here","The repository contains 333 tasks across 2D, 3D, UI, and gameplay logic. Agents receive an existing project and a task, then produce changes that can be checked in the engine. Comparable official runs require Godot 4.4.1 and provide image or video feedback. This measures bounded development tasks, not the quality of commercial games created from scratch.","detail","guidance","Resource type","Benchmark","Category","2D development","category","lead","summary","name","2d","benchmark",[125],[89,90,91,92],[122,123,124],[114,121],2026,"3d","code","scene","test",{"_52":96,"_25":97},{"_127":128},"documents",{"_129":130,"_131":132},"en",[134,138,139,140,137,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,136,173,135,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194],"zh",[133,134,135,136,137],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-e