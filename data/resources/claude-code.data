 progression and save flow.","The creator says Claude Code generated the game, tests and Blender art pipeline from plain-language requests while the human played on a phone and gave feedback. The repository contains the runtime art as well as its source builders.",[1122],"Custom Canvas 2D + Three.js · TypeScript",[1122],[1564,1565,1566,1567],{"_52":1562,"_27":1549,"_19":302},{"_52":1557,"_27":1558,"_19":258,"_247":1559},{"_52":355,"_27":1553,"_247":1554,"_300":301},{"_52":1548,"_27":1549,"_247":1550},[118,722,1160],"example:pokemon-tactics-claude","Pokemon Tactics","Move Pokemon across an isometric battlefield, use elevation and aim area attacks without hitting allies. This playable tactical fan game combines a TypeScript simulation with 2D-HD sprites on Babylon.js terrain.",{"_21":114,"_23":1579,"_25":1580,"_108":1636,"_90":113,"_287":292,"_284":1635,"_9":1637,"_268":1638,"_20":1639,"_34":1640,"_243":1641,"_236":1642},[1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602],{"_50":23,"_54":1579,"_56":23,"_58":-7},{"_50":112,"_54":1580,"_56":25,"_58":-7},{"_50":51,"_52":289,"_54":1636,"_56":108,"_58":59},{"_50":51,"_52":88,"_54":89,"_56":90,"_58":91},{"_50":51,"_52":285,"_54":286,"_56":287,"_58":87},{"_50":51,"_52":282,"_54":1635,"_56":284,"_58":59},{"_50":229,"_52":274,"_275":276,"_62":1630,"_56":9,"_58":-7},{"_50":60,"_52":269,"_62":1627,"_56":268,"_58":-7},{"_50":51,"_52":266,"_54":436,"_56":268,"_58":-7},{"_50":51,"_52":264,"_54":1626,"_56":20,"_58":-7},{"_50":60,"_52":259,"_62":1621,"_56":20,"_58":-7},{"_50":51,"_52":257,"_54":258,"_56":20,"_58":-7},{"_50":60,"_52":251,"_62":1617,"_56":34,"_58":-7},{"_50":51,"_52":249,"_54":250,"_56":34,"_58":-7},{"_50":60,"_52":241,"_62":1613,"_56":243,"_58":-7},{"_50":60,"_52":234,"_62":1611,"_56":236,"_58":-7},{"_50":229,"_56":230,"_52":231,"_62":1610},{"_50":219,"_56":116,"_52":1606,"_73":1607,"_83":1608,"_34":1609,"_224":225,"_226":227,"_57":341},{"_50":51,"_56":335,"_52":336,"_