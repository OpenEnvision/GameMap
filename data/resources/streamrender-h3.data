5,{"_71":134,"_72":135,"_74":136},"/GameMap/media/showcase/streamrender-car-mobile.mp4","/GameMap/media/showcase/streamrender-car-mobile.webp",0.8759124087591241,"StreamRender-H3 · Engine to neural render — a frame from the official project recording","Curated preview excerpt",[140],{"_50":92,"_27":93},"An engine-input and neural-render comparison. Both panels are preserved; this is recorded output.","excerpt","mobilePreview","resource:streamrender-h3","resource","A code engine maintains the world while streaming diffusion renders its semantic maps.","/resources/",{"_21":106,"_229":92,"_227":102,"_48":230,"_228":146,"_223":222,"_27":64,"_58":231,"_197":232,"_192":233,"_188":234,"_182":235,"_179":178},[151,152,153,154,155,156,157,158,159,160,161,162,163,164,165],"website/src/data/resources.json",{"_48":23,"_52":92,"_54":229,"_56":-7},{"_48":100,"_52":146,"_54":228,"_56":-7},{"_48":49,"_50":226,"_52":85,"_54":227,"_56":87},{"_48":49,"_50":224,"_52":225,"_54":48,"_56":87},{"_48":49,"_50":221,"_52":222,"_54":223,"_56":57},{"_48":58,"_50":218,"_60":219,"_54":27,"_56":-7},{"_48":58,"_50":204,"_60":205,"_54":58,"_56":-7},{"_48":183,"_50":195,"_185":186,"_60":196,"_54":197,"_56":-7},{"_48":183,"_50":190,"_185":186,"_60":191,"_54":192,"_56":-7},{"_48":183,"_50":184,"_185":186,"_60":187,"_54":188,"_56":-7},{"_48":49,"_50":180,"_52":181,"_54":182,"_56":87},{"_48":49,"_50":177,"_52":178,"_54":179,"_56":87},{"_48":174,"_54":175,"_50":176,"_71":73,"_79":78,"_34":64,"_55":53},{"_48":49,"_54":171,"_50":172,"_52":173},{"_48":58,"_54":166,"_50":167,"_60":168},"identitySource","Identity evidence",[169],{"_50":170,"_27":64},"NVIDIA Research","identity","Identity & attribution","The official project page footer identifies StreamRender-H3 as NVIDIA Research. The full, original vertical NVIDIA logo is supplied by the official NVIDIA Logo and Brand Guidelines page.","image","projectMedia","Creator project media","Source reviewed","2026-10-19","verified","Year","2026","year","list","Tracks","ordered",false,[189,85],"dimensions","3D","Development stages",[193,194,85],"stages","Gameplay & code","Engines & scenes","Topics",[198,199,200,201,202,203],"tags","hybrid-renderer","executable-state","streaming","three.js","MiniMax-H3","NVIDIA","Further reading",[206,207,208,209],{"_50":216,"_27":217},{"_50":214,"_27":215},{"_50":212,"_27":213},{"_50":210,"_27":211},"Weights and component licenses","https://huggingface.co/Efficient-Large-Model/StreamRender-H3","Pinned runtime source","https://github.com/NVlabs/Sana/tree/0527465fdcbbf27180a76419a4e73643aa1aac73/models/streamrender_h3","Agent workflow","https://nvlabs.github.io/Sana/Sol-Engine/docs/agent-workflow/","Sol-Engine","https://nvlabs.github.io/Sana/Sol-Engine/","Project source",[220],{"_50":218,"_27":64},"Why it belongs here","NVIDIA Sol-Engine's Interactive Coding Worlds system uses a three.js racing game. The engine handles map, physics, collision, and input, while a two-step streaming MiniMax-H3 model renders semantic video conditioned on a first frame and prompt. Reported training and tests cover that one game and third-person view. Semantic colors identify classes rather than individual objects. Diffusion-render timings use eight GB200 GPUs; the causal decoder is measured separately on one GB200. Independent stage timings do not establish end-to-end input-to-display latency. Runtime source and a weight bundle are public, with component-specific terms.","detail","Resource type","Framework","Category","category","summary","name","framework",[239,240,241,242],[198,199,200,201,202,203],[237,238,102],[236,102],2026,"3d","code","scene",{"_50":216,"_27":217},{"_50":214,"_27":215},{"_50":212,"_27":213},{"_50":210,"_27":211},{"_244":245},"documents",{"_246":247,"_248":249},"en",[251,255,256,257,254,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,253,290,252,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,30