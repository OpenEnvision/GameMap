 revisions.","Three.js · Rapier 3D · TypeScript",[742,743,744,745],{"_51":740,"_26":719,"_18":214},{"_51":735,"_26":736,"_18":204,"_194":737},{"_51":730,"_26":731,"_247":248,"_194":732},{"_51":726,"_26":719,"_194":727},[117,457],"example:clockout-unseen-codex","clockout-unseen-codex","Clock Out Unseen","Sneak out of three offices before time expires, using furniture, coffee distractions and a temporary folder disguise to avoid patrol sightlines and reach an elevator.","/examples/clockout-unseen-codex/",{"_20":755,"_22":756,"_24":757,"_107":809,"_89":237,"_233":238,"_230":808,"_9":810,"_215":811,"_19":812,"_33":813,"_190":814,"_181":815},[761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779],{"_49":22,"_53":756,"_55":22,"_57":-7},{"_49":111,"_53":757,"_55":24,"_57":-7},{"_49":50,"_51":235,"_53":809,"_55":107,"_57":58},{"_49":50,"_51":87,"_53":234,"_55":89,"_57":90},{"_49":50,"_51":231,"_53":232,"_55":233,"_57":86},{"_49":50,"_51":228,"_53":808,"_55":230,"_57":58},{"_49":173,"_51":221,"_222":223,"_61":803,"_55":9,"_57":-7},{"_49":59,"_51":216,"_61":800,"_55":215,"_57":-7},{"_49":50,"_51":213,"_53":301,"_55":215,"_57":-7},{"_49":50,"_51":211,"_53":212,"_55":19,"_57":-7},{"_49":59,"_51":205,"_61":796,"_55":19,"_57":-7},{"_49":50,"_51":203,"_53":204,"_55":19,"_57":-7},{"_49":59,"_51":198,"_61":792,"_55":33,"_57":-7},{"_49":50,"_51":196,"_53":197,"_55":33,"_57":-7},{"_49":59,"_51":188,"_61":787,"_55":190,"_57":-7},{"_49":59,"_51":179,"_61":785,"_55":181,"_57":-7},{"_49":173,"_55":174,"_51":175,"_61":784},{"_49":163,"_55":115,"_51":780,"_72":781,"_82":782,"_33":783,"_168":169,"_170":171,"_56":280},{"_49":50,"_55":160,"_51":161,"_53":646},"The public Bilibili Toy build during an opening Normal-mode movement check.","/GameMap/media/learning/clockout-unseen-codex.webp","Office-stealth gameplay with the player behind desks, a coworker, a minimap and 149 seconds remaining.","https://www.bilibili.com/toy/clockout-unseen/index.html",[177],[786],{"_51":95,"_26":96},[788],{"_51":789,"_26":790,"_194":791},"Read the explicit Codex and human contribution account","https://github.com/Ryan-fm/clockout-unseen/blob/main/docs/DEVELOPMENT.md","Creator record names GPT-6 Astra in Codex, gives selected requests and distinguishes independently generated artwork from coding-model work.",[793],{"_51":429,"_26":794,"_194":795},"https://github.com/Ryan-fm/clockout-unseen","Complete React/Canvas source, maps, original office/character PNGs, tests and Vite configuration. Run npm ci then npm run dev. No runtime AI key. README labels current source V2; verify hosted-version differences before comparing features.",[797],{"_51":798,"_26":783,"_194":799},"Play Clock Out Unseen","Chinese interface on Bilibili Toy. Wait for scene assets, then start a level. WASD/arrows move, E interacts and Space uses a folder disguise; mobile joystick/buttons are supplied. The game opened and started without sign-in.",[801],{"_51":802,"_26":790,"_194":-7},"Read the creator’s development record",[804,805,806,807],"Start Normal mode and move behind office furniture.","Read the selected prompts and model contribution record.","Trace movement, line-of-sight and disguise rules in the engine.","Change one patrol rule and check immediate detection, retry and level progression.","Ryan-fm supplied the office-stealth concept and approved the visual direction. GPT-6 Astra in Codex iterated on collisions, sightlines, patrols, interactions, progression, mobile controls and tests. A separate image-generation tool created office and character art.","Canvas 2D · React UI",[804,805,806,807],{"_51":802,"_26":790,"_18":318},{"_51":798,"_26":783,"_18":204,"_194":799},{"_51":429,"_26":794,"_247":248,"_194":795},{"_51":789,"_26":790,"_194":791},[117],"example:three-kingdoms-codex","three-kingdoms-codex","Three Kingdoms: Hundred Heroes","Manage gold and grain, develop cities and command officers across fifteen strongholds. Choose Wei, Shu or Wu and compete with two computer factions to unify the map.","/examples/three-kingdoms-codex/",{"_20":817,"_22":818,"_24":819,"_107":876,"_89":237,"_233":238,"_230":875,"_9":877,"_215":878,"_19":879,"_33":880,"_190":881,"_181":882},[823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842],{"_49":22,"_53":818,"_55":22,"_57":-7},{"_49":111,"_53":819,"_55":24,"_57":-7},{"_49":50,"_51":235,"_53":876,"_55":107,"_57":58},{"_49":50,"_51":87,"_53":234,"_55":89,"_57":90},{"_49":50,"_51":231,"_53":232,"_55":233,"_57":86},{"_49":50,"_51":228,"_53":875,"_55":230,"_57":58},{"_49":173,"_51":221,"_222":223,"_61":870,"_55":9,"_57":-7},{"_49":59,"_51":216,"_61":867,"_55":215,"_57":-7},{"_49":50,"_51":213,"_53":301,"_55":215,"_57":-7},{"_49":50,"_51":211,"_53":212,"_55":19,"_57":-7},{"_49":59,"_51":205,"_61":862,"_55":19,"_57":-7},{"_49":50,"_51":203,"_53":204,"_55":19,"_57":-7},{"_49":59,"_51":198,"_61":858,"_55":33,"_57":-7},{"_49":50,"_51":196,"_53":197,"_55":33,"_57":-7},{"_49":59,"_51":188,"_61":853,"_55":190,"_57":-7},{"_49":59,"_51":179,"_61":851,"_55":181,"_57":-7},{"_49":173,"_55":174,"_51":175,"_61":850},{"_49":163,"_55":115,"_51":846,"_72":847,"_82":848,"_33":849,"_168":169,"_170":171,"_56":651},{"_49":50,"_55":644,"_51":645,"_53":646},{"_49":59,"_55":639,"_51":640,"_61":843},[844],{"_51":640,"_26":845},"https://raw.githubusercontent.com/MartinDelophy/awesome-gpt-6-astra/ed10f435bfd298df8f88175c5cdb6405842a0da0/assets/screenshots/three-kingdoms/gameplay.jpg","The creator’s running v0.2.0 strategy-map screenshot.","/GameMap/media/learning/three-kingdoms-codex.webp","Fifteen-city Three Kingdoms map, Liu Bei resources, Chengdu development commands and the end-turn control.","https://github.com/MartinDelophy/awesome-gpt-6-astra/blob/ed10f435bfd298df8f88175c5cdb6405842a0da0/assets/screenshots/three-kingdoms/gameplay.jpg",[177],[852],{"_51":95,"_26":96},[854],{"_51":855,"_26":856,"_194":857},"Read the explicit Astra-in-Codex attribution","https://github.com/MartinDelophy/awesome-gpt-6-astra/blob/main/works/three-kingdoms/CREATION.md","The project initiator’s statement distinguishes human direction, Codex implementation and separately generated bitmap assets. It describes multiple iterations rather than one prompt.",[859],{"_51":429,"_26":860,"_194":861},"https://github.com/MartinDelophy/awesome-gpt-6-astra/tree/main/works/three-kingdoms","Includes rules, interface, 108 officers, generated terrain and portrait atlases, tests and deployment configuration. Node.js 22.13+; npm ci then npm run dev from works/three-kingdoms. Static export uses dist/client. Repository CC0; dependencies retain their own terms.",[863],{"_51":864,"_26":865,"_194":866},"Play Three Kingdoms","https://sanguo-jiangshan.vercel.app/","Simplified Chinese interface, mouse/touch controls, no login or API key. Choose a faction and start. Saves and JSON import/export are local to the current browser.",[868],{"_51":869,"_26":856,"_194":-7},"Read the creator’s contribution record",[871,872,873,874],"Choose a faction and inspect a city and its officers.","Read the creation record and portrait provenance.","Execute an economic order and follow its resource and officer effects.","Change one economy or combat rule and test turns, opponents and saves.","MartinDelophy supplied the strategy-game direction and requested more officers, portraits and balance changes. GPT-6 Astra in Codex iterated on rules, interface, data, opponents, saves and tests; a separate image tool generated terrain and portrait atlases.","DOM/CSS + SVG · React",[871,872,873,874],{"_51":869,"_26":856,"_18":318},{"_51":864,"_26":865,"_18":204,"_194":866},{"_51":429,"_26":860,"_247":248,"_194":861},{"_51":855,"_26":856,"_194":857},[117],"example:eight-second-crew-codex","eight-second-crew-codex","8-Second Crew · 8초 도둑단","Record an eight-second route, replay it as a clone and cooperate with earlier selves to steal a key and escape. Nine stages introduce pressure plates, patrols and projectiles.","/examples/eight-second-crew-codex/",{"_20":884,"_22":885,"_24":886,"_107":941,"_89":237,"_233":238,"_230":938,"_9":942,"_215":943,"_19":944,"_33":945,"_190":946,"_181":947,"_448":948},[890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909],{"_49":22,"_53":885,"_55":22,"_57":-7},{"_49":111,"_53":886,"_55":24,"_57":-7},{"_49":50,"_51":235,"_53":941,"_55":107,"_57":58},{"_49":173,"_51":445,"_222":446,"_61":939,"_55":448,"_57":-7},{"_49":50,"_51":87,"_53":234,"_55":89,"_57":90},{"_49":50,"_51":231,"_53":232,"_55":233,"_57":86},{"_49":50,"_51":228,"_53":938,"_55":230,"_57":58},{"_49":173,"_51":221,"_222":223,"_61":933,"_55":9,"_57":-7},{"_49":59,"_51":216,"_61":930,"_55":215,"_57":-7},{"_49":50,"_51":213,"_53":301,"_55":215,"_57":-7},{"_49":50,"_51":211,"_53":212,"_55":19,"_57":-7},{"_49":59,"_51":205,"_61":926,"_55":19,"_57":-7},{"_49":50,"_51":203,"_53":204,"_55":19,"_57":-7},{"_49":59,"_51":198,"_61":922,"_55":33,"_57":-7},{"_49":50,"_51":196,"_53":197,"_55":33,"_57":-7},{"_49":59,"_51":188,"_61":917,"_55":190,"_57":-7},{"_49":59,"_51":179,"_61":915,"_55":181,"_57":-7},{"_49":173,"_55":174,"_51":175,"_61":914},{"_49":163,"_55":115,"_51":910,"_72":911,"_82":912,"_33":913,"_168":169,"_170":171,"_56":280},{"_49":50,"_55":160,"_51":161,"_53":646},"The author-hosted game after recording the first clone.","/GameMap/media/learning/eight-second-crew-codex.webp","A duck thief and its recorded clone in the opening museum, with key, guard sight cone and eight-second HUD.","https://sdj3261.github.io/openai_game_2026/",[177],[916],{"_51":95,"_26":96},[918],{"_51":919,"_26":920,"_194":921},"Read the author’s human and Codex division of work","https://github.com/sdj3261/openai_game_2026#codex와-함께-만든-과정","README and the creator’s linked article describe concrete planning, implementation, sprite, QA and deployment work; neither is a complete session transcript.",[923],{"_51":429,"_26":924,"_194":925},"https://github.com/sdj3261/openai_game_2026","Complete static project with modules, nine stages, sprites, fonts, tests and demo recording. Node.js 18+; npm start, with no dependency installation. Code has no explicit license; the bundled Galmuri font uses OFL.",[927],{"_51":928,"_26":913,"_194":929},"Play 8-Second Crew","Korean, English and Japanese; keyboard, click-to-move and touch. WASD/arrows move, X records a clone, Z lures guards, and R restarts. Wait through the brief Ready countdown before moving.",[931],{"_51":932,"_26":920,"_194":-7},"Read the creator’s Codex build account",[934,935,936,937],"Start the first stage and learn movement, keys and exits.","Read the creator’s Codex development account and asset credits.","Press X to record a route, then inspect how the clone replays it.","Change a stage or replay rule and test a complete escape and restart.","DongJae Shin set the rules, difficulty and presentation, while Codex helped plan and implement stages, collision, replay, interface, tests and deployment. Agent Sprite Forge processed generated character sprites; the creator repeatedly playtested the result.",[940],"Agent Sprite Forge","Canvas 2D · Vanilla JavaScript · HTML/CSS UI",[934,935,936,937],{"_51":932,"_26":920,"_18":318},{"_51":928,"_26":913,"_18":204,"_194":929},{"_51":429,"_26":924,"_247":248,"_194":925},{"_51":919,"_26":920,"_194":921},[117],[940],"example:word-rain-chatgpt","word-rain-chatgpt","Word Rain","Move a basket to catch letters in the right order, complete shuffled words and survive red hazards. Shields, wildcards, perfect-word streaks and changing falling speed add decisions to the arcade spelling loop.","/examples/word-rain-chatgpt/",{"_20":950,"_22":951,"_24":952,"_107":1018,"_89":237,"_233":238,"_230":1017,"_9":1019,"_215":1020,"_19":1021,"_33":1022,"_190":1023,"_181":1024,"_577":1025},[956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975],{"_49":22,"_53":951,"_55":22,"_57":-7},{"_49":111,"_53":952,"_55":24,"_57":-7},{"_49":50,"_51":235,"_53":1018,"_55":107,"_57":58},{"_49":50,"_51":87,"_53":234,"_