 time states.","Read the creation record and art provenance.","Inspect puzzle rules separately from presentation code.","Modify one clue and verify uniqueness, hints and saved progress.","stackloomdev directed iterative GPT-6 Astra work in Codex on story, puzzles, bilingual text, interface, code, saves, procedural WebGL effects and tests. Background illustrations were generated separately; the 3D layer adds depth to point-and-click scenes.","Custom JavaScript · DOM/CSS · WebGL · Web Audio",[674,675,676,677],{"_51":672,"_26":658,"_18":318},{"_51":667,"_26":668,"_18":204,"_194":669},{"_51":662,"_26":663,"_247":248,"_194":664},{"_51":657,"_26":658,"_194":659},[117],"example:surge-for-oinja-codex","surge-for-oinja-codex","SURGE for Oinja","Shape an electrical build while surviving mechanical swarms across two interactive maps. Automatic attacks leave movement, dodging, upgrades and facility restoration to the player.","/examples/surge-for-oinja-codex/",{"_20":687,"_22":688,"_24":689,"_107":747,"_89":112,"_233":238,"_230":746,"_9":748,"_215":749,"_19":750,"_33":751,"_190":752,"_181":753},[693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712],{"_49":22,"_53":688,"_55":22,"_57":-7},{"_49":111,"_53":689,"_55":24,"_57":-7},{"_49":50,"_51":235,"_53":747,"_55":107,"_57":58},{"_49":50,"_51":87,"_53":88,"_55":89,"_57":90},{"_49":50,"_51":231,"_53":232,"_55":233,"_57":86},{"_49":50,"_51":228,"_53":746,"_55":230,"_57":58},{"_49":173,"_51":221,"_222":223,"_61":741,"_55":9,"_57":-7},{"_49":59,"_51":216,"_61":738,"_55":215,"_57":-7},{"_49":50,"_51":213,"_53":214,"_55":215,"_57":-7},{"_49":50,"_51":211,"_53":212,"_55":19,"_57":-7},{"_49":59,"_51":205,"_61":733,"_55":19,"_57":-7},{"_49":50,"_51":203,"_53":204,"_55":19,"_57":-7},{"_49":59,"_51":198,"_61":728,"_55":33,"_57":-7},{"_49":50,"_51":196,"_53":197,"_55":33,"_57":-7},{"_49":59,"_51":188,"_61":724,"_55":190,"_57":-7},{"_49":59,"_51":179,"_61":721,"_55":181,"_57":-7},{"_49":173,"_55":174,"_51":175,"_61":