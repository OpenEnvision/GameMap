# Dependencies and local package-manager caches.
# Keep package-lock.json (and any intentionally adopted lockfile) versioned.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Compiled websites: Vite/CI rebuild these from website/ and scripts/.
# dist/ also matches the obsolete website/dist/ directory.
dist/
/build/
/website/build/

# Obsolete standalone preview; the HTML document now lives in website/app/root.tsx.
/index.html

# React Router output and prepared copies of source documentation.
/.build/
/.react-router/
/website/.content/
/website/public/docs-assets/

# TypeScript, Vite, lint, and other disposable tool caches.
*.tsbuildinfo
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
.turbo/

# Test coverage and browser-test output, not source test fixtures or media.
coverage/
.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Local agent traces and machine-specific agent settings.
.pi-traces/
.claude/settings.local.json

# Runtime and package-manager logs.
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment configuration and secrets; keep example templates visible.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Temporary files, editor backups, and merge leftovers.
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# Local IDE/workspace state. Shared .vscode JSON configuration stays trackable.
.idea/
.history/
*.code-workspace
.vscode/*.local.json

# macOS and Windows metadata.
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Skill distribution archives are reproducibly generated from docs/skills/.
/website/public/skills/

# Intentionally versioned: README.md, AWESOME.md, docs/, data/, package-lock.json,
# website/app/, website/src/, and website/public/ assets/downloads.
# Some are generated editorial outputs; CI checks that they match their sources.
