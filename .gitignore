# Dependencies and local package-manager caches.
# Keep package-lock.json (and any intentionally adopted lockfile) versioned.
node_modules
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Disposable build copies; the complete published website at the repository root is versioned.
# dist/ also matches the obsolete website/dist/ directory.
dist/
/build/
/website/build/

# Release ZIPs are reproducible from the complete static website.
/release/

# React Router output and prepared copies of source documentation.
/.build/
/.react-router/
/website/.content/
/website/public/assets/docs/
# Previous generated image cache (cleaned by prepare-docs.mjs).
/website/public/docs-assets/

# TypeScript, Vite, lint, and other disposable tool caches.
*.tsbuildinfo
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
.turbo/

# Test coverage and browser-test output, not source test fixtures or media.
coverage/
.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Local agent traces and machine-specific agent settings.
.pi-traces/
.claude/settings.local.json

# Runtime and package-manager logs.
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment configuration and secrets; keep example templates visible.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Temporary files, editor backups, and merge leftovers.
# Video encoder safe-save remnants are never website assets.
*.mp4.sb-*
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# Local IDE/workspace state. Shared .vscode JSON configuration stays trackable.
.idea/
.history/
*.code-workspace
.vscode/*.local.json

# macOS and Windows metadata.
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Skill distribution archives are reproducibly generated from docs/skills/.
/website/public/skills/

# Intentionally versioned: the complete root website (index.html, .nojekyll,
# .gamemap-static.json, assets/, media/, and generated page folders), plus README.md,
# AWESOME.md, docs/, data/, package-lock.json, website/app/, website/src/, and
# website/public/ source assets/downloads. CI validates generated source outputs and
# the complete static publication; do not ignore the root publishing files.
