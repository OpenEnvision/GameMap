:118,"_86":60},{"_76":77,"_78":1392,"_80":1393,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":4161,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":4159,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":4149,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":4147,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":4146,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":4145,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1356,"_80":1357,"_82":1358,"_84":118,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":1626,"_82":1627,"_78":1628,"_101":4141,"_110":4142,"_57":4143,"_83":4144},{"_76":77,"_82":1350,"_78":1351,"_80":4140,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4137},[4138],{"_78":3487,"_50":4139},"https://github.com/Tencent-Hunyuan/Hunyuan3D-2","The official model repository is owned by Tencent-Hunyuan. That organization links to hy.tencent.com. Use its actual brand image rather than an unrelated 3D icon.","/GameMap/media/demos/hunyuan3d-2.webp","Official Tencent Hunyuan3D 2.0 generation results showing cartoon character assets on a pink background","https://github.com/Tencent-Hunyuan/Hunyuan3D-2#%EF%B8%8F-hunyuan3d-20","Tencent Hunyuan · Hunyuan3D 2.0",[116],[1368],[3583,4071,4148,4032],"Textures",[4150,4151,4152],{"_78":4157,"_50":4158},{"_78":4155,"_50":4156},{"_78":4153,"_50":4154},"2.0 license","https://github.com/Tencent-Hunyuan/Hunyuan3D-2/blob/main/LICENSE","2.1 repository","https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1","2.0 paper","https://arxiv.org/abs/2501.12202",[4160],{"_78":1386,"_50":4139},"2.0 流程用 Hunyuan3D-DiT 生成形状，再用 Hunyuan3D-Paint 生成网格纹理，支持 GLB、OBJ 导出和 Blender 插件，采用腾讯混元 3D 2.0 专用社区许可。独立的 2.1 版本增加 PBR 纹理流程和训练代码。拓扑、LOD、绑定、碰撞、运行性能及各版本条款仍需按游戏流程核查。",[4166,4167,4168],[3583,4071,4148,4032],[174],[133],{"_78":4157,"_50":4158},{"_78":4155,"_50":4156},{"_78":4153,"_50":4154},"resource:godot-3d-asset-skill","godot-3d-asset-skill","Godot MCP 3D Asset Builder","用 Godot 几何与验证流程构建可复用的风格化 3D 资产。","/zh/resources/godot-3d-asset-skill/",{"_44":4170,"_1397":4171,"_1395":133,"_76":2335,"_1396":4172,"_1391":4202,"_50":4191,"_1372":4203,"_1367":4204,"_1364":4205,"_1355":1429},[4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187],{"_76":46,"_80":4171,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":4172,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":3716,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":2356,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":4202,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":4200,"_82":50,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":4195,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":4194,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":4193,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":4192,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4188},[4189],{"_78":4190,"_50":4191},"LuigiDeFacci","https://github.com/LuigiDeFacci/godot-create-3d-assets","The public repository is independently maintained by LuigiDeFacci. Its image files are scene screenshots, with no project or institutional mark found. The account image is a default GitHub identicon, so it must not be used as a logo. Show the maintainer name without inventing an affiliation or reusing the Godot engine logo.",[116],[1368,1369,1580],[4196,4197,4198,4199],"Godot","Agent Skill","PackedScene","Asset QA",[4201],{"_78":1386,"_50":4191},"接收项目风格和资产需求，通过 Godot MCP 与确定性构建器生成 PackedScene，检查落地、碰撞、导航和截图。面向 Codex 与 Claude Code，可复用项目已有资源；需要兼容的 MCP 能力，不是图像转网格生成模型。",[4196,4197,4198,4199],[174,1404,1597],[133],"resource:mcp-unity","mcp-unity","MCP Unity Editor","用于查询、编辑和测试 Unity 项目的社区 MCP 桥接。","/zh/resources/mcp-unity/",{"_44":4207,"_1397":4208,"_1395":133,"_76":1398,"_1396":4209,"_1391":4238,"_50":4228,"_1372":4239,"_1367":4240,"_1364":4241,"_1355":1429},[4213,4214,4215,4216,42