r 编辑器，自动截图和游戏交互需要另外接入。",[6503,6504],[4287,6485,6486,6487,6488],[1505,1597],[257,133,303],{"_78":6494,"_50":6495},{"_78":6492,"_50":6493},"resource:cline","cline","Cline","支持多模型、Plan / Act 模式、项目规则和 MCP 的开源编程代理。","/zh/resources/cline/",{"_44":6506,"_1397":6507,"_1395":5973,"_76":4872,"_1396":6508,"_1391":6539,"_50":6527,"_88":6540,"_1372":6541,"_1367":6542,"_1364":6543,"_1355":1429},[6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524],{"_76":46,"_80":6507,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":6508,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":5972,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":4871,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":6539,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":6537,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":6534,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":6531,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":6530,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":6529,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":6528,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":6525},[6526],{"_78":6507,"_50":6527},"https://github.com/cline/cline","Exact Cline project icon referenced at the top of the official README.",[242,116,297],[1672,1482,1580],[6532,4272,6487,4233,6533],"IDE","Plan / Act",[6535],{"_78":2568,"_50":6536},"https://docs.cline.bot/",[6538],{"_78":1386,"_50":6527},"可在 IDE 或 CLI 中审查、修改游戏代码，把构建输出和 MCP 编辑器工具接入反馈循环。用 .clinerules 和技能包记录引擎约定，具体编辑器操作能力取决于桥接服务。",[6544],[6532,4287,6487,4233,6533],[1688,1505,1597],[257,133,303],{"_78":4487,"_50":6536},"resource:opencode","opencode","OpenCode","支持多种模型服务、Plan / Build 模式和项目指令的开源编程代理。","/zh/resources/opencode/",{"_44":6546,"_1397":6547,"_1395":5973,"_76":4872,"_1396":6548,"_1391":6582,"_50":6581,"_88":6583,"_1372":6584,"_1367":6585,"_1364":6586,"_1355":1429},[6552,6553,6554,6555,6556,