1355":1429},[4297,4298,4299,4300,4301,4302,4303,4304,4305,4306,4307,4308,4309,4310],{"_76":46,"_80":4292,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":4293,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":3716,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":4333,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":4332,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":4329,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":4322,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":4318,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":4317,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":4316,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1356,"_80":1962,"_82":1358,"_84":118,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":4315,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4311},[4312],{"_78":4313,"_50":4314},"Nitrode","https://arxiv.org/html/2607.03525","The paper lists Brian La, Sejoon Chang, and Ben Kim at Nitrode, provides research@nitrode.com, and links the Nitrode-Research repository. Other affiliations include Nexon Intelligence Labs and several universities. The paper explicitly says authors' views do not necessarily reflect employer or institutional policy. The mark is linked from Nitrode's official site.",[116],[1482,1580],[4319,737,4320,4321],"Development benchmark","C++","Behavior tests",[4323,4324],{"_78":4327,"_50":4328},{"_78":4325,"_50":4326},"Versioned evaluation protocol","https://arxiv.org/html/2607.03525v2","Paper-linked repository (availability unverified)","https://github.com/Nitrode-Research/GameEngineBench",[4330],{"_78":1386,"_50":4331},"https://arxiv.org/abs/2607.03525","论文 v2 描述了来自九个 Unreal 项目的 110 项 C++ 任务，代理获得可构建的起点、允许修改的文件和行为要求。编译与 Play-in-Editor 监听服务器测试后，由 LLM 评判需求、测试证据、改动及参考解。核查时无法取得论文链接仓库，可运行代码是否可获取仍需确认；任务范围是局部 C++ 实现，不是完整 3D 游戏生成。","基准测试",[4338,4339],[4319,737,4320,4321],[1505,1597],[133],{"_78":