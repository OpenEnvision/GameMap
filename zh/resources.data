95,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1445,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":1592,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":1589,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":1586,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":1581,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":1579,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":1578,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1356,"_80":1430,"_82":1358,"_84":118,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":1577,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":1574},[1575],{"_78":1576,"_50":762},"University of Geneva","The project page lists equal-contribution first authors Eloi Alonso (University of Geneva) and Adam Jelley (University of Edinburgh), with Microsoft Research also involved. Select the first author’s first institution, Geneva. The SVG is from the official university homepage and was provided/verified by the root agent.",[242,116,297],[1580,297],"测试验证",[1484,1485,1582,1583,1584,1585],"diffusion","Atari","reinforcement-learning","NeurIPS-2024",[1587],{"_78":1588,"_50":762},"Code and playable models",[1590],{"_78":1386,"_50":1591},"https://arxiv.org/abs/2405.12399","Visual Details Matter in Atari 研究将扩散模型作为环境，让代理从想象轨迹学习，分析视觉细节对策略的影响。除 Atari 100k 评估外，论文还用录制的 CS:GO 游玩数据训练可交互神经引擎，适合研究模拟、控制与累积预测误差。",[1598],[1484,1485,1582,1583,1584,1585],[1597,303],[257,133,303],"test",{"_78":1588,"_50":762},"resource:gamengen","gamengen","GameNGen — Diffusion Models Are Real-Time Game Engines","从 DOOM 游玩轨迹训练可交互的扩散模拟器。","/zh/resources/gamengen/",{"_44":1600,"_1397":1601,"_1395":303,"_76":1446,"_1396":1602,"_1391":1642,"_50":1641,"_88":1643,"_1372":1644,"_1367":1645,"_1364":1646,"_1358":1451,"_1355":1429},[1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620],{"_76":46,"_80":1601,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":1602,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":297,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1445,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":1642,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":1639,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":1637,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":1634,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":1633,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":1632,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1356,"_80":1430,"_82":1358,"_84":118,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":1626,"_82":1627,"_78":1628,"_101":1629,"_110":1630,"_57":1624,"_83":1631},{"_76":77,"_82":1350,"_78":1351,"_80":1625,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":1621},[1622],{"_78":1623,"_50":1624},"Google Research","https://gamengen.github.io/","The project page lists equal-contribution authors Dani Valevski and Yaniv Leviathan at Google Research; Moab Arar at Tel Aviv University with work done while at Google Research; and Shlomi Fruchter at Google DeepMind. Select Google Research, the first listed organization. Logo is the official google-research organization avatar from https://github.com/google-research.","image","projectMedia","创作者项目媒体","/GameMap/media/demos/gamengen.webp","Official GameNGen method figure showing model training to predict the next frame from prior game frames and actions","GameNGen authors · method figure",[116,297],[1580,297],[1484,1485,1582,1635,1636],"DOOM","ICLR-2025",[1638],{"_78":1439,"_50":1624},[1640],{"_78":1386,"_50":1641},"https://arxiv.org/abs/2408.14837","先由强化学习代理采集轨迹，再让扩散模型根据视觉历史与动作预测下一帧，并用条件噪声增强减轻自回归误差。论文在单张 TPU 上展示实时 DOOM 模拟；这种特定游戏神经模拟并不会自动提供可维护的通用游戏规则或资产流程。",[1647],[1484,1485,1582,1635,1636],[1597,303],[133,303],{"_78":1453,"_50":1624},"resource:genie-3","根据提示词生成可实时探索的交互视频世界。",{"_44":810,"_1397":807,"_1395":303,"_76":1398,"_1396":1649,"_1391":1682,"_50":798,"_1372":1683,"_1367":1684,"_1364":1685,"_1358":1403,"_1355":1354,"_88":1686},[1652,1653,1654,1655,1656,1657,1658,1659,1660,1661,1662,1663,1664,1665],{"_76":46,"_80":807,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":1649,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":297,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1393,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":1682,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":1680,"_82":50,"_84":-7},{"_76":88,"_78":1378,"_90":1676,"_82":88,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":1673,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":1671,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":1670,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1356,"_80":1357,"_82":1358,"_84":118,"_86":87},{"_76":77,"_78":1353,"_80":1354,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":1669,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":1666},[1667],{"_78":1668,"_50":798},"Google DeepMind","Genie 3 is introduced on the official Google DeepMind blog. Use the official google-deepmind organization avatar, consistently with the original Genie paper.",[116,297],[1672,297],"需求规划",[1485,1484,1674,1675,1377],"text-to-world","Google-DeepMind",[1677],{"_78":1678,"_50":1679},"Project Genie access and limits","https://support.google.com/labs/answer/16875695?hl=en",[1681],{"_78":1386,"_50":798},"Google DeepMind 2025 年 8 月研究演示报告 720p、24 FPS 的交互世界，可保持数分钟一致性。独立的 Project Genie 原型将探索限制为 60 秒，当前帮助页要求可用地区内符合条件、年满 18 岁的个人 Google AI Ultra 账户。文档支持下载视频，但未确立可下载引擎源码、可导出关卡资产或确定性玩法规则。",[1485,1484,1674,1675,1377],[1688,303],[133,303],[1687],{"_78":1678,"_50":1679},"plan","resource:genie","genie","Genie: Generative Interactive Environments","从没有动作标签的视频中，学习由潜在动作控制的 2D 世界。","/zh/resources/genie/",{"_44":1690,"_1397":1691,"_1395":303,"_76":1446,"_1396":1692,"_1391":1722,"_50":1721,"_1372":1723,"_1367":1724,"_1364":1725,"_1358":1451,"_1355":1429},[1696,1697,1