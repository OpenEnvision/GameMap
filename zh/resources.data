io.com/","Hosted creative tool requiring an account; this is an asset workspace, not a playable game.",[3645],{"_78":3646,"_50":3647,"_2319":3648},"Consistent game asset pipeline","https://docs.scenario.com/get-started/documentation/integrating-with-applications-real-world-scenarios#1-game-asset-pipeline--batch-generation-with-style-consistency","Official walkthrough for custom style training, batch generation, and asset delivery.",[242,116],[1368,1369],[3652,3653,3654,3655,3209],"Art direction","Style consistency","Character consistency","Batch assets",[3657,3658,3659],{"_78":3664,"_50":3665},{"_78":3662,"_50":3663},{"_78":3660,"_50":3661},"Job cancellation scope","https://mcp.scenario.com/docs/tools/job-cancel","Official beta MCP operations","https://mcp.scenario.com/docs/tools/model-run","API documentation","https://docs.scenario.com/",[3667],{"_78":1386,"_50":3668},"https://www.scenario.com/","提供托管的图像、视频、3D、音频生成、自定义模型训练、REST API 及官方 beta MCP 接口。提交前检查每个模型的 schema；MCP model_run 可能返回未完成任务而非资产，文档中的 job_cancel 不能取消 model_run 或 workflow_run 创建的任务。公开集成示例不包含完整托管服务或完整游戏。",[3678,3679,3680],{"_2364":3675,"_43":3676,"_57":3677},[3652,3653,3654,3655,3209],[174,1404],[257,133],{"_78":3646,"_50":3647,"_42":2364,"_2319":3648},{"_78":3641,"_50":3642,"_42":3119,"_2319":3643},{"_78":3637,"_50":3633,"_42":3113,"_2319":3638},{"_78":3664,"_50":3665},{"_78":3662,"_50":3663},{"_78":3660,"_50":3661},"resource:tripo-generation-api","tripo-generation-api","Tripo Model Generation API","按版本提供文生模型能力，分别控制几何和纹理随机种子。","/zh/resources/tripo-generation-api/",{"_44":3682,"_1397":3683,"_1395":133,"_76":1398,"_1396":3684,"_1391":3715,"_50":3704,"_88":3717,"_1372":3718,"_1367":3719,"_1364":3720,"_1355":1354},[3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700],{"_76":46,"_80":3683,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":3684,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":3716,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1393,"_82":76,"_84":118,"_86":60},{"_7