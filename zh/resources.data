61":1362,"_90":4470,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":4469,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4465},[4466],{"_78":4467,"_50":4468},"PixelLab","https://www.pixellab.ai/mcp","The official PixelLab site describes its MCP asset service. The pixellab-code GitHub organization names itself PixelLab and links back to www.pixellab.ai; this is its official organization image, not a generated symbol.",[242],[1368,1369],[4473,4474,4475,4233,3209],"Pixel art","Sprite","Tileset",[4477],{"_78":2568,"_50":4478},"https://www.pixellab.ai/docs",[4480],{"_78":1386,"_50":4468},"根据角色描述、朝向、动作与地形条件生成像素资产，包括四向、八向角色，以及侧视或俯视瓦片集。它是商业资产服务；MCP 连接资产工具与编程代理，游戏规则、碰撞和资产导入仍需项目流程实现。",[4486],[4473,4474,4475,4233,3209],[174,1404],[257],{"_78":4487,"_50":4478},"Documentation","resource:text2game","text2game","Text2Game","把长文本转成世界、角色和事件数据，用于叙事游戏原型。","/zh/resources/text2game/",{"_44":4489,"_1397":4490,"_1395":257,"_76":1398,"_1396":4491,"_1391":4520,"_50":4510,"_1372":4521,"_1367":4522,"_1364":4523,"_1355":1429},[4495,4496,4497,4498,4499,4500,4501,4502,4503,4504,4505,4506],{"_76":46,"_80":4490,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":4491,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":4409,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1393,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":4520,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":4518,"_82":50,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":4514,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":4513,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":4512,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":4511,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4507},[4508],{"_78":4509,"_50":4510},"Song Li · boltomli","https://github.com/boltomli/t2g","The public repository is maintained under boltomli, whose GitHub profile names Song Li. Its README and file index expose no project or institutional brand mark. The profile image is a toy photograph and is not used as a logo. Show the verified maintainer name without inventing a school or company mark.",[242],[1672,1482,1369],[4515,4516,4196,4517],"Interactive narrative","Twine","Visual novels",[4519],{"_78":1386,"_50":4510},"分块分析文本、合并结果，并生成 Twine / Chapbook HTML 或 Godot 视觉小说项目。仓库提供 Python 流程与示例，适合研究叙事到可玩原型的转换，不是任意动作游戏的通用生成器。",[4515,4516,4196,4517],[1688,1505,1404],[257],"resource:agent-game-forge","agent-game-forge","Agent Game Forge","面向 Codex 与 Claude Code 的本地 2D 游戏 IDE，包含可视化场景编辑器。","/zh/resources/agent-game-forge/",{"_44":4525,"_1397":4526,"_1395":257,"_76":1398,"_1396":4527,"_1391":4557,"_50":4546,"_1372":4558,"_1367":4559,"_1364":4560,"_1355":1429},[4531,4532,4533,4534,4535,4536,4537,4538,4539,4540,4541,4542],{"_76":46,"_80":4526,"_82":1397,"_84":-7,"_86":87},{"_76":131,"_80":4527,"_82":1396,"_84":-7,"_86":60},{"_76":77,"_78":1394,"_80":4409,"_82":1395,"_84":118,"_86":60},{"_76":77,"_78":1392,"_80":1393,"_82":76,"_84":118,"_86":60},{"_76":77,"_78":1389,"_80":4557,"_82":1391,"_84":85,"_86":60},{"_76":88,"_78":1386,"_90":4555,"_82":50,"_84":-7},{"_76":1359,"_78":1370,"_1361":1362,"_90":4550,"_82":1372,"_84":-7,"_86":87},{"_76":1359,"_78":1365,"_1361":1362,"_90":4549,"_82":1367,"_84":-7,"_86":87},{"_76":1359,"_78":1360,"_1361":1362,"_90":4548,"_82":1364,"_84":-7,"_86":87},{"_76":77,"_78":1353,"_80":1429,"_82":1355,"_84":118,"_86":87},{"_76":77,"_82":1350,"_78":1351,"_80":4547,"_86":87},{"_76":88,"_82":1345,"_78":1346,"_90":4543},[4544],{"_78":4545,"_50":4546},"Agent Game Forge · 0x0funky","https://github.com/0x0funky/agent-game-forge","This is the actual project logo committed in the official repository's web/public directory, with several size variants. The repository is independently maintained by 0x0funky; no university or corporate affiliation is asserted.",[242],[1672,1482,1368,13