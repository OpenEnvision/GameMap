ap state.","Built for agent research. Preserve license notices; explicitly separate rendered pixels, symbolic observations and mission text in each evaluation.",[1660,1661,1662],{"_47":1667,"_24":1668},{"_47":1665,"_24":1666},{"_47":1663,"_24":1664},"Pinned RGB visibility and wrapper implementation","https://github.com/Farama-Foundation/Minigrid/blob/7f5853792ea7f04f75614661006d87fcf949f26d/minigrid/wrappers.py","Observation wrappers","https://minigrid.farama.org/api/wrappers/","Installation and BabyAI tasks","https://github.com/Farama-Foundation/Minigrid#readme",[1670],{"_47":250,"_24":1671},"https://github.com/Farama-Foundation/Minigrid/blob/main/LICENSE","Use bundled procedural grid rendering; added images and datasets need their own provenance.","Apache-2.0 in the current repository.",[1675],{"_47":1540,"_24":1676,"_269":1677},"https://minigrid.farama.org/","Install minigrid locally; no commercial game or model API is required.",[1679],{"_47":271,"_24":1680},"https://github.com/Farama-Foundation/Minigrid","Python · Gymnasium · discrete grid worlds",[833],[150,116],[152,118],[845],{"_47":1540,"_24":1676,"_269":1677},[1690,1691,1692],[1655,1656,1657],[1651,1652,1653],{"_47":1667,"_24":1668},{"_47":1665,"_24":1666},{"_47":1663,"_24":1664},"testing:unreal-lyra","unreal-lyra","Unreal Engine Lyra Starter Game","官方多人游戏起点，覆盖能力系统、输入、Game Feature 插件、角色动画和较复杂的引擎集成。","/zh/testing/unreal-lyra/",{"_18":1694,"_20":1695,"_16":1752,"_284":1753,"_281":1754,"_278":1748,"_287":1696,"_273":1737,"_266":1755,"_263":1741,"_260":1740,"_256":1274,"_252":1735,"_243":1756,"_240":1727,"_235":1757,"_229":1758,"_223":1718,"_220":219},[1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711,1712,1713,1714,1715,1716,1717],{"_45":20,"_49":1695,"_51":20,"_53":-7,"_55":95},{"_45":76,"_49":1696,"_51":287,"_53":-7,"_55":34},{"_45":46,"_47":285,"_49":1751,"_51":16,"_53":81,"_55":34},{"_45":224,"_47":78,"_226":233,"_58":1750,"_51":284,"_53":-7,"_55":95},{"_45":224,"_47":279,"_226":233,"_58":1749,"