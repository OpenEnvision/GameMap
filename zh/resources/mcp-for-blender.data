2":73,"_74":75,"_33":76,"_77":78,"_79":80,"_81":82},{"_59":60,"_61":62,"_63":64,"_65":66,"_67":68},"type","text","field","captureDate","label","截图采集","value","2026-10-18","language","en","image","gameplay","The live Godot build: neon territory capture and moving enemies.","src","/GameMap/assets/media/learning/tron-exonix-claude.webp","alt","The neon TRON: EXONIX game board with a player vehicle, moving enemies, and territory boundaries.","https://www.top3d.ai/demo/exonix-build/index.html","width",1280,"height",720,"credit","GameMap browser capture","list","attribution","创作者记录中的客户端与模型","items",[88],"Claude Code","links","相关资源",[94,95,96,97],"resourceIds","section",{"_63":88,"_26":104},{"_63":102,"_26":103},{"_63":100,"_26":101},{"_63":98,"_26":99},"MCP for Blender","/zh/resources/mcp-for-blender/","Godot MCP · Coding-Solo","/zh/resources/godot-mcp/","Godot Engine · Official Documentation","/zh/resources/godot-engine/","/zh/resources/claude-code/","创作者开发记录",[108],"evidence",{"_63":109,"_26":110,"_111":112},"Read how the agent workflow was assembled","https://github.com/witnesstodark/tron-exonix/blob/master/CLAUDE.md","note","The creator’s reproducible setup record explains the AI’s implementation work, human material review, generation tools, and local launch requirements.","源码内容","complete project","项目源码",[117],{"_63":118,"_26":119,"_111":120},"Open the complete Godot game project","https://github.com/witnesstodark/tron-exonix","Includes the Godot project, scripts, shaders, models, textures, audio, and generation scripts. Local play requires Godot 4.7 standard; API access is only needed to regenerate assets.","获取方式","playable","demo","试玩与运行",[126],{"_63":127,"_26":76,"_111":128},"Play TRON: EXONIX","Creator-hosted Godot web build. Click to enter the grid, press Space to deploy, use the arrow keys to move, and Escape for the menu. A keyboard and a WebGL-capable browser are recommended.","游戏平台","浏览器","指南形式","教程","tutorial","开发记录与教程",[136],{"_63":137,"_26":138,"_111":-7},"Follow the creator’s complete workflow","https://www.top3d.ai/learn/claude-godot-mcp-3d-game","研究这个工作流","ordered",true,[143,144,145,146],"Play the web build and study territory capture, trail hazards, enemy movement, and sector progression.","Follow the creator’s tutorial from prototype through materials, audio, effects, and web export.","Read CLAUDE.md to understand the agent, Godot MCP, Blender review, and asset-generation workflow.","Open game/project.godot in Godot 4.7 and press F5; study the scripts alongside the included models, textures, and audio.","AI 工作流与开发背景","作者记录 Claude 编写玩法、着色器、视觉特效和 UI，人工引导机制与材质。仓库包含实际 Godot 游戏、生成资产及资产生成脚本。","aiUse","guidance","创作方式","AI 辅助（创作者归属）","category","provenance","方向","3D","track","metadata","资产制作工具",false,[163,164,165,166,167,168],"assetTools","Blender","Nano Banana","PATINA","Tripo","Stable Audio","ElevenLabs","引擎","Godot 4.7 · GDScript","engine","lead",[163,164,165,166,167,168],"3d","ai-assisted",[143,144,145,146],{"_63":137,"_26":138,"_18":133},{"_63":127,"_26":76,"_18":122,"_111":128},{"_63":118,"_26":119,"_186":187,"_111":120},{"_63":109,"_26":110,"_111":112},[182,183,184,185],"claude-code","godot-engine","godot-mcp","mcp-for-blender","scope","complete-project","resource:mcp-for-blender","resource","让代理进行建模、材质设置、Python 执行和视觉反馈的 Blender 插件与 MCP 服务。","/zh/resources/",{"_20":185,"_255":98,"_153":256,"_59":257,"_254":190,"_249":248,"_26":213,"_232":258,"_225":259,"_222":260,"_219":218,"_89":261},[195,196,197,198,199,200,201,202,203,204,205,206,207],"website/src/data/resources.json",{"_59":22,"_65":98,"_61":255,"_93":-7,"_67":68},{"_59":172,"_65":190,"_61":254,"_93":-7,"_67":36},{"_59":60,"_63":252,"_65":253,"_61":153,"_93":158,"_67":36},{"_59":60,"_63":250,"_65":251,"_61":59,"_93":158,"_67":36},{"_59":60,"_63":247,"_65":248,"_61":249,"_93":150,"_67":36},{"_59":89,"_63":115,"_86":245,"_61":26,"_93":-7},{"_59":89,"_63":237,"_86":238,"_61":89,"_93":-7},{"_59":83,"_63":230,"_140":160,"_86":231,"_61":232,"_93":-7,"_67":68},{"