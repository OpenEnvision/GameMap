92,"_62":93,"_94":-7},{"_60":84,"_62":85,"_64":86,"_87":88,"_68":69},{"_60":70,"_62":71,"_64":72,"_73":74,"_75":76,"_34":77,"_78":79,"_80":81,"_82":83},{"_60":61,"_62":63,"_64":65,"_66":67,"_68":69},"type","text","field","captureDate","label","截图采集","value","2026-10-18","language","en","image","gameplay","Browser capture during a run after starting and jumping, with a live distance counter.","src","/GameMap/assets/media/learning/running-man-claude-pixellab.webp","alt","Running Man character crossing a scrolling road beneath a pixel-art mountain landscape.","https://games.jdilig.me/games/running-man/","width",1280,"height",720,"credit","GameMap browser capture","list","attribution","创作者记录中的客户端与模型","items",[89],"Claude Code","links","相关资源",[95,96],"resourceIds","section",{"_64":89,"_27":99},{"_64":97,"_27":98},"PixelLab AI Agent Toolkit","/zh/resources/pixellab/","/zh/resources/claude-code/","创作者开发记录",[103],"evidence",{"_64":104,"_27":105,"_106":107},"Read the tool and asset disclosure","https://github.com/balbonits/ai-browser-game-demos#tools-used","note","The creator identifies Claude Code, PixelLab, synthesized audio, and human direction.","源码内容","complete project","项目源码",[112],{"_64":113,"_27":114,"_106":115},"Open the game collection source","https://github.com/balbonits/ai-browser-game-demos","Self-contained games with code, PixelLab assets, sound synthesis, and per-game notes.","获取方式","playable","demo","试玩与运行",[121],{"_64":122,"_27":77,"_106":123},"Play Running Man","Space, Up, W, or tap starts and jumps. P or Esc pauses; R retries after death.","游戏平台","浏览器","指南形式","build log","tutorial","开发记录与教程",[131],{"_64":132,"_27":133,"_106":-7},"Read the game’s development notes","https://github.com/balbonits/ai-browser-game-demos/blob/main/docs/games/running-man.md","研究这个工作流","ordered",true,[138,139,140],"Play a run and test jumping, death, retry, and pause.","Read the per-game notes and asset inventory.","Compare animation frames and obstacle hitboxes with the renderer and collision code.","AI 工作流与开发背景","John Dilig 将代码归属于 Claude Code，将像素美术归属于通过 MCP 接入的 PixelLab，并由人工指导。项目记录说明资产与后续改动。","aiUse","guidance","创作方式","AI 生成（创作者归属）","category","provenance","方向","2D","track","metadata","引擎","Canvas 2D · JavaScript","engine","lead","2d","ai-generated",[138,139,140],{"_64":132,"_27":133,"_19":169},{"_64":122,"_27":77,"_19":117,"_106":123},{"_64":113,"_27":114,"_106":115,"_167":168},{"_64":104,"_27":105,"_106":107},[165,166],"claude-code","pixellab","scope","complete-project","build-log","example:katana-kitsune-godot","katana-kitsune-godot","Katana Kitsune: Prototype","选择狐妖剑士，在等距视角的动作肉鸽中迎战妖怪、管理体力、拾取道具并深入地牢。这个无声原型支持本地多人，当前源码还记录了后续队伍系统。","/zh/examples/katana-kitsune-godot/",{"_21":171,"_23":172,"_25":173,"_155":259,"_151":157,"_147":260,"_143":249,"_254":261,"_9":244,"_128":262,"_118":263,"_34":264,"_102":265,"_93":266},[177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197],{"_60":23,"_66":172,"_62":23,"_94":-7,"_68":69},{"_60":156,"_66":173,"_62":25,"_94":-7,"_68":37},{"_60":61,"_64":153,"_66":259,"_62":155,"_94":144,"_68":69},{"_60":84,"_64":251,"_135":252,"_87":253,"_62":254,"_94":-7,"_68":69},{"_60":61,"_64":149,"_66":150,"_62":151,"_94":152,"_68":69},{"_60":61,"_64":145,"_66":250,"_62":147,"_94":148,"_68":37},{"_60":61,"_64":141,"_66":249,"_62":143,"_94":144,"_68":37},{"_60":84,"_64":134,"_135":136,"_87":244,"_62":9,"_94":-7,"_68":37},{"_60":90,"_64":129,"_87":240,"_62":128,"_94":-7},{"_60":61,"_64":126,"_66":127,"_62":128,"_94":-7,"_68":69},{"_60":61,"_64":124,"_66":239,"_62":118,"_94":-7,"_68":69},{"_60":90,"_64":119,"_87":235,"_62":118,"_94":-7},{"_60":61,"_64":116,"_66":117,"_62":118,"_94":-7,"_68":69},{"_60":90,"_64":110,"_87":230,"_62":34,"_94":-7},{"_60":61,"_64":108,"_66":109,"_62":34,"_94":-7,"_68":69},{"_60":90,"_64":100,"_87":225,"_62":102,"_94":-7},{"_60":90,"_64":91,"_87":213,"_62":93,"_94":-7},{"_60":84,"_62":85,"_64":86,"_87":211,"_68":69},{"_60":70,"_62":71,"_64":206,"_73":207,"_75":208,"_34":209,"_78":79,"_80":81,"_82":210},{"_60":61,"_62":203,"_64":204,"_66":205,"_68":69},{"_60":90,"_62":198,"_64":199,"_87":200},"originalImage","创作者原图",[201],{"_64":199,"_27":202},"https://raw.githubusercontent.com/9-K9/KatanaKitsune/bc9321eeaac727bbb5372a315ec58f68c96240ac/marketing/itch/05_attack.png","mediaReviewed","截图来源核查","2026-10-20","Creator-published combat screenshot from the silent Godot prototype.","/GameMap/assets/media/learning/katana-kitsune-godot.webp","The creator’s Katana Kitsune combat screenshot with an isometric courtyard, the party, enemies, health bars and minimap.","https://github.com/9-K9/KatanaKitsune/blob/bc9321eeaac727bbb5372a315ec58f68c96240ac/marketing/itch/05_attack.png","Creator-published screenshot",[89,212],"GitHub Copilot",[214,215,216,217,218],{"_64":89,"_27":99},{"_64":223,"_27":224},{"_64":97,"_27":98},{"_64":221,"_27":222},{"_64":219,"_27":220},"Blender","/zh/resources/blender/","Meshy API","/zh/resources/meshy/","Godot Engine · Official Documentation","/zh/resources/godot-engine/",[226],{"_64":227,"_27":228,"_106":229},"Read the creator’s AI production disclosure","https://9-k9.itch.io/katanakitsune","The author explicitly names Claude Code and GitHub Copilot alongside image, sprite and 3D asset tools, and links the primary complete source repository. The README verifies the Godot version and explains which finished assets are included.",[231],{"_64":232,"_27":233,"_106":234},"Open the complete Godot game project","https://github.com/9-K9/KatanaKitsune","Godot 4.7 project with scenes, GDScript, Dialogic addon and finished sprite assets. The inspected tree contains about 383 MB of files; no top-level game license was found. The upstream Meshy/Blender/PixelOver authoring pipeline is separate, while its finished runtime sprites are committed. The current source contains newer party/asset changes than the reviewed hosted prototype.",[236],{"_64":237,"_27":228,"_106":238},"Play Katana Kitsune on itch.io","Silent HTML5 prototype with keyboard and gamepad support. Space confirms player/device choices; allow a clear press and release between setup steps. The browser build loaded and reached player/device selection in review; combat and a complete dungeon run were not exercised. The download is large: about 184 MB of game data plus 40 MB of WebAssembly.","itch.io",[241],{"_64":242,"_27":243,"_106":-7},"Read the game and asset-pipeline documentation","https://github.com/9-K9/KatanaKitsune#readme",[245,246,247,248],"打开 itch 原型，选择一名真人玩家，认领键盘并选择服装。","阅读作者的 AI 披露，以及角色、战斗和精灵制作流程说明。","在 Godot 4.7 中通过 GL Compatibility 打开 project.godot；工程已包含可运行精灵和游戏场景。","调整一项战斗或生成参数，检查标题、选角、地牢、受伤和重开的完整衔接。","作者明确列出 Claude Code、GitHub Copilot、GPT Image 2、PixelLab 和 Meshy 等制作工具。仓库记录了 Meshy 绑定动画、Blender 重定向和 PixelOver 精灵导出流程；没有说明确切编程模型或各助手的代码分工。游戏里的 NPC 队友并不是 AI 辅助开发的证据。","AI 辅助（创作者归属）","资产制作工具",false,[255,256,257,219,258],"assetTools","GPT Image 2","PixelLab","Meshy","PixelOver","Godot 4.7 · GDScript · 2D / GL Compatibility","ai-assisted",[255,256,257,219,258],{"_64":242,"_27":243,"_19":169},{"_64":237,"_27":228,"_19":117,"_106":238},{"_64":232,"_27":233,"_167":168,"_106":234},{"_64":227,"_27":228,"_106":229},[165,267,166,268,269],"godot-engine","meshy","blender","resource:pixellab","resource","通过 API 和 MCP 生成像素角色、动画及无缝瓦片集的资产工具。","/zh/resources/",{"_21":166,"_331":97,"_147":157,"_60":332,"_330":272,"_325":324,"_27":294,"_90":333,"_310":334,"_305":335,"_302":336,"_299":67},[277,278,279,280,281,282,283,284,285,286,287,288,289],"website/src/data/resources.json",{"_60":23,"_66":97,"_62":331,"_94":-7,"_68":69},{"_60":156,"_66":272,"_62":330,"_94":-7,"_68":37},{"_60":61,"_64":328,"_66":329,"_62":147,"_94":152,"_68":37},{"_60":61,"_64":326,"_66":327,"_62":60,"_94":152,"_68":37},{"_60":61,"_64":323,"_66":324,"_62":325,"_94":144,"_68":37},{"_60":90,"_64":110,"_87":321,"_62":27,"_94":-7},{"_60":90,"_64":316,"_87":317,"_62":90,"_94":-7},{"_60":84,"_64":308,"_135":252,"_87":309,"_62":310,"_94":-7,"_68":69},{"_60":84,"_64":303,"_135":252,"_87":304,"_62":305,"_94":-7,"_68":69},{"_60":84,"_64":300,"_135":252,"_87":301,"_62":302,"_94":-7,"_68":69},{"_60":61,"_64":298,"_66":67,"_62":299,"_94":152,"_68":69},{"_60":61,"_62":295,"_64":296,"_66":297,"_68":69},{"_60":90,"_62":290,"_64":291,"_87":292},"identitySource","身份来源",[293],{"_64":256,"_27":294},"https://www.pixellab.ai/mcp","identity","项目身份与署名","The official PixelLab site describes its MCP asset service. The pixellab-code GitHub organization names itself PixelLab and links back to www.pixellab.ai; this is its official organization image, not a generated symbol.","来源核查","verified","适用方向",[150],"dimensions","开发阶段",[306,307],"stages","资产与动画","引擎与场景","主题",[311,312,313,314,315],"tags","Pixel art","Sprite","Tileset","MCP","Commercial service","延伸阅读",[318],{"_64":319,"_27":320},"文档","https://www.pixellab.ai/docs",[322],{"_64":110,"_27":294},"用途与特点","根据角色描述、朝向、动作与地形条件生成像素资产，包括四向、八向角色，以及侧视或俯视瓦片集。它是商业资产服务；MCP 连接资产工具与编程代理，游戏规则、碰撞和资产导入仍需项目流程实现。","detail","资源类型","工具","分类","2D 开发","summary","name","tool",[339],[311,312,313,314,315],[337,338],[157],"assets","scene",{"_64":340,"_27":320},"Documentation",{"_342":343},"documents",{"_69":344,"_37":345},[347,351,352,353,350,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,349,386,348,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404],[346,347,348,349,350],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contra