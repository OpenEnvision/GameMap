st","适用方向","ordered",false,[84,85,86],"dimensions","2D","3D","世界模型","开发阶段",[90,91,92,86],"stages","需求规划","玩法与代码","测试验证","主题",[96,97,98,99,100],"tags","code-world-model","simulation-generation","POMDP","benchmark","NeurIPS-2024","延伸阅读",[103,104],{"_56":107,"_25":62},{"_56":105,"_25":106},"Paper v2 scope","https://arxiv.org/html/2409.17652v2","项目主页","项目源码",[110],{"_56":108,"_25":111},"https://arxiv.org/abs/2409.17652","用途与特点","使用因子化 POMDP 表示，减少每一步生成所需上下文，面向代理训练生成 2D 游戏模拟。机器人实验在既有 CLIPort 框架内生成物体状态、奖励结构等任务代码。NeurIPS 2024 论文的游戏基准覆盖八个 Pygame 环境，3D 游戏生成仍属未来工作；机器人实验的 3D 相关性不等于能生成完整物理引擎。","detail","guidance","资源类型","论文","分类","category","lead","summary","name","world","paper",[135,136],[96,97,98,99,100],[132,133,134,123],[130,131,123],2024,"2d","3d","plan","code","test",{"_56":137,"_25":62},{"_56":105,"_25":106},"Project",{"_139":140},"documents",{"_69":141,"_35":142},[144,148,149,150,147,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179,180,181,182,146,183,145,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201],[143,144,145,146,147],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","cata