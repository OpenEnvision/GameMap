ipoSR/main/figures/teaser800.gif","video","src","/GameMap/assets/media/showcase/recording-triposr-assets.mp4","poster","/GameMap/assets/media/showcase/recording-triposr-assets.webp","aspectRatio",1.509433962264151,"mobile","previewSrc","预览说明","完整的官方 TripoSR 对照画面：上排五张输入图片，下排对应的三维重建结果。","alt","记录类型","原始项目记录","role","provenance","方向","3D","track","metadata","相关项目",[99],"resourceId",{"_54":100,"_26":101},"TripoSR","/zh/resources/triposr/","演示内容与范围","这是作者的单图重建展示，并非可玩场景；动画播放速度不代表推理耗时。本次未在本地运行重建，也未验证拓扑、绑定或游戏运行性能。","limitations","演示类别","资产生成","demoType","lead","source-recording","assets","3d","recordingId","triposr","resource:triposr","resource","从单张图像快速重建 3D 物体，适合资产原型制作。","/zh/resources/",{"_20":113,"_177":100,"_175":111,"_52":178,"_176":116,"_170":169,"_26":70,"_160":179,"_156":180,"_153":181,"_147":182,"_144":143},[121,122,123,124,125,126,127,128,129,130,131,132,133],"website/src/data/resources.json",{"_52":22,"_56":100,"_58":177,"_60":-7,"_62":63},{"_52":108,"_56":116,"_58":176,"_60":-7,"_62":36},{"_52":53,"_54":173,"_56":174,"_58":175,"_60":95,"_62":36},{"_52":53,"_54":171,"_56":172,"_58":52,"_60":95,"_62":36},{"_52":53,"_54":168,"_56":169,"_58":170,"_60":61,"_62":36},{"_52":64,"_54":165,"_66":166,"_58":26,"_60":-7},{"_52":148,"_54":158,"_150":151,"_66":159,"_58":160,"_60":-7,"_62":63},{"_52":148,"_54":154,"_150":151,"_66":155,"_58":156,"_60":-7,"_62":63},{"_52":148,"_54":149,"_150":151,"_66":152,"_58":153,"_60":-7,"_62":63},{"_52":53,"_54":145,"_56":146,"_58":147,"_60":95,"_62":63},{"_52":53,"_54":142,"_56":143,"_58":144,"_60":95,"_62":63},{"_52":53,"_58":139,"_54":140,"_56":141,"_62":63},{"_52":64,"_58":134,"_54":135,"_66":136},"identitySource","身份来源",[137],{"_54":138,"_26":70},"Tripo AI · VAST","identity","项目身份与署名","The official README explicitly says TripoSR was collaboratively developed by Tripo AI and Stability AI. The VAST-AI-Research organization links to tripo3d.ai. This shows Tripo/VAST as one verified co-developer, not as the sole author.","来源核查","2026-10-18","verified","年份","2024","year","list","适用方向","ordered",false,[93],"dimensions","开发阶段",[157],"stages","资产与动画","主题",[161,162,163,164],"tags","Image-to-3D","Reconstruction","Mesh","Prototype assets","项目源码",[167],{"_54":165,"_26":70},"用途与特点","使用 LRM 风格的前馈重建，公开代码、预训练模型与演示，将图像转为可导出的物体网格。重点是单个物体，隐藏表面、拓扑和游戏性能需后续处理，不是完整场景或可玩游戏生成器。","detail","资源类型","工具","分类","3D 开发","category","summary","name","tool",[161,162,163,164],[110],[111],2024,{"_184":185},"documents",{"_63":186,"_36":187},[189,193,194,195,192,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,191,228,190,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246],[188,189,190,191,192],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","catalog","contributing","media-sources","icon-sources","content-model","skills/level-design/SKILL","skills/level-design/LICENSE","skills/level-design/references/blockout-metrics","skills/level-design/references/case-studies","skills/level-design/references/combat-balance","skills/level-design/references/culture-history","skills/level-design/references/foundations","skills/level-design/references/