ets/demo.mp4?v=f434755","video","src","poster","/GameMap/assets/media/demos/recording-solarwm-overview.webp","aspectRatio",1.7777777777777777,"mobile","previewSrc","预览说明","SolarWM 官方概览的标题叠在多个生成环境的网格画面上，各画面带有移动操作提示。","alt","记录类型","原始项目记录","role","provenance","方向","世界模型","track","metadata","相关项目",[98],"resourceId",{"_54":99,"_26":100},"SolarWM","/zh/resources/solarwm/","演示内容与范围","这是世界模型概览录片，并非可交互的浏览器游戏。片中标明部分画面经过加速；这段预览本身不证明可编辑几何、持久实体规则或游戏玩法逻辑。","limitations","演示类别","demoType","lead","world","world-model","source-recording","recordingId","solarwm","resource:solarwm","resource","面向开放数据、训练和长时推理的交互视频世界模型框架。","/zh/resources/",{"_20":111,"_192":99,"_190":107,"_52":193,"_191":114,"_186":185,"_26":183,"_64":194,"_161":195,"_156":196,"_152":197,"_146":198,"_143":142},[119,120,121,122,123,124,125,126,127,128,129,130,131,132],"website/src/data/resources.json",{"_52":22,"_56":99,"_58":192,"_60":-7,"_62":63},{"_52":106,"_56":114,"_58":191,"_60":-7,"_62":36},{"_52":53,"_54":189,"_56":92,"_58":190,"_60":94,"_62":36},{"_52":53,"_54":187,"_56":188,"_58":52,"_60":94,"_62":36},{"_52":53,"_54":184,"_56":185,"_58":186,"_60":61,"_62":36},{"_52":64,"_54":180,"_66":181,"_58":26,"_60":-7},{"_52":64,"_54":167,"_66":168,"_58":64,"_60":-7},{"_52":147,"_54":159,"_149":150,"_66":160,"_58":161,"_60":-7,"_62":63},{"_52":147,"_54":154,"_149":150,"_66":155,"_58":156,"_60":-7,"_62":63},{"_52":147,"_54":148,"_149":150,"_66":151,"_58":152,"_60":-7,"_62":63},{"_52":53,"_54":144,"_56":145,"_58":146,"_60":94,"_62":63},{"_52":53,"_54":141,"_56":142,"_58":143,"_60":94,"_62":63},{"_52":53,"_58":138,"_54":139,"_56":140,"_62":63},{"_52":64,"_58":133,"_54":134,"_66":135},"identitySource","身份来源",[136],{"_54":137,"_26":70},"The Chinese University of Hong Kong, Shenzhen","identity","项目身份与署名","First author Junchao Huang is affiliated with CUHK-SZ and SLAI. Select the first listed institution, CUHK-Shenzhen, not the separate CUHK campus. The project also lists NUS, CUHK, HKUST, HKUST-GZ, NVIDIA, UCLA, and MSRA. The logo is the Home image in the official CUHK-Shenzhen homepage HTML.","来源核查","2026-10-19","verified","年份","2026","year","list","适用方向","ordered",false,[153,92],"dimensions","3D","开发阶段",[157,158,92],"stages","玩法与代码","引擎与场景","主题",[162,163,164,165,166],"tags","interactive-video","training-framework","camera-control","streaming","released-code","延伸阅读",[169,170,171,172],{"_54":178,"_26":179},{"_54":177,"_26":70},{"_54":175,"_26":176},{"_54":173,"_26":174},"H3 weights and access","https://huggingface.co/junchaoh-cs/SolarWM-H3-33B","Data access","https://huggingface.co/datasets/junchaoh-cs/SolarWM-Data","项目主页","Code and documentation","https://github.com/Junchao-cs/SolarWM","项目源码",[182],{"_54":180,"_26":183},"https://arxiv.org/abs/2609.02886","用途与特点","统一相机控制流式视频的数据、训练与推理接口。来源矩阵列出 Wan2.2-5B 和 MiniMax-H3 的三个阶段，而 Wan2.2-14B、LTX-2.5 的后续阶段仍待发布；不同骨干需要独立环境。主数据集提供标注和索引，latent 单独发布，完整处理后训练视频需要重建或获批访问。Hugging Face 的主数据和 H3 模型仓库还要求同意分享联系信息。它不是具有可查询实体状态的代码世界。","detail","资源类型","论文","分类","category","summary","name","paper",[202,203,204,205],[162,163,164,165,166],[200,201,107],[199,107],2026,"3d","code","scene",{"_54":178,"_26":179},{"_54":206,"_26":70},{"_54":175,"_26":176},{"_54":173,"_26":174},"Project",{"_208":209},"documents",{"_63":210,"_36":211},[213,217,218,219,216,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,215,252,214,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270],[212,213,214,215,216],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research",