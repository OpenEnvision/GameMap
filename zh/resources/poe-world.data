fied","section","metadata","年份","2025","year","list","适用方向","ordered",false,[84,85],"dimensions","2D","世界模型","开发阶段",[89,90,85],"stages","需求规划","玩法与代码","主题",[94,95,96,97,98],"tags","code-world-model","program-synthesis","stochastic-dynamics","Atari","model-based-planning","延伸阅读",[101,102],{"_56":105,"_25":106},{"_56":103,"_25":104},"项目主页","https://topwasu.github.io/poe-world","源码","https://github.com/topwasu/poe-world","项目源码",[109],{"_56":107,"_25":110},"https://arxiv.org/abs/2505.10819","用途与特点","把 LLM 合成的程序组成指数加权的专家乘积，用少量观察学习复杂随机世界模型，并在 Pong 和 Montezuma's Revenge 中接入规划器，研究样本效率及新关卡泛化。它是程序化动态建模方法，不是美术生成工具。","detail","guidance","资源类型","论文","分类","category","lead","summary","name","world","paper",[132,133],[94,95,96,97,98],[130,131,122],[129,122],2025,"2d","plan","code",{"_56":135,"_25":106},{"_56":134,"_25":104},"Project","Code",{"_137":138},"documents",{"_69":139,"_35":140},[142,146,147,148,145,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179,180,144,181,143,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202],[141,142,143,144,145],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-re