oject-page-videos/resolve/main/gallery_final/rgb/002.mp4","video","src","poster","/GameMap/media/demos/recording-cwm-brain-cloud-harbor.webp","aspectRatio",1.75,"mobile","previewSrc","预览说明","Code World Model 官方录片中的风帆艇穿行于绘画风格的云海港湾，WASD 与动作操作提示仍在画面中。","alt","记录类型","原始项目记录","role","provenance","方向","世界模型","track","metadata","相关项目",[98],"resourceId",{"_54":99,"_26":100},"Code World Model: Coding Agent as World Brain","/zh/resources/code-world-model-brain/","演示内容与范围","这是研究输出的录片：程序状态通过代理输入驱动视频渲染器，并非本页可交互的浏览器游戏。公开版本未包含闭源游戏基础系统和代理输入生成工具。","limitations","演示类别","demoType","lead","world","world-model","source-recording","recordingId","code-world-model-brain","resource:code-world-model-brain","resource","让编程代理编写可执行规则与持久状态，驱动视频世界演化。","/zh/resources/",{"_20":111,"_190":99,"_188":107,"_52":191,"_189":114,"_184":183,"_26":181,"_64":192,"_161":193,"_156":194,"_152":195,"_146":196,"_143":142},[119,120,121,122,123,124,125,126,127,128,129,130,131,132],"website/src/data/resources.json",{"_52":22,"_56":99,"_58":190,"_60":-7,"_62":63},{"_52":106,"_56":114,"_58":189,"_60":-7,"_62":36},{"_52":53,"_54":187,"_56":92,"_58":188,"_60":94,"_62":36},{"_52":53,"_54":185,"_56":186,"_58":52,"_60":94,"_62":36},{"_52":53,"_54":182,"_56":183,"_58":184,"_60":61,"_62":36},{"_52":64,"_54":178,"_66":179,"_58":26,"_60":-7},{"_52":64,"_54":168,"_66":169,"_58":64,"_60":-7},{"_52":147,"_54":159,"_149":150,"_66":160,"_58":161,"_60":-7,"_62":63},{"_52":147,"_54":154,"_149":150,"_66":155,"_58":156,"_60":-7,"_62":63},{"_52":147,"_54":148,"_149":150,"_66":151,"_58":152,"_60":-7,"_62":63},{"_52":53,"_54":144,"_56":145,"_58":146,"_60":94,"_62":63},{"_52":53,"_54":141,"_56":142,"_58":143,"_60":94,"_62":63},{"_52":53,"_58":138,"_54":139,"_56":140,"_62":63},{"_52":64,"_58":133,"_54":134,"_66":135},"identitySource","身份来源",[136],{"_54":137,"_26":70},"Westlake University","identity","项目身份与署名","The author project page lists AGI Lab, Westlake University as affiliation 1 and Nanyang Technological University as affiliation 2. First author Yiwen Chen has both affiliations. Select the first listed institution. The logo URL is declared as Organization.logo in the official English university homepage JSON-LD.","来源核查","2026-10-18","verified","年份","2026","year","list","适用方向","ordered",false,[153,92],"dimensions","3D","开发阶段",[157,158,92],"stages","需求规划","玩法与代码","主题",[162,163,164,165,166,167],"tags","code-world-model","coding-agent","executable-state","hybrid-renderer","MiniMax-H3","partial-release","延伸阅读",[170,171,172],{"_54":177,"_26":70},{"_54":175,"_26":176},{"_54":173,"_26":174},"Reproduction scope","https://github.com/buaacyw/code-world-model/blob/main/ENVIRONMENT.md","Inference code","https://github.com/buaacyw/code-world-model","项目主页","项目源码",[180],{"_54":178,"_26":181},"https://arxiv.org/abs/2608.25927","用途与特点","把世界演化与视觉生成分开：代理维护可执行状态，再编译为微调 MiniMax-H3 渲染器的控制条件。公开推理接口使用 RGB 首帧锚点、逐帧深度和语义 ID，以及按窗口提供的提示词。推理代码、LoRA 与示例已公开，但生成代理结构的底层游戏代码不能再分发，因此不能仅凭这些文件原样复现完整代理到引擎流程。","detail","资源类型","论文","分类","category","summary","name","paper",[200,201,202],[162,163,164,165,166,167],[198,199,107],[197,107],2026,"3d","plan","code",{"_54":203,"_26":70},{"_54":175,"_26":176},{"_54":173,"_26":174},"Project",{"_205":206},"documents",{"_63":207,"_36":208},[210,214,215,216,213,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,212,249,211,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270],[209,210,211,212,213],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generati