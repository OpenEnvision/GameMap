"_72":73,"_74":75,"_33":76,"_77":78,"_79":80,"_81":82},{"_59":60,"_61":62,"_63":64,"_65":66,"_67":68},"type","text","field","captureDate","label","截图采集","value","2026-10-18","language","en","image","gameplay","The live Godot build: neon territory capture and moving enemies.","src","/GameMap/media/learning/tron-exonix-claude.webp","alt","The neon TRON: EXONIX game board with a player vehicle, moving enemies, and territory boundaries.","https://www.top3d.ai/demo/exonix-build/index.html","width",1280,"height",720,"credit","GameMap browser capture","list","attribution","创作者记录中的客户端与模型","items",[88],"Claude Code","links","相关资源",[94,95,96,97],"resourceIds","section",{"_63":88,"_26":104},{"_63":102,"_26":103},{"_63":100,"_26":101},{"_63":98,"_26":99},"MCP for Blender","/zh/resources/mcp-for-blender/","Godot MCP · Coding-Solo","/zh/resources/godot-mcp/","Godot Engine · Official Documentation","/zh/resources/godot-engine/","/zh/resources/claude-code/","创作者开发记录",[108],"evidence",{"_63":109,"_26":110,"_111":112},"Read how the agent workflow was assembled","https://github.com/witnesstodark/tron-exonix/blob/master/CLAUDE.md","note","The creator’s reproducible setup record explains the AI’s implementation work, human material review, generation tools, and local launch requirements.","源码内容","complete project","项目源码",[117],{"_63":118,"_26":119,"_111":120},"Open the complete Godot game project","https://github.com/witnesstodark/tron-exonix","Includes the Godot project, scripts, shaders, models, textures, audio, and generation scripts. Local play requires Godot 4.7 standard; API access is only needed to regenerate assets.","获取方式","playable","demo","试玩与运行",[126],{"_63":127,"_26":76,"_111":128},"Play TRON: EXONIX","Creator-hosted Godot web build. Click to enter the grid, press Space to deploy, use the arrow keys to move, and Escape for the menu. A keyboard and a WebGL-capable browser are recommended.","游戏平台","浏览器","指南形式","教程","tutorial","开发记录与教程",[136],{"_63":137,"_26":138,"_111":-7},"Follow the creator’s complete workflow","https://www.top3d.ai/learn/claude-godot-mcp-3d-game","研究这个工作流","ordered",true,[143,144,145,146],"Play the web build and study territory capture, trail hazards, enemy movement, and sector progression.","Follow the creator’s tutorial from prototype through materials, audio, effects, and web export.","Read CLAUDE.md to understand the agent, Godot MCP, Blender review, and asset-generation workflow.","Open game/project.godot in Godot 4.7 and press F5; study the scripts alongside the included models, textures, and audio.","AI 工作流与开发背景","作者记录 Claude 编写玩法、着色器、视觉特效和 UI，人工引导机制与材质。仓库包含实际 Godot 游戏、生成资产及资产生成脚本。","aiUse","guidance","创作方式","AI 辅助（创作者归属）","category","provenance","方向","3D","track","metadata","资产制作工具",false,[163,164,165,166,167,168],"assetTools","Blender","Nano Banana","PATINA","Tripo","Stable Audio","ElevenLabs","引擎","Godot 4.7 · GDScript","engine","lead",[163,164,165,166,167,168],"3d","ai-assisted",[143,144,145,146],{"_63":137,"_26":138,"_18":133},{"_63":127,"_26":76,"_18":122,"_111":128},{"_63":118,"_26":119,"_186":187,"_111":120},{"_63":109,"_26":110,"_111":112},[182,183,184,185],"claude-code","godot-engine","godot-mcp","mcp-for-blender","scope","complete-project","resource:godot-mcp","resource","支持启动 Godot、运行项目、读取日志及基础场景操作的社区 MCP 服务。","/zh/resources/",{"_20":184,"_252":100,"_153":253,"_59":254,"_251":190,"_246":245,"_26":213,"_231":255,"_225":256,"_221":257,"_218":66,"_89":258},[195,196,197,198,199,200,201,202,203,204,205,206,207],"website/src/data/resources.json",{"_59":22,"_65":100,"_61":252,"_93":-7,"_67":68},{"_59":172,"_65":190,"_61":251,"_93":-7,"_67":36},{"_59":60,"_63":249,"_65":250,"_61":153,"_93":158,"_67":36},{"_59":60,"_63":247,"_65":248,"_61":59,"_93":158,"_67":36},{"_59":60,"_63":244,"_65":245,"_61":246,"_93":150,"_67":36},{"_59":89,"_63":115,"_86":242,"_61":26,"_93":-7},{"_59":89,"_63":237,"_86":238,"_61":89,"_93":-7},{"_59":83,"_63":229,"_140":160,"_86":230,"_61":231,"_93":-7,"_67":68},{"_59":83,"_63":223,"_140":160,"_86":224,"_61":225,"_93":-7,"_67":68},{"_59":83,"_63":219,"_140":160,"_86":220,"_61":221,"_93":-7,"_67":68},{"_59":60,"_63":217,"_65":66,"_61":218,"_93":158,"_67":68},{"_59":60,"_61":214,"_63":215,"_65":216,"_67":68},{"_59":89,"_61":208,"_63":209,"_86":210},"identitySource","身份来源",[211],{"_63":212,"_26":213},"Solomon Elias / Coding-Solo","https://github.com/Coding-Solo/godot-mcp","identity","项目身份与署名","ownership is confirmed by the repository and creator profile, but no independent project graphic logo was found. The README has Godot ASCII art only. Do not use a default identicon, a personal photograph, or the Godot engine logo as creator branding.","来源核查","verified","适用方向",[222,156],"dimensions","2D","开发阶段",[226,227,228],"stages","玩法与代码","引擎与场景","测试验证","主题",[232,233,234,235,236],"tags","Godot","MCP","GDScript","Runtime logs","场景","延伸阅读",[239],{"_63":240,"_26":241},"Pinned implementation and lifecycle limits","https://github.com/Coding-Solo/godot-mcp/blob/1209744fad78f3998f98c7394fd0f6ef50da5281/src/index.ts#L1053-L1215",[243],{"_63":115,"_26":213},"用途与特点","支持执行项目、采集调试输出、创建场景与节点、加载 Sprite2D 纹理及部分 3D MeshLibrary 操作，但不覆盖全部编辑器功能或视觉试玩。所检查版本只保留一个活动项目进程：启动新进程前发出 kill，却不等待旧进程退出；停止操作也仅发送请求。自然退出会清除 get_debug_output 使用的句柄，可靠的崩溃记录需另行归档日志。","detail","资源类型","工具","分类","编程代理","summary","name","agents","tool",[232,233,234,235,264],[261,262,263],[260,174],[259],{"_63":240,"_26":241},"2d","code","scene","test","Scenes",{"_266":267},"documents",{"_68":268,"_36":269},[271,275,276,277,274,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,273,310,272,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331],[270,271,272,273,274],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","