r institutional policy. The mark is linked from Nitrode's official site.","language","en","来源核查","2026-10-18","verified","section","metadata","年份","2026","year","list","适用方向","ordered",false,[84],"dimensions","3D","开发阶段",[88,89],"stages","玩法与代码","测试验证","主题",[93,94,95,96],"tags","Development benchmark","Unreal Engine","C++","Behavior tests","延伸阅读",[99,100],{"_56":103,"_25":104},{"_56":101,"_25":102},"Versioned evaluation protocol","https://arxiv.org/html/2607.03525v2","Paper-linked repository (availability unverified)","https://github.com/Nitrode-Research/GameEngineBench","项目源码",[107],{"_56":105,"_25":108},"https://arxiv.org/abs/2607.03525","用途与特点","论文 v2 描述了来自九个 Unreal 项目的 110 项 C++ 任务，代理获得可构建的起点、允许修改的文件和行为要求。编译与 Play-in-Editor 监听服务器测试后，由 LLM 评判需求、测试证据、改动及参考解。核查时无法取得论文链接仓库，可运行代码是否可获取仍需确认；任务范围是局部 C++ 实现，不是完整 3D 游戏生成。","detail","guidance","资源类型","基准测试","分类","3D 开发","category","lead","summary","name","3d","benchmark",[130,131],[93,94,95,96],[128,129],[121],2026,"code","test",{"_56":103,"_25":104},{"_56":101,"_25":102},{"_133":134},"documents",{"_69":135,"_35":136},[138,142,143,144,141,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,140,177,139,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198],[137,138,139,140,141],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedbac