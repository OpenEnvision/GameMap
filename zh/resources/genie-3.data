a/media/genie_modelling_physical_properties_2_Qvyu3BP.mp4","video","src","poster","/GameMap/assets/media/demos/recording-genie3-jetski.webp","aspectRatio",1.8181818181818181,"mobile","previewSrc","预览说明","Genie 3 官方录片展示第一人称水上摩托、挂满节日灯笼的水面，以及方向操作输入。","alt","记录类型","原始项目记录","role","provenance","方向","世界模型","track","metadata","相关项目",[98],"resourceId",{"_54":99,"_26":100},"Genie 3 / Project Genie","/zh/resources/genie-3/","演示内容与范围","这是官方模型交互录片，并非本页运行的实时模型，也不是可导出的游戏工程。另行提供的 Project Genie 原型目前限支持地区的合资格个人 Google AI Ultra 账户，用户须年满 18 岁；每次探索最多 60 秒，可用性还取决于容量。","limitations","演示类别","demoType","lead","world","world-model","source-recording","recordingId","genie-3","resource:genie-3","resource","根据提示词生成可实时探索的交互视频世界。","/zh/resources/",{"_20":111,"_182":99,"_180":107,"_52":183,"_181":114,"_176":175,"_26":70,"_160":184,"_156":185,"_152":186,"_146":187,"_143":142,"_64":188},[119,120,121,122,123,124,125,126,127,128,129,130,131,132],"website/src/data/resources.json",{"_52":22,"_56":99,"_58":182,"_60":-7,"_62":63},{"_52":106,"_56":114,"_58":181,"_60":-7,"_62":36},{"_52":53,"_54":179,"_56":92,"_58":180,"_60":94,"_62":36},{"_52":53,"_54":177,"_56":178,"_58":52,"_60":94,"_62":36},{"_52":53,"_54":174,"_56":175,"_58":176,"_60":61,"_62":36},{"_52":64,"_54":171,"_66":172,"_58":26,"_60":-7},{"_52":64,"_54":166,"_66":167,"_58":64,"_60":-7},{"_52":147,"_54":158,"_149":150,"_66":159,"_58":160,"_60":-7,"_62":63},{"_52":147,"_54":154,"_149":150,"_66":155,"_58":156,"_60":-7,"_62":63},{"_52":147,"_54":148,"_149":150,"_66":151,"_58":152,"_60":-7,"_62":63},{"_52":53,"_54":144,"_56":145,"_58":146,"_60":94,"_62":63},{"_52":53,"_54":141,"_56":142,"_58":143,"_60":94,"_62":63},{"_52":53,"_58":138,"_54":139,"_56":140,"_62":63},{"_52":64,"_58":133,"_54":134,"_66":135},"identitySource","身份来源",[136],{"_54":137,"_26":70},"Google DeepMind","identity","项目身份与署名","Genie 3 is introduced on the official Google DeepMind blog. Use the official google-deepmind organization avatar, consistently with the original Genie paper.","来源核查","2026-10-19","verified","年份","2025","year","list","适用方向","ordered",false,[153,92],"dimensions","3D","开发阶段",[157,92],"stages","需求规划","主题",[161,162,163,164,165],"tags","interactive-video","neural-simulator","text-to-world","Google-DeepMind","hosted","延伸阅读",[168],{"_54":169,"_26":170},"Project Genie access and limits","https://support.google.com/labs/answer/16875695?hl=en","项目源码",[173],{"_54":171,"_26":70},"用途与特点","Google DeepMind 2025 年 8 月研究演示报告 720p、24 FPS 的交互世界，可保持数分钟一致性。独立的 Project Genie 原型将探索限制为 60 秒，当前帮助页要求可用地区内符合条件、年满 18 岁的个人 Google AI Ultra 账户。文档支持下载视频，但未确立可下载引擎源码、可导出关卡资产或确定性玩法规则。","detail","资源类型","工具","分类","category","summary","name","tool",[161,162,163,164,165],[191,107],[190,107],2025,[189],{"_54":169,"_26":170},"3d","plan",{"_193":194},"documents",{"_63":195,"_36":196},[198,202,203,204,201,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,200,237,199,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255],[197,198,199,200,201],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","catalog","contributing","media-sources","icon-sources","content-model","skill