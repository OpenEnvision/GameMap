 navigation categories, not independently verified capability claims.","classification","provenance","综述中的引用位置",[131],"citedSections",{"_62":132,"_25":133},"8.1 Automated Playtesting","https://arxiv.org/html/2609.16679v1#S8.SS1","书目来源",[137,138],"origins",{"_62":140,"_25":141},{"_62":139,"_25":84},"Primary publication","Survey reference [150]","https://arxiv.org/html/2609.16679v1#bib.bib150","DOI","10.48550/arxiv.2604.02648","doi","arXiv ID","2604.02648","arxivId","PDF",[151],"pdfUrl",{"_62":148,"_25":152},"https://arxiv.org/pdf/2604.02648","原始发表页面",[155],{"_62":153,"_25":84},"研究主题","ordered",false,[161,162,163,164,165],"topics","方向：测试与评估","自动化实玩测试","基准测试与评估","语言与多模态代理","测试与质量保障","研究方向",[169],"roles","测试与评估","主要研究方向","primaryRole","发表类型","预印本","referenceType","发表信息与来源","arXiv preprint arXiv:2604.02648, 2026a.","publication","发表年份","2026","year","作者","Shufan Jiang, Chios Chen, and Zhiyang Chen","authors","lead",2026,"preprint","test",[187],[223,224,225,226,227],"resourceIds",[],[221,222],[220],{"_195":196,"_197":198,"_199":200,"_13":201,"_202":203,"_204":93,"_205":206,"_207":208},"codeStatus","open-source","repositories",[214],"projects",[],[],"reviewStatus","source-reviewed","checkedAt","evidence",[209,210,211,212,213],"notes",[100,101],{"_62":83,"_25":84},{"_62":81,"_25":82},{"_62":79,"_25":80},{"_62":77,"_25":78},{"_62":75,"_25":76},{"_62":106,"_25":82,"_17":215,"_216":217},"partial","license",{"_218":196,"_219":116,"_25":78},"status","name",{"_62":132,"_25":133},{"_62":140,"_25":141},{"_62":139,"_25":84},"Role: test","Automated playtesting","Benchmarks and evaluation","Language and multimodal agents","Testing and quality assurance",{"_229":230},"documents",{"_38":231,"_35":232},[234,238,239,240,237,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,236,273,235,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291],[233,234,235,236,237],"reading-guide","practical-guide",