"_65":66},"type","links","field","originalImage","label","创作者原图","items",[67],{"_63":64,"_25":68},"https://raw.githubusercontent.com/zenstory-ai/novel-to-game/7758caa8d9578f19780349e7b4e4115ef831fd7a/examples/project-plateau/build/evidence/current-run/01-field-glade.jpg","text","mediaReviewed","截图来源核查","value","2026-10-20","language","en","image","gameplay","A creator-published frame from the recorded expedition, showing the field camera, animal family and remaining daylight.","src","/GameMap/assets/media/learning/project-plateau.webp","alt","The player’s field camera points toward a prehistoric animal family beside a brook, with photographic plate and daylight indicators.","https://github.com/zenstory-ai/novel-to-game/blob/7758caa8d9578f19780349e7b4e4115ef831fd7a/examples/project-plateau/build/evidence/current-run/01-field-glade.jpg","width",1280,"height",720,"credit","Creator-published screenshot","list","attribution","创作者记录中的客户端与模型",[94],"其他 / 未指定代理","相关资源",[99],"resourceIds","section",{"_63":100,"_25":101},"Three.js","/zh/resources/threejs/","创作者开发记录",[105],"evidence",{"_63":106,"_25":107,"_108":109},"阅读作者的改编与测试记录","https://github.com/zenstory-ai/novel-to-game#what-the-qa-record-admits-it-did-not-test","note","The author explains the recorded camera-to-result-and-restart route and its limits; GameMap is not claiming to have reproduced that complete route.","源码内容","complete project","项目源码",[114],{"_63":115,"_25":116,"_108":117},"查看完整探险游戏项目","https://github.com/zenstory-ai/novel-to-game/tree/main/examples/project-plateau","Three.js/Vite game with local runtime models, textures, sound, source adaptation documents and QA inputs. Requires Node 22.12+ for local tooling. Blender scripts are asset-production sources, not required for normal play.","获取方式","playable","demo","试玩与运行",[123],{"_63":124,"_25":125,"_108":126},"Play Project Plateau","https://plateau.vibecoco.ai/","Desktop landscape browser with WebGL2, keyboard and mouse. Mobile devices may show the creator’s short recorded preview instead of the full game.","游戏平台","浏览器","指南形式","build log","tutorial","开发记录与教程",[134],{"_63":135,"_25":116,"_108":-7},"查看探险游戏的开发与设计资料","研究这个工作流","ordered",true,[140,141,142,143],"Start the desktop expedition and learn movement, camera, crouching and return-to-camp controls.","Compare how subject framing, cover and photographic plates create choices from the novel’s expedition premise.","Read the build brief and verification record to separate a tested route from untested device, sound and optional encounter behavior.","For local play, enter examples/project-plateau/build/app, use Node 22.12+ to install dependencies, then run npm start; the committed runtime assets do not require Blender regeneration.","AI 工作流与开发背景","创作者将 Project Plateau 作为 NovelToGame 小说改编工作流案例，公开分析、概念、世界设计、美术、构建和 QA 各阶段。项目包含源码、已提交的模型纹理、资产生成脚本及一条测试路径的输入记录，没有明确指出具体编码客户端。","aiUse","guidance","创作方式","AI 辅助（创作者归属）","category","provenance","方向","3D","track","metadata","资产制作工具",false,[160],"assetTools","Blender","引擎","Three.js · WebGL2","engine","lead",[160],"3d",[140,141,142,143],{"_63":179,"_25":116,"_17":180},{"_63":124,"_25":125,"_17":119,"_108":126},{"_63":176,"_25":116,"_108":117,"_177":178},{"_63":175,"_25":107,"_108":109},[174],"ai-assisted","threejs","Read the creator’s adaptation and QA account","Open the full expedition project","scope","complete-project","Read the expedition build and design workspace","build-log",{"_182":183},"documents",{"_75":184,"_35":185},[187,191,192,193,190,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,189,226,188,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244],[186,187,188,189,190],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index",