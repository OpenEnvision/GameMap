-tinyswords/blob/f59f1dca8bf461227c9b5d856764e1e90d8b8e90/README.md","原始录片",[76],"originalUrl",{"_56":73,"_26":77},"https://raw.githubusercontent.com/chongdashu/phaserjs-tinyswords/f59f1dca8bf461227c9b5d856764e1e90d8b8e90/docs/preview.gif","video","src","/GameMap/media/showcase/recording-castle-clash.mp4","poster","/GameMap/media/showcase/recording-castle-clash.webp","aspectRatio",1.7777777777777777,"mobile","previewSrc","预览说明","作者动态预览的真实画面：两座城堡之间铺有道路，底部有士兵招募按钮和兵力信息。","alt","记录类型","精选预览片段","role","provenance","方向","2D","track","metadata","相关项目",[101],"resourceId",{"_56":102,"_26":103},"Phaser · First Game Guide","/zh/resources/phaser/","演示内容与范围","节选官方仓库23秒动态预览的4–12秒，保留原始帧时序。展示原型的招募与行军，不代表当前 Duel 版本的全部规则；原始素材为动态 GIF。","limitations","游戏与源码",[110],"exampleId",{"_56":107,"_26":111},"/zh/examples/castle-clash-duel-claude/","引擎 / 渲染器","Phaser 3 · JavaScript","engine","演示类别","游戏实录","demoType","lead","2d","castle-clash-duel-claude","excerpt","gameplay","recordingId","phaser","example:castle-clash-duel-claude","example","Castle Clash Duel","招募战士与弓箭手，在瓦片地图上进行双人战术对抗。这个完整 Phaser 原型由 Claude Code 实现，并使用 Pixel Frog 制作的 Tiny Swords 美术素材。","/zh/examples/",{"_20":120,"_22":127,"_24":128,"_114":113,"_96":119,"_227":229,"_224":223,"_9":230,"_209":231,"_19":232,"_33":233,"_184":234,"_178":235},[133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152],"website/src/data/learningPaths.ts",{"_54":22,"_58":127,"_60":22,"_62":-7,"_64":36},{"_54":118,"_58":128,"_60":24,"_62":-7,"_64":36},{"_54":55,"_56":228,"_58":113,"_60":114,"_62":63,"_64":65},{"_54":55,"_56":94,"_58":95,"_60":96,"_62":97,"_64":65},{"_54":55,"_56":225,"_58":226,"_60":227,"_62":93,"_64":36},{"_54":55,"_56":222,"_58":223,"_60":224,"_62":63,"_64":36},{"_54":171,"_56":214,"_215":216,"_68":217,"_60":9,"_62":-7,"_64":65},{"_54":66,"_56":210,"_68":211,"_60":209,"_62":-7},{"_54":55,"_56":207,"_58":208,"_60":209,"_62":-7,"_64":65},{"_54":55,"_56":205,"_58":206,"_60":19,"_62":-7,"_64":36},{"_54":66,"_56":199,"_