tory / tutorial",[120],{"_57":121,"_25":102,"_94":-7},"Read the adaptation workspace","Study this workflow","ordered",true,[126,127,128,129],"Play the village and use the quest tracker to reach an NPC or a battle.","Compare the novel chapter references with the selected fan, transformation and five-element mechanics.","Read the design, art and QA files to distinguish implemented systems from deliberately omitted multiplayer features.","To run locally, serve examples/journey-to-the-west/build/app with python3 -m http.server 5173; inspect the JavaScript battle implementation before changing a rule.","AI workflow / foundation context","Zenstory publishes this as a NovelToGame agent-workflow result, with source analysis, rejected concepts, game and art direction, generated artwork, game implementation and QA records. The example does not identify one specific coding client; support for several clients is not proof that all were used.","aiUse","guidance","Creation category","AI-assisted (creator attribution)","category","provenance","Track","2D","track","metadata","Engine","Custom Canvas 2D · JavaScript · DOM UI","engine","lead","2d",[126,127,128,129],{"_57":121,"_25":102,"_17":157},{"_57":110,"_25":111,"_17":105,"_94":112},{"_57":101,"_25":102,"_94":103,"_155":156},{"_57":92,"_25":93,"_94":95},"ai-assisted","resourceIds",[],"scope","complete-project","build-log",{"_159":160},"documents",{"_161":162,"_163":164},"en",[166,170,171,172,169,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,168,205,167,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223],"zh",[165,166,167,168,169],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-op