ive Gemini and Claude development with minor manual balance edits. This individual game does not include a separate prompt log.","aiUse","guidance","Creation category","AI-assisted (creator attribution)","category","provenance","Track","3D","track","metadata","Engine","Three.js · JavaScript","engine","lead","3d","ai-assisted",[127,128,129,130],{"_57":122,"_25":95,"_17":117},{"_57":112,"_25":68,"_17":107,"_96":113},{"_57":103,"_25":104,"_96":105,"_156":157},{"_57":94,"_25":95,"_96":97},[155],"threejs","scope","complete-project",{"_159":160},"documents",{"_161":162,"_163":164},"en",[166,170,171,172,169,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,168,205,167,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226],"zh",[165,166,167,168,169],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","catalog","contributing","media-sources","icon-sources","content-model","skills/level-design/SKILL","skills/level-design/LICENSE","design/design-system","design/v2/design-system","editorial-art-prompts","skills/level-design/references/blockout-metrics","skills/level-design