-6ede-46b3-96e7-128de3709de6","text","mediaReviewed","Screenshot source reviewed","value","2026-10-20","image","gameplay","The creator’s Tidal Observatory gameplay screenshot.","src","/GameMap/assets/media/learning/surge-for-oinja-codex.webp","alt","SURGE gameplay in the Tidal Observatory with a character, support machine, enemies and combat HUD.","https://github.com/MartinDelophy/awesome-gpt-6-astra/issues/106","width",1280,"height",720,"credit","Creator-published screenshot","list","attribution","Creator-attributed clients / models (not inferred from related tools)",[87],"Codex","Related resources",[92,93],"resourceIds","section",{"_58":96,"_25":97},{"_58":94,"_25":95},"Three.js","/resources/threejs/","OpenAI Codex","/resources/codex/","Creator evidence",[101],"evidence",{"_58":102,"_25":76,"_103":104},"Read the creator’s Codex contribution statement","note","Submitted by Olivia295, the source repository owner, with explicit human and model responsibilities; not a complete session transcript.","Source contents","complete project","Project source",[109],{"_58":110,"_25":111,"_103":112},"Open the complete survival-game project","https://github.com/Olivia295/SURGE-for-Oinja","Includes gameplay, physics, models, assets, translations and tests. Requires Node.js 22; run npm ci and npm run dev. No application server or API key is required.","Access type","playable","demo","Play or run",[118],{"_58":119,"_25":120,"_103":121},"Play SURGE for Oinja","https://oinja-game.vercel.app/","Desktop WebGL and keyboard. WASD/arrows move, Space dodges, Q releases Sync Burst, and E interacts. Attacks are automatic. English and Chinese; no mobile touch controls.","Game platform","Browser","Guide format","disclosure","tutorial","Build story / tutorial",[129],{"_58":130,"_25":76,"_103":-7},"Read the creator’s development account","Study this workflow","ordered",true,[135,136,137,138],"Start a run and try movement, dodging and automatic attacks.","Read the creator’s contribution disclosure.","Inspect combat, progression and map code under src/surge/.","Change one ability combination and check its effect during a new run.","AI workflow / foundation context","Olivia used GPT-6 Astra in Codex for combat, ability synergies, procedural environments, interface and debugging. The original Oinja universe, creative direction and playtest feedback came from the creator; development involved repeated sessions and revisions.","aiUse","guidance","Creation category","AI-assisted (creator attribution)","category","provenance","Track","3D","track","metadata","Engine","Three.js · Rapier 3D · TypeScript","engine","lead","3d","ai-assisted",[135,136,137,138],{"_58":130,"_25":76,"_17":125},{"_58":119,"_25":120,"_17":114,"_103":121},{"_58":110,"_25":111,"_165":166,"_103":112},{"_58":102,"_25":76,"_103":104},[163,164],"codex","threejs","scope","complete-project",{"_168":169},"documents",{"_170":171,"_172":173},"en",[175,179,180,181,178,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,177,214,176,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232],"zh",[174,175,176,177,178],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-rev