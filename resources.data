 across Editor versions.",[3229,232,5570,4978,4979],[1470,166,1370,1562],[247],[5588,5589,5590],{"_73":5579,"_50":5580},{"_73":5577,"_50":5578},{"_73":5575,"_50":5576},"resource:unity-test-framework","unity-test-framework","Unity Test Framework","Unity's official testing framework, with Edit mode, Play mode, and command-line execution.","/resources/unity-test-framework/",{"_44":5592,"_1363":5593,"_1361":4904,"_71":1364,"_1362":5594,"_1357":5628,"_50":5627,"_81":5629,"_1338":5630,"_1333":5631,"_1330":5632,"_1321":1395},[5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610],{"_71":46,"_75":5593,"_77":1363,"_79":-7},{"_71":124,"_75":5594,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5628,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5625,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5618,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5615,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5614,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5613,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5566},{"_71":81,"_77":1311,"_73":1312,"_83":5611},[5612],{"_73":3229,"_50":5565},[232,109],[1447,1545,2294],[3229,1545,5616,5617,4220],"Edit mode","Play mode",[5619,5620],{"_73":5623,"_50":5624},{"_73":5621,"_50":5622},"Versioned test-job and cancellation API","https://docs.unity3d.com/Packages/com.unity.test-framework@1.4/api/UnityEditor.TestTools.TestRunner.Api.TestRunnerApi.html","Package and API documentation","https://docs.unity3d.com/Packages/com.unity.test-framework@latest/",[5626],{"_73":1352,"_50":5627},"https://docs.unity3d.com/6000.2/Documentation/Manual/test-framework/test-framework-introduction.html","Enables ongoing regression checks for generated scripts and scene behavior, using UnityTest across frames to check lifecycles, coroutines, and state changes. Edit mode and Play mode have different execution loops; tests should wait for real frames or conditions rather than only confirming script creation. The separately checked Test Framework 1.4.6 API returns a job GUID and documents multi-frame cancellation cleanup. Active tests become Canceled and remaining tests NotRun; do not equate cancellation with passing or assume compatibility with every Editor package version.",[5633,5634],[3229,1545,5616,5617,4220],[1470,1562,2332],[247,126],{"_73":5623,"_50":5624},{"_73":5621,"_50":5622},"resource:unity-engine","unity-engine","Unity · Manual","Official Unity documentation for projects, the editor, scripting, rendering, physics, asset import, and publishing.","/resources/unity-engine/",{"_44":5636,"_1363":5637,"_1361":4904,"_71":1364,"_1362":5638,"_1357":5669,"_50":5668,"_81":5670,"_1338":5671,"_1333":5672,"_1330":5673,"_1321":1395},[5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654],{"_71":46,"_75":5637,"_77":1363,"_79":-7},{"_71":124,"_75":5638,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5669,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5666,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5663,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5659,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5658,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5657,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5566},{"_71":81,"_77":1311,"_73":1312,"_83":5655},[5656],{"_73":3229,"_50":5565},[232,109],[1637,1447,1334,1335,1545,2294],[3229,5660,5015,5661,5662],"C#","Editor","Package Manager",[5664],{"_73":5665,"_50":5565},"Official example source",[5667],{"_73":1352,"_50":5668},"https://docs.unity3d.com/Manual/index.html","Provides agents with concrete C# and editor project constraints, plus 2D and 3D workflows and versioned package references. Pin the Editor, render pipeline, and Package Manager versions together; the Unity name alone does not establish API or material compatibility.",[5674],[3229,5660,5015,5661,5662],[1653,1470,166,1370,1562,2332],[247,126],{"_73":5665,"_50":5565},"resource:gdquest-first-2d-game","gdquest-first-2d-game","GDQuest · First 2D Game","A GDQuest tutorial for a Godot 2D survival game, with complete scripts, a project, and troubleshooting notes.","/resources/gdquest-first-2d-game/",{"_44":5676,"_1363":5677,"_1361":4904,"_71":2772,"_1362":5678,"_1357":5713,"_50":5698,"_81":5714,"_1338":5715,"_1333":5716,"_1330":5717,"_1321":1395},[5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694],{"_71":46,"_75":5677,"_77":1363,"_79":-7},{"_71":124,"_75":5678,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":2771,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5713,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5711,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5705,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5702,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5701,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5700,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5699},{"_71":81,"_77":1311,"_73":1312,"_83":5695},[5696],{"_73":5697,"_50":5698},"GDQuest","https://www.gdquest.com/library/first_2d_game_godot4_vampire_survivor/","GDQuest-authored course and library page; use GDQuest's own organization mark rather than Godot branding.",[232],[1637,1447,1335,1545],[4144,5237,5703,5704,232],"Complete core loop","Collision debugging",[5706,5707],{"_73":1352,"_50":5710},{"_73":5708,"_50":5709},"Tutorial library","https://www.gdquest.com/library/","https://github.com/gdquest-demos/getting-started-with-godot-4",[5712],{"_73":1352,"_50":5698},"Covers movement, aiming, projectiles, enemy spawning, and failure states as a reference for a complete core loop. The tutorial was made with Godot 4.1 and updated to 4.6. Its troubleshooting explains grounded / floating modes and an enemy count limit. Code uses MIT while art assets use CC BY-NC-SA 4.0; check reuse conditions separately.",[5718,5719],[4144,5237,5703,5704,232],[1653,1470,1370,1562],[247],{"_73":1352,"_50":5710},{"_73":5708,"_50":5709},"resource:godot-gut","godot-gut","GUT · Godot Unit Test","A community Godot testing framework for GDScript assertions, test doubles, and parameterized cases.","/resources/godot-gut/",{"_44":5721,"_1363":5722,"_1361":4904,"_71":1364,"_1362":5723,"_1357":5757,"_50":5743,"_81":5758,"_1338":5759,"_1333":5760,"_1330":5761,"_1321":1395},[5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739],{"_71":46,"_75":5722,"_77":1363,"_79":-7},{"_71":124,"_75":5723,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5757,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5755,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5751,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5747,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5746,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5745,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5744},{"_71":81,"_77":1311,"_73":1312,"_83":5740},[5741],{"_73":5742,"_50":5743},"GUT / bitwes","https://github.com/bitwes/Gut","The actual GUT project logo is referenced on the first line of its official README; do not use the Godot engine mark in its place.",[232,109],[1447,1545],[4144,5748,5749,4220,5750],"Unit testing","GDScript","JUnit",[5752],{"_73":5753,"_50":5754},"Author documentation","https://gut.readthedocs.io/",[5756],{"_73":1352,"_50":5743},"Provides a CLI and JUnit XML output for automated regression checks on generated game state, damage, inventory, and other logic. GUT and Godot versions have explicit compatibility requirements; passing logic tests still leaves visuals, controls, and scene integration to check.",[5762],[4144,5748,5749,4220,5750],[1470,1562],[247,126],{"_73":5753,"_50":5754},"resource:godot-demo-projects","godot-demo-projects","Godot Demo Projects","Official runnable Godot examples covering 2D, 3D, GUI, audio, networking, and rendering.","/resources/godot-demo-projects/",{"_44":5764,"_1363":5765,"_1361":4904,"_71":2529,"_1362":5766,"_1357":5795,"_50":5794,"_1338":5796,"_1333":5797,"_1330":5798,"_1321":1395},[5770,5771,5772,5773,5774,5775,5776,5777,5778,5779,5780,5781],{"_71":46,"_75":5765,"_77":1363,"_79":-7},{"_71":124,"_75":5766,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":2528,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5795,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5792,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5789,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5788,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5787,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5786},{"_71":81,"_77":1311,"_73":1312,"_83":5782},[5783],{"_73":5784,"_50":5785},"Godot Engine","https://github.com/godotengine/godot","Official engine and its own documentation/demo repositories. The official Godot organization avatar is its recognizable project logo.",[232,109],[1637,1447,1335,1545],[4144,4978,4979,5790,5791],"Version branches","Reference projects",[5793],{"_73":1352,"_50":5794},"https://github.com/godotengine/godot-demo-projects","Useful as minimal reference projects and regression tasks for agents, with concrete examples of scenes, scripts, and resources. The repository states that master targets the development engine; choose a matching branch for a stable release to avoid mistaking version conflicts for generation failures.",[4144,4978,4979,5790,5791],[1653,1470,1370,1562],[247,126],"resource:godot-command-line","godot-command-line","Godot · Command Line Tutorial","Godot's official CLI reference for headless operation, script checks, asset import, execution, and export.","/resources/godot-command-line/",{"_44":5800,"_1363":5801,"_1361":4904,"_71":2529,"_1362":5802,"_1357":5829,"_50":5828,"_1338":5830,"_1333":5831,"_1330":5832,"_1321":1320},[5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817],{"_71":46,"_75":5801,"_77":1363,"_79":-7},{"_71":124,"_75":5802,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":2528,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5829,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5826,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5822,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5821,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5820,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5786},{"_71":81,"_77":1311,"_73":1312,"_83":5818},[5819],{"_73":5784,"_50":5785},[232,109],[1447,1545,2294],[4144,4220,5823,5824,5825],"Headless","Builds","Reproducibility",[5827],{"_73":1352,"_50":5828},"https://docs.godotengine.org/en/stable/tutorials/editor/command_line_tutorial.html","Lets coding agents launch projects, read logs, parse scripts, and export builds through commands, reducing GUI dependence. The --check-only flag parses a script supplied with --script; it does not execute gameplay tests. Supported flags vary by build type, and unknown flags are silently ignored; check the selected binary's --help. Headless runs cannot replace real rendering and input tests.",[4144,4220,5823,5824,5825],[1470,1562,2332],[247,126],"resource:godot-engine","godot-engine","Godot Engine · Official Documentation","An open-source 2D and 3D game engine that organizes runnable projects through scenes, nodes, resources, and scripts.","/resources/godot-engine/",{"_44":5834,"_1363":5835,"_1361":4904,"_71":1364,"_1362":5836,"_1357":5866,"_50":5865,"_81":5867,"_1338":5868,"_1333":5869,"_1330":5870,"_1321":1395},[5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852],{"_71":46,"_75":5835,"_77":1363,"_79":-7},{"_71":124,"_75":5836,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":4903,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5866,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5863,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5859,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5857,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5856,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5855,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5786},{"_71":81,"_77":1311,"_73":1312,"_83":5853},[5854],{"_73":5784,"_50":5785},[232,109],[1637,1447,1334,1335,1545,2294],[4144,5749,5858,5015,5144],"Scenes and nodes",[5860,5861],{"_73":5862,"_50":5785},{"_73":4978,"_50":5794},"Engine source",[5864],{"_73":1352,"_50":5865},"https://docs.godotengine.org/en/stable/","Provides authoritative context for GDScript, C#, scene, and resource APIs, helping agents connect script changes to running scenes. Pin the engine version and use matching documentation; stable and development branches are not interchangeable.",[5871,5872],[4144,5749,5858,5015,5144],[1653,1470,166,1370,1562,2332],[247,126],{"_73":5862,"_50":5785},{"_73":4978,"_50":5794},"resource:playwright-mcp","playwright-mcp","Playwright MCP","Microsoft's browser automation MCP server for exposing page structure, interactions, and browser feedback to agents.","/resources/playwright-mcp/",{"_44":5874,"_1363":5875,"_1361":5913,"_71":1364,"_1362":5876,"_1357":5911,"_50":5895,"_1338":5914,"_1333":5915,"_1330":5916,"_1321":1320,"_81":5917},[5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892],{"_71":46,"_75":5875,"_77":1363,"_79":-7},{"_71":124,"_75":5876,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5911,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5909,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5902,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5899,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5898,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5897,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5896},{"_71":81,"_77":1311,"_73":1312,"_83":5893},[5894],{"_73":2359,"_50":5895},"https://github.com/microsoft/playwright-mcp","Official Microsoft Playwright project. Use the real Playwright brand mark; it is a Microsoft-maintained MCP, unlike third-party engine bridges.",[232,109],[1545,2294],[4676,4181,2365,5900,5901],"HUD","Canvas limitations",[5903,5904],{"_73":5907,"_50":5908},{"_73":5905,"_50":5906},"Companion CLI + Skills","https://github.com/microsoft/playwright-cli","Pinned tools and security boundaries","https://github.com/microsoft/playwright-mcp/blob/b8b4183e099f136cbec0388a6088d4aa2f6b9685/README.md#security",[5910],{"_73":1352,"_50":5895},"Useful for browser game menus, HUDs, launch flows, keyboard input, and screenshots. The default interface uses accessibility trees; coordinate-based mouse tools require the optional vision capability. Neither interface automatically exposes internal Canvas or WebGL state, so game debug instrumentation may be needed. The checked README warns that the server is not a security boundary and documents browser_run_code_unsafe as arbitrary JavaScript execution in the Playwright server process. The separate Playwright CLI repository provides a CLI + Skills workflow.","Coding agents","agents",[4676,4181,2365,5900,5901],[1562,2332],[247,126],[5918,5919],{"_73":5907,"_50":5908},{"_73":5905,"_50":5906},"resource:unreal-mcp","unreal-mcp","Unreal MCP · chongdashu","A Python MCP server and UE C++ plugin connecting agents to Actors, Blueprints, and viewport controls.","/resources/unreal-mcp/",{"_44":5921,"_1363":5922,"_1361":5913,"_71":1364,"_1362":5923,"_1357":5956,"_50":5943,"_81":5957,"_1338":5958,"_1333":5959,"_1330":5960,"_1321":1395},[5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939],{"_71":46,"_75":5922,"_77":1363,"_79":-7},{"_71":124,"_75":5923,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":5956,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5954,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5950,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5947,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5946,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5945,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5944},{"_71":81,"_77":1311,"_73":1312,"_83":5940},[5941],{"_73":5942,"_50":5943},"Chong-U / AI Oriented Dev","https://github.com/chongdashu/unreal-mcp","repository ownership is chongdashu; the linked creator profile identifies AI Oriented Dev and aioriented.dev. No project/creator brand image has been confirmed. Do not use Epic/Unreal branding as an implied creator.",[109],[1447,1335,1545],[715,4181,5438,5948,5949],"Experimental","Editor bridge",[5951],{"_73":5952,"_50":5953},"Tool documentation","https://github.com/chongdashu/unreal-mcp/tree/main/Docs",[5955],{"_73":1352,"_50":5943},"Covers Actor transforms, Blueprint classes and components, some node graphs, and editor camera operations. The README declares Unreal Engine 5.5+ and Python 3.12+ and supplies a UE5.5 example; later-version compatibility is not independently tested here. The author marks it experimental and advises against production use. Pin versions and verify supported operations individually.",[5961],[715,4181,5438,5948,5949],[1470,1370,1562],[126],{"_73":5952,"_50":5953},"resource:mcp-for-blender","mcp-for-blender","MCP for Blender","A Blender add-on and MCP server for agent-driven modeling, materials, Python execution, and visual feedback.","/resources/mcp-for-blender/",{"_44":5963,"_1363":5964,"_1361":5913,"_71":1364,"_1362":5965,"_1357":6000,"_50":5985,"_1338":6001,"_1333":6002,"_1330":6003,"_1321":1320,"_81":6004},[5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981],{"_71":46,"_75":5964,"_77":1363,"_79":-7},{"_71":124,"_75":5965,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":6000,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":5998,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5991,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5989,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5988,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5987,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5986},{"_71":81,"_77":1311,"_73":1312,"_83":5982},[5983],{"_73":5984,"_50":5985},"Siddharth Ahuja / ahujasid","https://github.com/ahujasid/mcp-for-blender","repository and linked project site confirm an independent community integration, explicitly not affiliated with Blender Foundation. No separate project or organization logo has been confirmed; do not replace it with the official Blender logo or a personal portrait.",[109],[1447,1334,1335,1545],[3981,4181,5102,5143,5990],"Community project",[5992,5993],{"_73":5996,"_50":5997},{"_73":5994,"_50":5995},"Opt-in content and data terms","https://github.com/ahujasid/mcp-for-blender/blob/25e1fe008fc523b1a947c6f3d28510a362a0f06e/TERMS_AND_CONDITIONS.md","Telemetry defaults and controls","https://github.com/ahujasid/mcp-for-blender/blob/25e1fe008fc523b1a947c6f3d28510a362a0f06e/README.md#L808-L842",[5999],{"_73":1352,"_50":5985},"Useful for 3D game assets and scene prototypes with viewport feedback. Formerly blender-mcp, this community bridge can execute arbitrary Python inside Blender; use trusted tasks and saved copies. The checked documentation distinguishes default minimal usage telemetry from opt-in creative-content collection; DISABLE_TELEMETRY=true disables both. Review the opt-in data terms before enabling content capture. Validate topology, scale, UVs, collision, and exports separately.",[3981,4181,5102,5143,5990],[1470,166,1370,1562],[126],[6005,6006],{"_73":5996,"_50":5997},{"_73":5994,"_50":5995},"resource:godot-mcp","godot-mcp","Godot MCP · Coding-Solo","A community MCP server for launching Godot, running projects, reading logs, and performing basic scene operations.","/resources/godot-mcp/",{"_44":6008,"_1363":6009,"_1361":5913,"_71":1364,"_1362":6010,"_1357":6042,"_50":6030,"_1338":6043,"_1333":6044,"_1330":6045,"_1321":1395,"_81":6046},[6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026],{"_71":46,"_75":6009,"_77":1363,"_79":-7},{"_71":124,"_75":6010,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":6042,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":6040,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":6036,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":6034,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":6033,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":6032,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":6031},{"_71":81,"_77":1311,"_73":1312,"_83":6027},[6028],{"_73":6029,"_50":6030},"Solomon Elias / Coding-Solo","https://github.com/Coding-Solo/godot-mcp","ownership is confirmed by the repository and creator profile, but no independent project graphic logo was found. The README has Godot ASCII art only. Do not use a default identicon, a personal photograph, or the Godot engine logo as creator branding.",[232,109],[1447,1335,1545],[4144,4181,5749,6035,3983],"Runtime logs",[6037],{"_73":6038,"_50":6039},"Pinned implementation and lifecycle limits","https://github.com/Coding-Solo/godot-mcp/blob/1209744fad78f3998f98c7394fd0f6ef50da5281/src/index.ts#L1053-L1215",[6041],{"_73":1352,"_50":6030},"Supports project execution, debug output capture, scene and node creation, Sprite2D texture loading, and some 3D MeshLibrary operations. It can give agents feedback from real projects; these interfaces do not provide complete visual playtesting or every editor feature. At the checked commit, the server keeps one active project process and sends kill before spawning another without awaiting prior exit. Stop returns after sending a kill request rather than waiting for process exit; natural exit clears the handle used by get_debug_output. Archive output separately for reliable crash evidence.",[4144,4181,5749,6035,3983],[1470,1370,1562],[247,126],[6047],{"_73":6038,"_50":6039},"resource:unity-mcp-skill","unity-mcp-skill","Unity-MCP Operator Guide","A practical MCP for Unity skill: inspect editor state, act, wait for compilation and domain reload, then verify results.","/resources/unity-mcp-skill/",{"_44":6049,"_1363":6050,"_1361":5913,"_71":2297,"_1362":6051,"_1357":6080,"_50":6079,"_1338":6081,"_1333":6082,"_1330":6083,"_1321":1395},[6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066],{"_71":46,"_75":6050,"_77":1363,"_79":-7},{"_71":124,"_75":6051,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":2318,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":6080,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":6077,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":6074,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":6073,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":6072,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":6071},{"_71":81,"_77":1311,"_73":1312,"_83":6067},[6068],{"_73":6069,"_50":6070},"MCP for Unity / CoplayDev","https://github.com/CoplayDev/unity-mcp","Exact MCP for Unity project logo from its README. Independent community integration, explicitly not affiliated with Unity Technologies. The operator guide belongs to the same repository.",[232,109],[1447,1335,1545],[3229,6075,4181,6076,4226],"Skills","Compilation feedback",[6078],{"_73":1352,"_50":6079},"https://github.com/CoplayDev/unity-mcp/blob/main/unity-mcp-skill/SKILL.md","Defines resource-first scene operations and requires checking compilation, domain reload, tool readiness, and blocking reasons before further edits. Script changes are followed by console and screenshot checks. This is a procedure source for MCP for Unity, not an installed or tested integration here; examples and parameters depend on bridge, Unity, UI, and input-system versions.",[3229,6075,4181,6076,4226],[1470,1370,1562],[247,126],"resource:unity-mcp","unity-mcp","MCP for Unity","A community MCP bridge connecting general-purpose coding agents to the Unity Editor.","/resources/unity-mcp/",{"_44":6085,"_1363":6086,"_1361":5913,"_71":1364,"_1362":6087,"_1357":6118,"_50":6070,"_81":6119,"_1338":6120,"_1333":6121,"_1330":6122,"_1321":1320},[6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103],{"_71":46,"_75":6086,"_77":1363,"_79":-7},{"_71":124,"_75":6087,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":5912,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":6118,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":6116,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":6109,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":6108,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":6107,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1