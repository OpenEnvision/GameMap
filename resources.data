1":81,"_73":1352,"_83":5533,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":5526,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":5522,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":5521,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":5520,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":5519},{"_71":81,"_77":1311,"_73":1312,"_83":5515},[5516],{"_73":5517,"_50":5518},"Catlike Coding / Jasper Flick","https://catlikecoding.com/","The official site identifies Jasper Flick as the author and sole operator. Its own code documentation labels this image Logo. Use the Catlike Coding creator mark rather than Unity's logo.",[109],[1447,1335,1545],[3229,5237,5523,5524,5525],"Physics","Character control","Debugging",[5527,5528],{"_73":5531,"_50":5532},{"_73":5529,"_50":5530},"Shader and project tutorials","https://catlikecoding.com/unity/tutorials/","Complete movement series","https://catlikecoding.com/unity/tutorials/movement/",[5534],{"_73":1352,"_50":5535},"https://catlikecoding.com/unity/tutorials/movement/surface-contact/","The author uses test scenes to reproduce loss of ground contact, ghost collisions, raycasts, and ground snapping, giving agents causal explanations of physics behavior. The tutorial uses Unity 2019.2.14f1 and ProBuilder; adapt its algorithms, APIs, input, and project configuration to the target version.",[5541,5542],[3229,5237,5523,5524,5525],[1470,1370,1562],[126],{"_73":5531,"_50":5532},{"_73":5529,"_50":5530},"resource:unity-2d-techdemos","unity-2d-techdemos","Unity · 2D Tech Demos","Official Unity 2D example source for Tilemaps, Scripted Tiles, brushes, and runtime map changes.","/resources/unity-2d-techdemos/",{"_44":5544,"_1363":5545,"_1361":4904,"_71":2529,"_1362":5546,"_1357":5583,"_50":5565,"_1338":5584,"_1333":5585,"_1330":5586,"_1321":1320,"_81":5587},[5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562],{"_71":46,"_75":5545,"_