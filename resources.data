],{"_73":3541,"_50":3542},"Rigging requirements","https://docs.meshy.ai/en/api/rigging",[3544],{"_73":1352,"_50":3545},"https://docs.meshy.ai/en","The official animated-character recipe turns a reference image into a textured, rigged character with idle, jump, and attack clips in GLB and FBX. The animation step applies motions from Meshy's library. API rigging works best with standard textured bipeds with clearly separated limbs. Generated assets still need engine import, collision, controls, and performance checks; the public cookbook supplies asset examples rather than complete gameplay.",[3555],{"_2286":3552,"_43":3553,"_57":3554},[3534,3535,3536,3537,3538,3161],[166,1370],[126],{"_73":3528,"_50":3529,"_42":2286,"_2282":3530},{"_73":3523,"_50":3524,"_42":3072,"_2282":3525},{"_73":3518,"_50":3519,"_42":3215,"_2282":3520},{"_73":3541,"_50":3542},"resource:scenario","scenario","Scenario","Builds consistent game art pipelines with custom style models and batch generation.","/resources/scenario/",{"_44":3557,"_1363":3558,"_1361":2320,"_71":1364,"_1362":3559,"_1357":3620,"_50":3619,"_81":3621,"_2277":3622,"_1338":3623,"_1333":3624,"_1330":3625,"_1321":1395},[3563,3564,3565,3566,3567,3568,3569,3570,3571,3572,3573,3574,3575,3576,3577,3578,3579,3580,3581],{"_71":46,"_75":3558,"_77":1363,"_79":-7},{"_71":124,"_75":3559,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":2319,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":3620,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":3617,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":3607,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":3602,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":3601,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":3600,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":81,"_73":2286,"_83":3595,"_77":2277,"_79":-7},{"_71":72,"_73":2275,"_75":2286,"_77":2277,"_79":-7},{"_71":81,"_73":43,"