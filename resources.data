ramework","framework",[1471,1472],[1449,1450,1451,1452,1453],[1470,293],[126,293],"code",{"_73":1459,"_50":1460},{"_73":1457,"_50":1458},"resource:gamefactory","gamefactory","GameFactory","Combines open-domain video generation with keyboard and mouse action control.","/resources/gamefactory/",{"_44":1474,"_1363":1475,"_1361":293,"_71":1412,"_1362":1476,"_1357":1514,"_50":1513,"_81":1515,"_1338":1516,"_1333":1517,"_1330":1518,"_1324":1369,"_1321":1395},[1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1490,1491,1492,1493],{"_71":46,"_75":1475,"_77":1363,"_79":-7},{"_71":124,"_75":1476,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1514,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1511,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1505,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1501,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1500,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1499,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1323,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1498},{"_71":81,"_77":1311,"_73":1312,"_83":1494},[1495],{"_73":1496,"_50":1497},"The University of Hong Kong","https://github.com/KlingAIResearch/GameFactory","The official repository lists first authors Jiwen Yu and Yiran Qin with The University of Hong Kong (affiliation 1); Kuaishou Technology is affiliation 2 and an internship host. Select HKU, not a generic Kling logo. The icon comes from the official HKU homepage, provided/verified by the root agent.",[109,286],[286],[1450,1449,1502,1452,1503,1504],"action-control","dataset","ICCV-2025",[1506,1507],{"_73":1510,"_50":1497},{"_73":1508,"_50":1509},"GF-Minecraft dataset","https://huggingface.co/datasets/KlingTeam/GameFactory-Dataset","Dataset tools and documentation",[1512],{"_73":1352,"_50":1513},"https://arxiv.org/abs/2501.08325","Creating New Games with Generative Interactive Videos proposes domain adapters and action-control modules for autoregressive game video. The public GF-Minecraft dataset includes action labels; the checked repository provides dataset documentation and detection/visualization utilities, without establishing a released training/inference pipeline or model weights. Visual generalization should be evaluated separately from rule correctness, item persistence, and exportable game projects.",[1519,1520],[1450,1449,1502,1452,1503,1504],[293],[126,293],{"_73":1510,"_50":1497},{"_73":1508,"_50":1509},"resource:diamond","Trains reinforcement learning agents inside diffusion world models that preserve visual detail.",{"_44":751,"_1363":748,"_1361":293,"_71":1412,"_1362":1522,"_1357":1557,"_50":1556,"_81":1558,"_1338":1559,"_1333":1560,"_1330":1561,"_1324":1417,"_1321":1395},[1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538],{"_71":46,"_75":748,"_77":1363,"_79":-7},{"_71":124,"_75":1522,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1557,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1554,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1551,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1546,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1544,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1543,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1542},{"_71":81,"_77":1311,"_73":1312,"_83":1539},[1540],{"_73":1541,"_50":739},"University of Geneva","The project page lists equal-contribution first authors Eloi Alonso (University of Geneva) and Adam Jelley (University of Edinburgh), with Microsoft Research also involved. Select the first author’s first institution, Geneva. The SVG is from the official university homepage and was provided/verified by the root agent.",[232,109,286],[1545,286],"Testing",[1449,1450,1547,1548,1549,1550],"diffusion","Atari","reinforcement-learning","NeurIPS-2024",[1552],{"_73":1553,"_50":739},"Code and playable models",[1555],{"_73":1352,"_50":1556},"https://arxiv.org/abs/2405.12399","Visual Details Matter in Atari studies diffusion models as environment models in which agents learn from imagined trajectories, analyzing how visual detail affects policies. Alongside the Atari 100k evaluation, the paper trains a playable neural engine on prerecorded CS:GO gameplay. It is relevant to simulation, control, and accumulated prediction error.",[1563],[1449,1450,1547,1548,1549,1550],[1562,293],[247,126,293],"test",{"_73":1553,"_50":739},"resource:gamengen","gamengen","GameNGen — Diffusion Models Are Real-Time Game Engines","Trains an interactive diffusion simulator from DOOM gameplay trajectories.","/resources/gamengen/",{"_44":1565,"_1363":1566,"_1361":293,"_71":1412,"_1362":1567,"_1357":1607,"_50":1606,"_81":1608,"_1338":1609,"_1333":1610,"_1330":1611,"_1324":1417,"_1321":1395},[1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585],{"_71":46,"_75":1566,"_77":1363,"_79":-7},{"_71":124,"_75":1567,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1607,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1604,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1602,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1599,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1598,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1597,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":1591,"_77":1592,"_73":1593,"_94":1594,"_103":1595,"_57":1589,"_78":1596},{"_71":72,"_77":1316,"_73":1317,"_75":1590},{"_71":81,"_77":1311,"_73":1312,"_83":1586},[1587],{"_73":1588,"_50":1589},"Google Research","https://gamengen.github.io/","The project page lists equal-contribution authors Dani Valevski and Yaniv Leviathan at Google Research; Moab Arar at Tel Aviv University with work done while at Google Research; and Shlomi Fruchter at Google DeepMind. Select Google Research, the first listed organization. Logo is the official google-research organization avatar from https://github.com/google-research.","image","projectMedia","Creator project media","/GameMap/media/demos/gamengen.webp","Official GameNGen method figure showing model training to predict the next frame from prior game frames and actions","GameNGen authors · method figure",[109,286],[1545,286],[1449,1450,1547,1600,1601],"DOOM","ICLR-2025",[1603],{"_73":1405,"_50":1589},[1605],{"_73":1352,"_50":1606},"https://arxiv.org/abs/2408.14837","A reinforcement learning agent first collects game trajectories. A diffusion model then predicts the next frame from visual history and actions, using conditioning noise augmentation to reduce autoregressive error. The paper demonstrates real-time DOOM simulation on a single TPU. This game-specific neural simulation does not automatically provide maintainable general game rules or an asset pipeline.",[1612],[1449,1450,1547,1600,1601],[1562,293],[126,293],{"_73":1405,"_50":1589},"resource:genie-3","Generates interactive video worlds from prompts for real-time exploration.",{"_44":786,"_1363":783,"_1361":293,"_71":1364,"_1362":1614,"_1357":1647,"_50":774,"_1338":1648,"_1333":1649,"_1330":1650,"_1324":1369,"_1321":1320,"_81":1651},[1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630],{"_71":46,"_75":783,"_77":1363,"_79":-7},{"_71":124,"_75":1614,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1647,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1645,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1641,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1638,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1636,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1635,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1323,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1634},{"_71":81,"_77":1311,"_73":1312,"_83":1631},[1632],{"_73":1633,"_50":774},"Google DeepMind","Genie 3 is introduced on the official Google DeepMind blog. Use the official google-deepmind organization avatar, consistently with the original Genie paper.",[109,286],[1637,286],"Planning",[1450,1449,1639,1640,1343],"text-to-world","Google-DeepMind",[1642],{"_73":1643,"_50":1644},"Project Genie access and limits","https://support.google.com/labs/answer/16875695?hl=en",[1646],{"_73":1352,"_50":774},"Google DeepMind's August 2025 research demonstration reported interactive worlds at 720p and 24 FPS with consistency lasting several minutes. The separate Project Genie prototype limits exploration to 60 seconds; its current help page requires an eligible personal Google AI Ultra account, age 18+, where Ultra is available. Video download is documented, while downloadable engine source, exportable level assets, and deterministic gameplay rules are not established by these sources.",[1450,1449,1639,1640,1343],[1653,293],[126,293],[1652],{"_73":1643,"_50":1644},"plan","resource:genie","genie","Genie: Generative Interactive Environments","Learns latent-action-controlled 2D worlds from videos without action labels.","/resources/genie/",{"_44":1655,"_1363":1656,"_1361":293,"_71":1412,"_1362":1657,"_1357":1687,"_50":1686,"_1338":1688,"_1333":1689,"_1330":1690,"_1324":1417,"_1321":1395},[1661,1662,1663,1664,1665,1666,1667,1668,1669,1670,1671,1672,1673],{"_71":46,"_75":1656,"_77":1363,"_79":-7},{"_71":124,"_75":1657,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1687,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1684,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1680,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1679,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1678,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1677},{"_71":81,"_77":1311,"_73":1312,"_83":1674},[1675],{"_73":1633,"_50":1676},"https://arxiv.org/html/2402.15391v1","The original paper explicitly identifies the authors with Google DeepMind. Jeff Clune additionally lists the University of British Columbia. Select the main institution; use the official google-deepmind organization avatar.",[232,286],[286],[1450,1681,1449,1682,1683],"latent-actions","2D-platformer","ICML-2024",[1685],{"_73":1352,"_50":1686},"https://arxiv.org/abs/2402.15391","Combines a spatiotemporal video tokenizer, autoregressive dynamics, and a latent action model into generative interactive environments. Users can begin with an image or sketch and explore frame by frame. The ICML 2024 contribution centers on learning control without ground-truth action labels. Dynamics remain implicit in the model, without editable or queryable game rule programs.",[1450,1681,1449,1682,1683],[293],[247,293],"resource:factorsim","factorsim","FactorSim","Generates simulation and task code from language using factorized state representations.","/resources/factorsim/",{"_44":1692,"_1363":1693,"_1361":293,"_71":1412,"_1362":1694,"_1357":1731,"_50":1730,"_81":1732,"_1338":1733,"_1333":1734,"_1330":1735,"_1324":1417,"_1321":1320},[1698,1699,1700,1701,1702,1703,1704,1705,1706,1707,1708,1709,1710,1711],{"_71":46,"_75":1693,"_77":1363,"_79":-7},{"_71":124,"_75":1694,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1731,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1728,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1723,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1718,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1717,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1716,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1715},{"_71":81,"_77":1311,"_73":1312,"_83":1712},[1713],{"_73":1393,"_50":1714},"https://cs.stanford.edu/~sunfanyun/factorsim/","The project page assigns the first author Fan-Yun Sun and most authors to Stanford University; NVIDIA is the second institution. The logo is an official Stanford touch icon linked by https://identity.stanford.edu/.",[232,109,286],[1637,1447,1545,286],[1719,1720,1721,1722,1550],"code-world-model","simulation-generation","POMDP","benchmark",[1724,1725],{"_73":1405,"_50":1714},{"_73":1726,"_50":1727},"Paper v2 scope","https://arxiv.org/html/2409.17652v2",[1729],{"_73":1352,"_50":1730},"https://arxiv.org/abs/2409.17652","Generative Simulation via Factorized Representation uses a factorized POMDP representation to reduce context per generation step. It generates 2D game simulations for agent training. Its robotics experiments generate task code, including object states and reward structure, within the existing CLIPort framework. The game benchmark covers eight Pygame environments; 3D game generation is future work in the NeurIPS 2024 paper. Robotics experiments retain 3D relevance without establishing generation of a complete physics engine.",[1736,1737],[1719,1720,1721,1722,1550],[1653,1470,1562,293],[247,126,293],{"_73":1405,"_50":1714},{"_73":1726,"_50":1727},"resource:poe-world","poe-world","PoE-World","Combines small programmatic experts to model stochastic world dynamics.","/resources/poe-world/",{"_44":1739,"_1363":1740,"_1361":293,"_71":1412,"_1362":1741,"_1357":1779,"_50":1778,"_81":1780,"_1338":1781,"_1333":1782,"_1330":1783,"_1324":1369,"_1321":1395},[1745,1746,1747,1748,1749,1750,1751,1752,1753,1754,1755,1756,1757,1758],{"_71":46,"_75":1740,"_77":1363,"_79":-7},{"_71":124,"_75":1741,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1779,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1776,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1770,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1766,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1765,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1764,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1323,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1763},{"_71":81,"_77":1311,"_73":1312,"_83":1759},[1760],{"_73":1761,"_50":1762},"Cornell University","https://arxiv.org/pdf/2505.10819","The original paper lists Cornell University, University of Cambridge, The Alan Turing Institute, and Dalhousie University. Select Cornell, the first listed institution and the first-author institution. The SVG is the official Cornell CS homepage identity, also used for WorldCoder.",[232,286],[1637,1447,286],[1719,1767,1768,1548,1769],"program-synthesis","stochastic-dynamics","model-based-planning",[1771,1772],{"_73":1774,"_50":1775},{"_73":1405,"_50":1773},"https://topwasu.github.io/poe-world","Code","https://github.com/topwasu/poe-world",[1777],{"_73":1352,"_50":1778},"https://arxiv.org/abs/2505.10819","Compositional World Modeling with Products of Programmatic Experts combines LLM-synthesized programs in an exponentially weighted product of experts, learning complex stochastic world models from few observations. The paper connects these models to planners in Pong and Montezuma's Revenge to demonstrate sample efficiency and generalization to new levels. This is programmatic dynamics modeling rather than an art generation tool.",[1784,1785],[1719,1767,1768,1548,1769],[1653,1470,293],[247,293],{"_73":1774,"_50":1775},{"_73":1405,"_50":1773},"resource:cwm-general-game-playing","cwm-general-game-playing","Code World Models for General Game Playing","Compiles natural-language game rules into verifiable simulators for MCTS planning.","/resources/cwm-general-game-playing/",{"_44":1787,"_1363":1788,"_1361":293,"_71":1412,"_1362":1789,"_1357":1820,"_50":1819,"_1338":1821,"_1333":1822,"_1330":1823,"_1324":1369,"_1321":1395},[1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805],{"_71":46,"_75":1788,"_77":1363,"_79":-7},{"_71":124,"_75":1789,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1820,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1817,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1812,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1811,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1810,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1323,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1809},{"_71":81,"_77":1311,"_73":1312,"_83":1806},[1807],{"_73":1633,"_50":1808},"https://arxiv.org/html/2510.04542v1","The original paper lists Google DeepMind as the authors’ affiliation. Use the avatar embedded by the official google-deepmind organization page, https://github.com/google-deepmind; not an author portrait.",[232,286],[1637,1447,1545,286],[1719,1813,1814,1815,1816],"game-rules","MCTS","formal-simulator","imperfect-information",[1818],{"_73":1352,"_50":1819},"https://arxiv.org/abs/2510.04542","Generates Python state-transition, legal-action, and termination functions from rules and game trajectories, plus heuristic value and hidden-state inference functions for planning. The paper evaluates 10 fully or partially observable games, including board and card games. Avoiding illegal actions depends on the synthesized rules being correct, so model validation remains necessary.",[1719,1813,1814,1815,1816],[1653,1470,1562,293],[247,293],"resource:gif-mcts-cwm","gif-mcts-cwm","GIF-MCTS / Code World Models Benchmark","Synthesizes runnable environment models through generate, improve, and fix tree search.","/resources/gif-mcts-cwm/",{"_44":1825,"_1363":1826,"_1361":293,"_71":1412,"_1362":1827,"_1357":1862,"_50":1861,"_81":1863,"_1338":1864,"_1333":1865,"_1330":1866,"_1324":1417,"_1321":1395},[1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844],{"_71":46,"_75":1826,"_77":1363,"_79":-7},{"_71":124,"_75":1827,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1862,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1859,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1854,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1852,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1851,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1850,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1849},{"_71":81,"_77":1311,"_73":1312,"_83":1845},[1846],{"_73":1847,"_50":1848},"Aalto University","https://sites.google.com/view/code-world-models/home","The authors’ project page explicitly lists Nicola Dainese, Matteo Merler, Minttu Alakuijala, and Pekka Marttinen under Aalto University. The logo URL is the official Aalto homepage touch icon, provided and verified by the root agent.",[232,109,286],[1637,1447,1545,286],[1719,1767,1814,1722,1853,1550],"CWMB",[1855,1856],{"_73":1857,"_50":1858},{"_73":1405,"_50":1848},"Code and CWMB","https://github.com/nicoladainese96/code-world-models",[1860],{"_73":1352,"_50":1861},"https://arxiv.org/abs/2405.15383","Generating Code World Models with Large Language Models Guided by Monte Carlo Tree Search encodes transition, reward, and termination logic in Python. Trajectories and test feedback guide GIF-MCTS search. The paper also releases CWMB, covering 18 reinforcement learning environments, to evaluate model correctness and downstream planning. It is a foundational reading and evaluation reference for code world models.",[1867,1868],[1719,1767,1814,1722,1853,1550],[1653,1470,1562,293],[247,126,293],{"_73":1857,"_50":1858},{"_73":1405,"_50":1848},"resource:worldcoder","worldcoder","WorldCoder","Induces Python world models from environment interactions, then plans within them.","/resources/worldcoder/",{"_44":1870,"_1363":1871,"_1361":293,"_71":1412,"_1362":1872,"_1357":1900,"_50":1899,"_1338":1901,"_1333":1902,"_1330":1903,"_1324":1417,"_1321":1395},[1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888],{"_71":46,"_75":1871,"_77":1363,"_79":-7},{"_71":124,"_75":1872,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1900,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1897,"_77":50,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1895,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1894,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1893,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1396,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1892},{"_71":81,"_77":1311,"_73":1312,"_83":1889},[1890],{"_73":1761,"_50":1891},"https://arxiv.org/html/2402.12275v1","The original paper identifies Hao Tang, Darren Key, and Kevin Ellis with Cornell University, Department of Computer Science. The official Cornell CS homepage embeds this SVG with alt text Department of Computer Science | Cornell Bowers.",[232,286],[1637,1447,286],[1719,1767,1769,1896,1550],"gridworld",[1898],{"_73":1352,"_50":1899},"https://arxiv.org/abs/2402.12275","WorldCoder, a Model-Based LLM Agent represents knowledge of a world as executable Python programs. Interaction records constrain those programs, and planning searches for potential rewards. This NeurIPS 2024 work is primarily evaluated on gridworlds and task planning. It supports study of rule discovery and model repair rather than complete visual game generation.",[1719,1767,1769,1896,1550],[1653,1470,293],[247,293],"resource:solarwm","An interactive video world model framework for open data, training, and long-horizon inference.",{"_44":571,"_1363":568,"_1361":293,"_71":1412,"_1362":1905,"_1357":1946,"_50":1945,"_81":1947,"_1338":1948,"_1333":1949,"_1330":1950,"_1324":1951,"_1321":1320},[1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921],{"_71":46,"_75":568,"_77":1363,"_79":-7},{"_71":124,"_75":1905,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1946,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1943,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1932,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1929,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1928,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1927,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1925},{"_71":81,"_77":1311,"_73":1312,"_83":1922},[1923],{"_73":1924,"_50":559},"The Chinese University of Hong Kong, Shenzhen","First author Junchao Huang is affiliated with CUHK-SZ and SLAI. Select the first listed institution, CUHK-Shenzhen, not the separate CUHK campus. The project also lists NUS, CUHK, HKUST, HKUST-GZ, NVIDIA, UCLA, and MSRA. The logo is the Home image in the official CUHK-Shenzhen homepage HTML.","2026",[109,286],[1447,1335,286],[1450,1930,1401,1931,1453],"training-framework","streaming",[1933,1934,1935,1936],{"_73":1941,"_50":1942},{"_73":1405,"_50":559},{"_73":1939,"_50":1940},{"_73":1937,"_50":1938},"H3 weights and access","https://huggingface.co/junchaoh-cs/SolarWM-H3-33B","Data access","https://huggingface.co/datasets/junchaoh-cs/SolarWM-Data","Code and documentation","https://github.com/Junchao-cs/SolarWM",[1944],{"_73":1352,"_50":1945},"https://arxiv.org/abs/2609.02886","Unifies data, training, and inference interfaces for camera-controlled streaming video. The source matrix lists all three stages for Wan2.2-5B and MiniMax-H3, but later stages for Wan2.2-14B and LTX-2.5 remain forthcoming. Backbones require separate runtime environments. The main data release contains annotations and indexes; latent payloads are separate, and the full processed training-video corpus requires reconstruction or approved access. The main Hugging Face dataset and H3 model repositories also require agreement to share contact information. This infrastructure does not provide a code world with queryable entity state.",[1952,1953,1954,1955],[1450,1930,1401,1931,1453],[1470,1370,293],[126,293],2026,{"_73":1941,"_50":1942},{"_73":1405,"_50":559},{"_73":1939,"_50":1940},{"_73":1937,"_50":1938},"resource:magpie-renderer","magpie-renderer","Magpie: Real-Time World Renderer for Interactive Games","A game engine runs gameplay while a separate Render Server generates final visuals.","/resources/magpie-renderer/",{"_44":1957,"_1363":1958,"_1361":293,"_71":1412,"_1362":1959,"_1357":1997,"_50":1996,"_1338":1998,"_1333":1999,"_1330":2000,"_1324":1951,"_1321":1320,"_81":2001},[1963,1964,1965,1966,1967,1968,1969,1970,1971,1972,1973,1974,1975,1976],{"_71":46,"_75":1958,"_77":1363,"_79":-7},{"_71":124,"_75":1959,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":1997,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":1994,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":1990,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":1984,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":1983,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":1982,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":1981},{"_71":81,"_77":1311,"_73":1312,"_83":1977},[1978],{"_73":1979,"_50":1980},"Nanjing University","https://arxiv.org/pdf/2608.27168","Paper page 1 identifies first author Xiaoyu Zhan with affiliations 1 and 2: Mogo AI Ltd. and Nanjing University. Select the first author’s university affiliation. Other authors also represent the University of Southampton. This logo is the official Nanjing University/Computer Science header identity from https://cs.nju.edu.cn/; an authentic Magpie project favicon is separately linked by the author site at https://zhanxy.xyz/Magpie-website/magpie-mark.png.",[109,286],[1447,1335,286],[1985,1986,1987,1988,1989],"hybrid-renderer","executable-state","game-engine","render-server","research",[1991],{"_73":1992,"_50":1993},"Paper v1 latency and limitations","https://arxiv.org/html/2608.27168v1",[1995],{"_73":1352,"_50":1996},"https://arxiv.org/abs/2608.27168","Designers define scenes and rules in a conventional game engine. At runtime, the engine processes player actions and maintains state, while a rendering service transforms engine-produced whitebox frames into final visuals. It demonstrates a division between generative rendering and reproducible gameplay, primarily reducing prototype dependence on complete art assets. The paper reports chunk-based interaction delay and remaining visual-consistency limitations; it does not establish a production-ready game renderer.",[1985,1986,1987,1988,1989],[1470,1370,293],[126,293],[2002],{"_73":1992,"_50":1993},"resource:coder-world-model","coder-world-model","CoDeR — Code Plans, Diffusion Renders","Collaborating agents build executable worlds, with diffusion models rendering observations.","/resources/coder-world-model/",{"_44":2004,"_1363":2005,"_1361":293,"_71":1412,"_1362":2006,"_1357":2040,"_50":2039,"_81":2041,"_1338":2042,"_1333":2043,"_1330":2044,"_1324":1951,"_1321":1395},[2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023],{"_71":46,"_75":2005,"_77":1363,"_79":-7},{"_71":124,"_75":2006,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2040,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2037,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2034,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2031,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2030,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2029,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":2028},{"_71":81,"_77":1311,"_73":1312,"_83":2024},[2025],{"_73":2026,"_50":2027},"University of Science and Technology of China","https://arxiv.org/html/2609.26458v1","The original CoDeR paper lists USTC and TongYi Lab; USTC is the first listed institutional affiliation. Select USTC while preserving TongYi Lab as a collaborator. The PNG is used as the school-icon image in the header and footer of the official English university homepage.",[109,286],[1637,1447,286],[1719,2032,1985,2033,1989],"multi-agent","persistent-state",[2035],{"_73":1405,"_50":2036},"https://becauseimbatman0.github.io/CoDeR",[2038],{"_73":1352,"_50":2039},"https://arxiv.org/abs/2609.26458","Code Plans, Diffusion Renders: Open-Ended Generative World Modeling uses five collaborating roles to turn concepts into rules, code, and observations, allowing entities to keep evolving outside the current view. The paper studies long-term memory, open-ended interaction, and multi-agent worlds. Its abstract says code and weights will be released; distinguish reported results from artifacts already available.",[2045],[1719,2032,1985,2033,1989],[1653,1470,293],[126,293],{"_73":1405,"_50":2036},"resource:programmable-world-model","programmable-world-model","Programmable World Model","Explicit global state and programmable rules preserve entities outside the camera view.","/resources/programmable-world-model/",{"_44":2047,"_1363":2048,"_1361":293,"_71":1412,"_1362":2049,"_1357":2083,"_50":2082,"_81":2084,"_1338":2085,"_1333":2086,"_1330":2087,"_1324":1951,"_1321":1395},[2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066],{"_71":46,"_75":2048,"_77":1363,"_79":-7},{"_71":124,"_75":2049,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2083,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2080,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2076,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2074,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2073,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2072,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":2071},{"_71":81,"_77":1311,"_73":1312,"_83":2067},[2068],{"_73":2069,"_50":2070},"Alaya Lab","https://alaya-lab.github.io/pwm/","The official project page and repository explicitly identify Alaya Lab. The logo is the official lab favicon linked by https://alayalab.ai/. A white variant is also linked there at assets/brand/alaya-lab-icon-white.svg. No university affiliation is inferred.",[109,286],[1447,1545,286],[1719,1986,1985,2033,2075],"CombatStateBench",[2077],{"_73":2078,"_50":2079},"Project and release progress","https://github.com/AlayaLab/pwm",[2081],{"_73":1352,"_50":2082},"https://arxiv.org/abs/2609.10540","An agent converts instructions into entity states and state-transition programs. A lightweight engine maintains global state, then compiles stateful 3D oriented bounding boxes and camera trajectories into video model controls. The paper introduces CombatStateBench to check entity counts and irreversible states. The public repository currently centers on project documentation, which does not establish that complete inference code and weights are available.",[2088],[1719,1986,1985,2033,2075],[1470,1562,293],[126,293],{"_73":2078,"_50":2079},"resource:code-world-model-brain","A coding agent writes executable rules and persistent state to drive a video world.",{"_44":1094,"_1363":1091,"_1361":293,"_71":1412,"_1362":2090,"_1357":2127,"_50":2126,"_81":2128,"_1338":2129,"_1333":2130,"_1330":2131,"_1324":1951,"_1321":1395},[2093,2094,2095,2096,2097,2098,2099,2100,2101,2102,2103,2104,2105,2106],{"_71":46,"_75":1091,"_77":1363,"_79":-7},{"_71":124,"_75":2090,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2127,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2124,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2117,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2113,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2112,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2111,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":2110},{"_71":81,"_77":1311,"_73":1312,"_83":2107},[2108],{"_73":2109,"_50":1082},"Westlake University","The author project page lists AGI Lab, Westlake University as affiliation 1 and Nanyang Technological University as affiliation 2. First author Yiwen Chen has both affiliations. Select the first listed institution. The logo URL is declared as Organization.logo in the official English university homepage JSON-LD.",[109,286],[1637,1447,286],[1719,2114,1986,1985,2115,2116],"coding-agent","MiniMax-H3","partial-release",[2118,2119,2120],{"_73":1405,"_50":1082},{"_73":1459,"_50":2123},{"_73":2121,"_50":2122},"Reproduction scope","https://github.com/buaacyw/code-world-model/blob/main/ENVIRONMENT.md","https://github.com/buaacyw/code-world-model",[2125],{"_73":1352,"_50":2126},"https://arxiv.org/abs/2608.25927","Separates world evolution from visual generation. An agent maintains executable state, which is compiled into controls for a fine-tuned MiniMax-H3 renderer. The released inference interface uses an RGB first-frame anchor, per-frame depth and semantic-ID controls, and per-window prompts. Inference code, LoRAs, and examples are public, but the underlying game code that generates proxies cannot be redistributed. The complete agent-to-engine pipeline cannot be reproduced unchanged from those artifacts.",[2132,2133,2134],[1719,2114,1986,1985,2115,2116],[1653,1470,293],[126,293],{"_73":1405,"_50":1082},{"_73":1459,"_50":2123},{"_73":2121,"_50":2122},"resource:streamrender-h3","A code engine maintains the world while streaming diffusion renders its semantic maps.",{"_44":360,"_1363":356,"_1361":293,"_71":1465,"_1362":2136,"_1357":2178,"_50":348,"_81":2179,"_1338":2180,"_1333":2181,"_1330":2182,"_1324":1951,"_1321":1320},[2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153],{"_71":46,"_75":356,"_77":1363,"_79":-7},{"_71":124,"_75":2136,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1464,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2178,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2176,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2163,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2160,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2159,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2158,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1320,"_77":1321,"_79":111},{"_71":1591,"_77":1592,"_73":1593,"_94":352,"_103":353,"_57":348,"_78":345},{"_71":72,"_77":1316,"_73":1317,"_75":2157},{"_71":81,"_77":1311,"_73":1312,"_83":2154},[2155],{"_73":2156,"_50":348},"NVIDIA Research","The official project page footer identifies StreamRender-H3 as NVIDIA Research. The full, original vertical NVIDIA logo is supplied by the official NVIDIA Logo and Brand Guidelines page.",[109,286],[1447,1335,286],[1985,1986,1931,2161,2115,2162],"three.js","NVIDIA",[2164,2165,2166,2167],{"_73":2174,"_50":2175},{"_73":2172,"_50":2173},{"_73":2170,"_50":2171},{"_73":2168,"_50":2169},"Weights and component licenses","https://huggingface.co/Efficient-Large-Model/StreamRender-H3","Pinned runtime source","https://github.com/NVlabs/Sana/tree/0527465fdcbbf27180a76419a4e73643aa1aac73/models/streamrender_h3","Agent workflow","https://nvlabs.github.io/Sana/Sol-Engine/docs/agent-workflow/","Sol-Engine","https://nvlabs.github.io/Sana/Sol-Engine/",[2177],{"_73":1352,"_50":348},"NVIDIA Sol-Engine's Interactive Coding Worlds system uses a three.js racing game. The engine handles map, physics, collision, and input, while a two-step streaming MiniMax-H3 model renders semantic video conditioned on a first frame and prompt. Reported training and tests cover that one game and third-person view. Semantic colors identify classes rather than individual objects. Diffusion-render timings use eight GB200 GPUs; the causal decoder is measured separately on one GB200. Independent stage timings do not establish end-to-end input-to-display latency. Runtime source and a weight bundle are public, with component-specific terms.",[2183,2184,2185,2186],[1985,1986,1931,2161,2115,2162],[1470,1370,293],[126,293],{"_73":2174,"_50":2175},{"_73":2172,"_50":2173},{"_73":2170,"_50":2171},{"_73":2168,"_50":2169},"resource:solarrenderer","Turns engine- or agent-generated structure videos into styled final visuals.",{"_44":295,"_1363":289,"_1361":293,"_71":1412,"_1362":2188,"_1357":2233,"_50":279,"_81":2234,"_1338":2235,"_1333":2236,"_1330":2237,"_1324":1951,"_1321":1395},[2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205],{"_71":46,"_75":289,"_77":1363,"_79":-7},{"_71":124,"_75":2188,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":286,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1411,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2233,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2231,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2216,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2213,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2212,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2211,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":1591,"_77":1592,"_73":1593,"_94":284,"_103":285,"_57":279,"_78":2210},{"_71":72,"_77":1316,"_73":1317,"_75":2209},{"_71":81,"_77":1311,"_73":1312,"_83":2206},[2207],{"_73":2208,"_50":279},"National University of Singapore","First author Guian Fang is affiliation 1 (NUS). The author page also lists LIGHTSPEED, CUHK(SZ), SLAI, and HKUST(GZ). Use the complete vertical logo from the official NUS identity page, not an isolated shield: https://www.nus.edu.sg/identity/elements-of-the-nus-logo. The displayed shield is the official NUS website icon supplied by the School of Computing website; this does not assign the paper to that school.","SolarRenderer authors · model output",[232,109,286],[1447,1335,286],[1985,2214,1931,2115,2215,1453],"structure-conditioning","LoRA",[2217,2218,2219,2220,2221],{"_73":1774,"_50":2230},{"_73":2228,"_50":2229},{"_73":2226,"_50":2227},{"_73":2224,"_50":2225},{"_73":2222,"_50":2223},"Usage guide","https://github.com/Junchao-cs/SolarWM/blob/main/docs/solar_renderer.md","Data and evaluation","https://huggingface.co/datasets/Enderfga/SolarRenderer-Data","Weights","https://huggingface.co/Enderfga/SolarRenderer","Paper PDF","https://enderfga.cn/data/solarrenderer.pdf","https://github.com/Enderfga/SolarRenderer",[2232],{"_73":1352,"_50":279},"Few-Step Generative Reference Rendering conditions MiniMax-H3 on semantic maps, grayboxes, skeletons, depth, and other structures, with an optional first frame and text. Control and four-step LoRAs include a block-causal variant. Code is Apache-2.0; weights use the geographically restricted MiniMax H3 Community License, and data has component-specific terms, including noncommercial and research-only portions. Upstream programs must maintain world state and rules. Four-step sampling alone does not establish real-time consumer-hardware interaction.",[2238,2239,2240,2241,2242],[1985,2214,1931,2115,2215,1453],[1470,1370,293],[247,126,293],{"_73":1774,"_50":2230},{"_73":2228,"_50":2229},{"_73":2226,"_50":2227},{"_73":2224,"_50":2225},{"_73":2222,"_50":2223},"resource:level-design-book-skill","level-design-book-skill","Level Design Book · unofficial design skill","An unofficial, agent-neutral adaptation of The Level Design Book for level briefs, blockouts, encounters, wayfinding, and evidence-based playtest reviews.","/resources/level-design-book-skill/",{"_44":2244,"_1363":2245,"_1361":2320,"_71":2297,"_1362":2246,"_1357":2317,"_50":2281,"_81":2321,"_1338":2322,"_1333":2323,"_1330":2324,"_1324":1951,"_1321":1395,"_2277":2325},[2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269],{"_71":46,"_75":2245,"_77":1363,"_79":-7},{"_71":124,"_75":2246,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":2319,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":2318,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2317,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2315,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2304,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2295,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2293,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2292,"_77":1330,"_79":-7},{"_71":72,"_73":1322,"_75":1926,"_77":1324,"_79":111},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":81,"_73":2286,"_83":2287,"_77":2277,"_79":-7},{"_71":72,"_73":2275,"_75":2286,"_77":2277,"_79":-7},{"_71":72,"_73":43,"_75":2285,"_77":2277,"_79":-7},{"_71":72,"_73":2275,"_75":2284,"_77":2277,"_79":-7},{"_71":81,"_73":57,"_83":2278,"_77":2277,"_79":-7},{"_71":72,"_73":2275,"_75":2276,"_77":2277,"_79":-7},{"_71":72,"_77":1316,"_73":1317,"_75":2274},{"_71":81,"_77":1311,"_73":1312,"_83":2270},[2271],{"_73":2272,"_50":2273},"The Level Design Book · unofficial adaptation","https://book.leveldesignbook.com/appendix/about","Original writing: Robert Yang and contributors including Andrew Yoder. GameMap distributes an unofficial operational adaptation with its original CC BY-NC-SA 4.0 license, attribution, source map, and third-party exceptions. The book authors and pi maintainers have not endorsed this package. No generated logo or maintainer portrait is used.","Access type","full source","access",[2279],{"_73":2280,"_50":2281,"_2282":2283},"Complete skill package and license","https://github.com/OpenEnvision/GameMap/tree/main/docs/skills/level-design","note","Text-only package with SKILL.md, LICENSE.md, references, and templates. CC BY-NC-SA 4.0 applies to this adaptation directory, not the whole repository; commercial distribution requires appropriate permission.","unavailable","Instructions and templates, not a runnable demo — No engine plugin, executable level, benchmark result, or validated playtest is supplied.","tutorial",[2288],{"_73":2289,"_50":2290,"_2282":2291},"Read the original book","https://book.leveldesignbook.com/","The underlying book remains authoritative. The skill reorganizes guidance and templates rather than claiming universal design laws or independently measured outcomes.",[109,232],[1637,1335,1545,2294],"Build & release",[2296,2297,2298,2299,2300,2301,2302,2303],"level-design","skill","blockout","playtesting","agent-neutral","CC-BY-NC-SA-4.0","noncommercial","unofficial-adaptation",[2305,2306,2307,2308],{"_73":2314,"_50":2290},{"_73":2313,"_50":2273},{"_73":2311,"_50":2312},{"_73":2309,"_50":2310},"CC BY-NC-SA 4.0 legal code","https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","Book licensing and third-party exceptions","https://book.leveldesignbook.com/appendix/license","Original authors and contributors","The Level Design Book",[2316],{"_73":1352,"_50":2281},"The English skill package reorganizes The Level Design Book into task routing, thirteen topical/source references, and three reusable templates. It is primarily for 3D levels; 2D adaptations must state changed assumptions. The package reports a 2026-10-16 source snapshot and maps 94 indexed source pages, including unfinished sections; GameMap has not independently reproduced that reading exercise, run the workflows, or validated design outcomes. Original writing is attributed to Robert Yang and contributors including Andrew Yoder. This is not an official book edition or a pi-maintainer publication. The adaptation is CC BY-NC-SA 4.0: retain attribution and change notices, observe noncommercial/share-alike conditions, and review separate third-party exceptions. Those terms do not automatically license every game output.","Skill","Game production","production",[2333,2334,2335,2336],[2296,2297,2298,2299,2300,2301,2302,2303],[1653,1370,1562,2332],[126,247],{"_2286":2326,"_43":2327,"_57":2328},{"_73":2289,"_50":2290,"_42":2286,"_2282":2291},{"_73":2330,"_42":2284,"_2282":2331},{"_73":2280,"_50":2281,"_42":2329,"_2282":2283},"full-source","Instructions and templates, not a runnable demo","No engine plugin, executable level, benchmark result, or validated playtest is supplied.","ship",{"_73":2314,"_50":2290},{"_73":2313,"_50":2273},{"_73":2311,"_50":2312},{"_73":2309,"_50":2310},"resource:playwright-test","playwright-test","Playwright Test","Browser testing with DOM actions, assertions and screenshot comparisons.","/resources/playwright-test/",{"_44":2338,"_1363":2339,"_1361":2320,"_71":1364,"_1362":2340,"_1357":2377,"_50":2360,"_81":2378,"_1338":2379,"_1333":2380,"_1330":2381,"_1321":1395},[2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356],{"_71":46,"_75":2339,"_77":1363,"_79":-7},{"_71":124,"_75":2340,"_77":1362,"_79":-7},{"_71":72,"_73":1360,"_75":2319,"_77":1361,"_79":111},{"_71":72,"_73":1358,"_75":1359,"_77":71,"_79":111},{"_71":72,"_73":1355,"_75":2377,"_77":1357,"_79":80},{"_71":81,"_73":1352,"_83":2375,"_77":50,"_79":-7},{"_71":81,"_73":1344,"_83":2368,"_77":81,"_79":-7},{"_71":1325,"_73":1336,"_1327":1328,"_83":2364,"_77":1338,"_79":-7},{"_71":1325,"_73":1331,"_1327":1328,"_83":2363,"_77":1333,"_79":-7},{"_71":1325,"_73":1326,"_1327":1328,"_83":2362,"_77":1330,"_79":-7},{"_71":72,"_73":1319,"_75":1395,"_77":1321,"_79":111},{"_71":72,"_77":1316,"_73":1317,"_75":2361},{"_71":81,"_77":1311,"_73":1312,"_83":2357},[2358],{"_73":2359,"_50":2360},"Microsoft / Playwright","https://playwright.dev/docs/test-snapshots","Official project or publisher attribution is supported by the linked primary source. The existing bundled mark identifies the same organization or product; inclusion is not an endorsement.",[232,109,286],[1447,1545],[2365,2366,2367],"Browser testing","Visual regression","DOM",[2369,2370],{"_73":2373,"_50":2374},{"_73":2371,"_50":2372},"Screenshot assertion API","https://playwright.dev/docs/api/class-pageassertions","Actionability","https://playwright.dev/docs/actionability",[2376],{"_73":1352,"_50":2360},"Screenshot assertions wait for two matching captures before comparison, but stable pixels do not prove application readiness. Record browser, fonts, viewport and capture options: animation disabling, masks and styles can alter evidence. DOM access is a different observation surface from screenshot-only control or Playwright MCP.",[2382,2383],[2365,2366,2367],[1470,1562],[247,126,293],{"_73":2373,"