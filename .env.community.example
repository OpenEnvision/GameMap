# Production standalone community server configuration (single-instance persistent Node host).
# Fill secrets only on your private host; never commit real credentials or use VITE_ prefixes.
# Provision a dedicated NOINHERIT database login via `npm run cloud:provision-sql`.
NODE_ENV=production
COMMUNITY_DATABASE_URL=postgresql://community_server_prod:REPLACE_PRIVATELY@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Generate independently from Studio's secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COMMUNITY_SESSION_SECRET=
COMMUNITY_RELEASE_REALM_FILE=/etc/gamemap/realm.json
COMMUNITY_ORIGIN=https://gamemap.example.com
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=4192

# Set to 1 only when running behind a trusted TLS reverse proxy (Caddy/Nginx) on the same host.
COMMUNITY_TRUST_PROXY=1

# Required in production: absolute persistent private directory outside the repository/web root.
COMMUNITY_MEDIA_ROOT=/srv/gamemap/community-media
COMMUNITY_MEDIA_PROFILE=low-memory

# Optional: serve the committed static site snapshot and community API from one origin.
# Omit when static files are served by Nginx/Caddy or GitHub Pages.
# COMMUNITY_PUBLICATION_DIR=/srv/gamemap/publication

# Optional: immediate HTTP 410 emergency denylist exported via `npm run cloud:withdraw -- export-denylist`.
# WITHDRAWAL_DENYLIST_FILE=/etc/gamemap/denylist.json
