{
  "name": "gamemap-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate.mjs && node scripts/prepare-docs.mjs && react-router typegen && tsc -b && react-router build && node scripts/finalize-build.mjs",
    "check": "node scripts/check.mjs && node scripts/check-content.mjs && node scripts/check-locales.mjs && npm run test:content && npm run test:platform && npm run check:studio",
    "check:build": "node scripts/check.mjs --built && node scripts/check-web.mjs && node scripts/check-content.mjs --built && node scripts/check-locales.mjs --built",
    "check:docs": "node scripts/check-doc-translations.mjs",
    "test:content": "node --test tests/content.test.mjs",
    "test:platform": "node --test tests/platform-*.test.mjs",
    "remote:import": "node scripts/remote-import.mjs",
    "research:import": "node scripts/import-research-archives.mjs",
    "examples:import": "node scripts/import-jam-games.mjs",
    "test:examples:import": "node --test tests/platform-jam-games.test.mjs",
    "examples:media:collect": "node scripts/collect-example-media.mjs",
    "examples:media:import": "node scripts/import-example-media.mjs",
    "test:examples:media": "node --test tests/platform-example-media.test.mjs",
    "test:research:import": "node --test tests/platform-research-archives.test.mjs tests/remote-documents.test.mjs",
    "test:remote:import": "node --test tests/platform-remote-import.test.mjs",
    "test:remote:source": "node --test tests/platform-remote-source.test.mjs",
    "platform:export": "node scripts/platform.mjs export",
    "platform:verify": "node scripts/platform.mjs verify",
    "studio:dev": "node --env-file-if-exists=.env scripts/studio-dev.mjs",
    "studio:start": "node --env-file-if-exists=.env scripts/studio.mjs --production",
    "studio:build": "tsc -p studio/tsconfig.json && node scripts/build-studio.mjs",
    "check:studio": "prettier --check studio config/staging.example.json scripts/staging-readiness.mjs tests/platform-staging.test.mjs scripts/lib/catalog scripts/local-catalog.mjs scripts/local-docker.mjs scripts/local-publication.mjs tests/local-supabase.mjs tests/local-publication.mjs tests/helpers/publication-crash.mjs tests/platform-publication.test.mjs tests/platform-local.test.mjs website/content/contracts.ts website/content/assembly.ts && tsc -p studio/tsconfig.json",
    "format:platform": "prettier --write studio config/staging.example.json scripts/staging-readiness.mjs tests/platform-staging.test.mjs scripts/lib/catalog scripts/local-catalog.mjs scripts/local-docker.mjs scripts/local-publication.mjs tests/local-supabase.mjs tests/local-publication.mjs tests/helpers/publication-crash.mjs tests/platform-publication.test.mjs tests/platform-local.test.mjs website/content/contracts.ts website/content/assembly.ts",
    "test:studio": "playwright test --config studio/playwright.config.ts",
    "studio:export": "node --env-file-if-exists=.env scripts/release.mjs export",
    "studio:verify": "node scripts/release.mjs verify",
    "site:build": "node scripts/site-release.mjs build",
    "site:verify": "node scripts/site-release.mjs verify",
    "staging:check": "node scripts/staging-readiness.mjs",
    "local:start": "node scripts/local-catalog.mjs start",
    "local:setup": "node scripts/local-catalog.mjs setup",
    "local:migrate": "node scripts/local-catalog.mjs migrate",
    "local:realm-setup": "node scripts/local-catalog.mjs realm-setup",
    "local:publisher-setup": "node scripts/local-publication.mjs setup",
    "local:publication-status": "node scripts/local-publication.mjs status",
    "local:publish": "node scripts/local-publication.mjs publish",
    "local:rollback": "node scripts/local-publication.mjs rollback",
    "local:publication-recover": "node scripts/local-publication.mjs recover",
    "local:publication-serve": "node scripts/local-publication.mjs serve",
    "local:status": "node scripts/local-catalog.mjs status",
    "community:setup": "node scripts/community.mjs setup",
    "community:status": "node scripts/community.mjs status",
    "test:community": "node --test tests/platform-community*.test.mjs",
    "local:stop": "node scripts/local-catalog.mjs stop",
    "local:backup": "node scripts/local-catalog.mjs backup",
    "local:restore-probe": "node scripts/local-catalog.mjs restore-probe",
    "test:local": "npm run studio:build && node tests/local-supabase.mjs",
    "test:local:publication": "node tests/local-publication.mjs",
    "preview": "node scripts/preview.mjs",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "esbuild": "0.28.2",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.4",
    "@react-router/node": "^7.18.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "rehype-raw": "7.0.0",
    "remark-stringify": "^11.0.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.0"
  }
}
