{
  "name": "gamemap-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/build/dev.mjs",
    "build": "node scripts/build/generate.mjs && node scripts/build/prepare-docs.mjs && react-router typegen && tsc -b && react-router build && node scripts/build/finalize.mjs",
    "build:community-direct": "VITE_GAMEMAP_COMMUNITY=1 VITE_GAMEMAP_COMMUNITY_MODE=supabase-direct npm run build",
    "preview": "node scripts/build/preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check/catalog.mjs && node scripts/check/content.mjs && node scripts/check/locales.mjs && npm run check:search && npm run check:resources && npm run check:agents && npm run check:testing && npm run check:papers && npm run check:research && npm run check:dev-deps && npm run check:learning && npm run format:check",
    "check:build": "node scripts/check/catalog.mjs --built && node scripts/check/learning-hub.mjs --built && node scripts/check/web.mjs && node scripts/check/research-browser.mjs --built && node scripts/check/content.mjs --built && node scripts/check/locales.mjs --built",
    "check:docs": "node scripts/check/doc-translations.mjs",
    "check:search": "node scripts/check/search-ranking.mjs",
    "community:direct-sql": "node scripts/community-direct.mjs",
    "check:resources": "node scripts/check/resource-catalog.mjs",
    "check:agents": "node scripts/check/agent-browser.mjs",
    "check:testing": "node scripts/check/testing-browser.mjs",
    "check:papers": "node scripts/check/paper-browser.mjs",
    "check:research": "node scripts/check/research-browser.mjs && node scripts/check/research-detail.mjs",
    "check:dev-deps": "node scripts/check/dev-dependencies.mjs",
    "check:learning": "node scripts/check/learning-hub.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "esbuild": "0.28.2",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "rehype-raw": "7.0.0",
    "remark-stringify": "^11.0.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.0"
  }
}
