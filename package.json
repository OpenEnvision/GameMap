{
  "name": "gamemap-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-assets.mjs && node scripts/check-entry.mjs && node scripts/check.mjs && node scripts/check-content.mjs && node scripts/check-papers.mjs && node scripts/check-locales.mjs && npm run test:content",
    "check:build": "node scripts/check-assets.mjs --built && node scripts/check.mjs --built && node scripts/check-web.mjs && node scripts/check-content.mjs --built && node scripts/check-papers.mjs && node scripts/check-locales.mjs --built && node scripts/check-entry.mjs && node scripts/check-web.mjs --root .",
    "test:content": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "test:web": "playwright test",
    "sync:papers": "node scripts/sync-papers.mjs",
    "generate:entry": "node scripts/generate-entry.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:pages": "node scripts/package-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.4",
    "@react-router/node": "^7.18.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "parse5": "^8.0.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.0"
  }
}
