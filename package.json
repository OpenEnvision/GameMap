{
  "name": "gamemap-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/build/dev.mjs",
    "dev:git": "node scripts/build/dev.mjs --git",
    "build": "node scripts/build/generate.mjs && node scripts/build/prepare-docs.mjs && react-router typegen && tsc -b && react-router build && node scripts/build/finalize.mjs",
    "preview": "node scripts/build/preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check/catalog.mjs && node scripts/check/content.mjs && node scripts/check/locales.mjs && npm run test:unit && npm run check:studio && npm run check:tests && npm run format:check",
    "check:build": "node scripts/check/catalog.mjs --built && node scripts/check/web.mjs && node scripts/check/content.mjs --built && node scripts/check/locales.mjs --built",
    "check:docs": "node scripts/check/doc-translations.mjs",
    "check:studio": "tsc -p studio/tsconfig.json",
    "check:tests": "tsc -p tests/tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:web": "playwright test",
    "test:studio": "playwright test --config studio/playwright.config.ts",
    "test:local": "npm run studio:build && node tests/local/supabase.mjs",
    "test:local:publication": "node tests/local/publication.mjs",
    "test:local:development": "node tests/local/development.mjs",
    "test:community": "node --test tests/unit/community*.test.mjs",
    "test:examples:import": "node --test tests/unit/jam-games.test.mjs",
    "test:examples:media": "node --test tests/unit/example-media.test.mjs",
    "test:research:import": "node --test tests/unit/research-archives.test.mjs tests/unit/remote-documents.test.mjs",
    "test:remote:import": "node --test tests/unit/remote-import.test.mjs",
    "test:remote:source": "node --test tests/unit/remote-source.test.mjs",
    "examples:import": "node scripts/import/jam-games.mjs",
    "examples:media:collect": "node scripts/media/collect-example-media.mjs",
    "examples:media:import": "node scripts/import/example-media.mjs",
    "research:import": "node scripts/import/research-archives.mjs",
    "remote:import": "node scripts/import/remote.mjs",
    "studio:dev": "node --env-file-if-exists=.env scripts/platform/studio-dev.mjs",
    "studio:start": "node --env-file-if-exists=.env scripts/platform/studio.mjs --production",
    "studio:build": "tsc -p studio/tsconfig.json && node scripts/platform/studio-build.mjs",
    "studio:export": "node --env-file-if-exists=.env scripts/platform/release.mjs export",
    "studio:verify": "node scripts/platform/release.mjs verify",
    "platform:export": "node scripts/platform/package.mjs export",
    "platform:verify": "node scripts/platform/package.mjs verify",
    "site:build": "node scripts/platform/site-release.mjs build",
    "site:verify": "node scripts/platform/site-release.mjs verify",
    "staging:check": "node scripts/platform/staging-readiness.mjs",
    "local:start": "node scripts/platform/local-catalog.mjs start",
    "local:stop": "node scripts/platform/local-catalog.mjs stop",
    "local:status": "node scripts/platform/local-catalog.mjs status",
    "local:setup": "node scripts/platform/local-catalog.mjs setup",
    "local:migrate": "node scripts/platform/local-catalog.mjs migrate",
    "local:import": "node scripts/platform/local-import.mjs",
    "local:realm-setup": "node scripts/platform/local-catalog.mjs realm-setup",
    "local:backup": "node scripts/platform/local-catalog.mjs backup",
    "local:restore-probe": "node scripts/platform/local-catalog.mjs restore-probe",
    "local:publisher-setup": "node scripts/platform/local-publication.mjs setup",
    "local:publication-status": "node scripts/platform/local-publication.mjs status",
    "local:publish": "node scripts/platform/local-publication.mjs publish",
    "local:rollback": "node scripts/platform/local-publication.mjs rollback",
    "local:publication-recover": "node scripts/platform/local-publication.mjs recover",
    "local:publication-serve": "node scripts/platform/local-publication.mjs serve",
    "community:setup": "node scripts/platform/community.mjs setup",
    "community:dev": "node scripts/platform/community.mjs setup --dev",
    "community:status": "node scripts/platform/community.mjs status"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "esbuild": "0.28.2",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "rehype-raw": "7.0.0",
    "remark-stringify": "^11.0.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.0"
  }
}
