# Example single-host Nginx TLS reverse-proxy configuration for GameMap Cloud.
# Replace certificate paths and domain names before use. Keep Studio and public site on distinct origins.

server {
  listen 443 ssl http2;
  server_name studio.gamemap.example.com;

  ssl_certificate     /etc/letsencrypt/live/studio.gamemap.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/studio.gamemap.example.com/privkey.pem;
  client_max_body_size 11m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;

  location / {
    proxy_pass http://127.0.0.1:4180;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl http2;
  server_name gamemap.example.com;

  ssl_certificate     /etc/letsencrypt/live/gamemap.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/gamemap.example.com/privkey.pem;
  client_max_body_size 11m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;

  location ~ ^/(api/community/|auth/callback$|community-media/|healthz$) {
    proxy_pass http://127.0.0.1:4192;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://127.0.0.1:4192;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
