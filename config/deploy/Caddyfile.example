# Example single-host Caddy reverse-proxy configuration for GameMap Cloud (automatic HTTPS/TLS).
# Studio runs on its own origin (port 4180); Community API + optional static site share the public origin (port 4192).
# Set CATALOG_TRUST_PROXY=1 and COMMUNITY_TRUST_PROXY=1 so rate limiting sees client IPs without spoofing.

studio.gamemap.example.com {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
  reverse_proxy 127.0.0.1:4180 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

gamemap.example.com {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # Community BFF, OAuth/email callback and access-controlled submission screenshots
  @community path /api/community/* /auth/callback /community-media/* /healthz
  handle @community {
    reverse_proxy 127.0.0.1:4192 {
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Option A: proxy static site from persistent-node publication server (port 4192 with COMMUNITY_PUBLICATION_DIR)
  # Option B: replace with `root * /srv/gamemap/publication/current` + `file_server`
  handle {
    reverse_proxy 127.0.0.1:4192 {
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
}
