,"Unreal Engine","AutomationTool","Multi-process testing","Cooked builds","Project source",[88],{"_50":86,"_25":56},"Why it belongs here","Gauntlet consumes prepared cooked builds and launches configured game roles through AutomationTool. Game-specific test nodes define assertions and terminal outcomes; launching a client and server alone does not establish scenario success. Build production, device availability, process cleanup, and parallel-session port allocation remain separate responsibilities.","detail","guidance","Resource type","Documentation","Category","Game production","category","lead","summary","name","production","docs",[],[82,83,84,85],[108,109],[107],"3d","test","ship",{"_111":112},"documents",{"_113":114,"_115":116},"en",[118,122,123,124,121,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,120,157,119,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178],"zh",[117,118,119,120,121],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","catalog","contributing","media-sources","icon-sources","content-model","skills/level-design/SKILL","skills/leve