ording-genie3-jetski.webp","aspectRatio",1.8181818181818181,"mobile","previewSrc","Preview description","Official Genie 3 recording showing a first-person jetski, festival lanterns over water, and directional control inputs","alt","Recording type","Original project recording","role","provenance","Track","World models","track","metadata","Related project",[91],"resourceId",{"_49":92,"_26":93},"Genie 3 / Project Genie","/resources/genie-3/","What this recording shows","An official recording of model interaction, not a live model running in this page or an exported game project. The separate Project Genie prototype currently requires an eligible personal Google AI Ultra account, age 18+, and limits exploration to 60 seconds.","limitations","Demo category","World model","demoType","lead","world","world-model","source-recording","recordingId","genie-3","resource:genie-3","resource","Generates interactive video worlds from prompts for real-time exploration.","/resources/",{"_20":105,"_176":92,"_174":101,"_47":177,"_175":108,"_170":169,"_26":63,"_154":178,"_150":179,"_146":180,"_140":181,"_137":136,"_57":182},[113,114,115,116,117,118,119,120,121,122,123,124,125,126],"website/src/data/resources.json",{"_47":22,"_51":92,"_53":176,"_55":-7},{"_47":100,"_51":108,"_53":175,"_55":-7},{"_47":48,"_49":173,"_51":85,"_53":174,"_55":87},{"_47":48,"_49":171,"_51":172,"_53":47,"_55":87},{"_47":48,"_49":168,"_51":169,"_53":170,"_55":56},{"_47":57,"_49":165,"_59":166,"_53":26,"_55":-7},{"_47":57,"_49":160,"_59":161,"_53":57,"_55":-7},{"_47":141,"_49":152,"_143":144,"_59":153,"_53":154,"_55":-7},{"_47":141,"_49":148,"_143":144,"_59":149,"_53":150,"_55":-7},{"_47":141,"_49":142,"_143":144,"_59":145,"_53":146,"_55":-7},{"_47":48,"_49":138,"_51":139,"_53":140,"_55":87},{"_47":48,"_49":135,"_51":136,"_53":137,"_55":87},{"_47":48,"_53":132,"_49":133,"_51":134},{"_47":57,"_53":127,"_49":128,"_59":129},"identitySource","Identity evidence",[130],{"_49":131,"_26":63},"Google DeepMind","identity","