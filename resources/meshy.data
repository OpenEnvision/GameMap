"_79":80,"_81":82,"_83":84},{"_56":66,"_58":67,"_60":68,"_69":70},{"_56":57,"_58":59,"_60":61,"_62":63},"type","links","field","originalImage","label","Original creator image","items",[64],{"_60":61,"_26":65},"https://raw.githubusercontent.com/9-K9/KatanaKitsune/bc9321eeaac727bbb5372a315ec58f68c96240ac/marketing/itch/05_attack.png","text","mediaReviewed","Screenshot source reviewed","value","2026-10-20","image","gameplay","Creator-published combat screenshot from the silent Godot prototype.","src","/GameMap/assets/media/learning/katana-kitsune-godot.webp","alt","The creator’s Katana Kitsune combat screenshot with an isometric courtyard, the party, enemies, health bars and minimap.","https://github.com/9-K9/KatanaKitsune/blob/bc9321eeaac727bbb5372a315ec58f68c96240ac/marketing/itch/05_attack.png","width",1280,"height",720,"credit","Creator-published screenshot","list","attribution","Creator-attributed clients / models (not inferred from related tools)",[89,90],"Claude Code","GitHub Copilot","Related resources",[95,96,97,98,99],"resourceIds","section",{"_60":89,"_26":108},{"_60":106,"_26":107},{"_60":104,"_26":105},{"_60":102,"_26":103},{"_60":100,"_26":101},"Blender","/resources/blender/","Meshy API","/resources/meshy/","PixelLab AI Agent Toolkit","/resources/pixellab/","Godot Engine · Official Documentation","/resources/godot-engine/","/resources/claude-code/","Creator evidence",[112],"evidence",{"_60":113,"_26":114,"_115":116},"Read the creator’s AI production disclosure","https://9-k9.itch.io/katanakitsune","note","The author explicitly names Claude Code and GitHub Copilot alongside image, sprite and 3D asset tools, and links the primary complete source repository. The README verifies the Godot version and explains which finished assets are included.","Source contents","complete project","Project source",[121],{"_60":122,"_26":123,"_115":124},"Open the complete Godot game project","https://github.com/9-K9/KatanaKitsune","Godot 4.7 project with scenes, GDScript, Dialogic addon and finished sprite assets. The inspected tree contains about 383 MB of files; no top-level game license was found. The upstream Meshy/Blender/PixelOver authoring pipeline is separate, while its finished runtime sprites are committed. The current source contains newer party/asset changes than the reviewed hosted prototype.","Access type","playable","demo","Play or run",[130],{"_60":131,"_26":114,"_115":132},"Play Katana Kitsune on itch.io","Silent HTML5 prototype with keyboard and gamepad support. Space confirms player/device choices; allow a clear press and release between setup steps. The browser build loaded and reached player/device selection in review; combat and a complete dungeon run were not exercised. The download is large: about 184 MB of game data plus 40 MB of WebAssembly.","Game platform","itch.io","Guide format","build log","tutorial","Build story / tutorial",[140],{"_60":141,"_26":142,"_115":-7},"Read the game and asset-pipeline documentation","https://github.com/9-K9/KatanaKitsune#readme","Study this workflow","ordered",true,[147,148,149,150],"Open the itch prototype and choose one human player, then claim a keyboard and select a costume.","Read the creator’s AI disclosure and the repository’s character, combat and sprite-pipeline notes.","Open project.godot in Godot 4.7 using GL Compatibility; the finished sprites and game scenes are included.","Change one combat or spawn setting, then check the title-to-character-to-dungeon flow, damage and restart.","AI workflow / foundation context","The creator identifies Claude Code, GitHub Copilot, GPT Image 2, PixelLab and Meshy among the production tools. The repository documents Meshy rigs and animation, Blender retargeting and PixelOver sprite exports. The exact coding models and division of code between assistants are not specified; generated NPC teammates are not the evidence for AI-assisted development.","aiUse","guidance","Creation category","AI-assisted (creator attribution)","category","provenance","Track","2D","track","metadata","Asset creation tools",false,[167,168,169,100,170],"assetTools","GPT Image 2","PixelLab","Meshy","PixelOver","Engine","Godot 4.7 · GDScript · 2D / GL Compatibility","engine","lead","2d","ai-assisted",[167,168,169,100,170],[147,148,149,150],{"_60":141,"_26":142,"_18":191},{"_60":131,"_26":114,"_18":126,"_115":132},{"_60":122,"_26":123,"_189":190,"_115":124},{"_60":113,"_26":114,"_115":116},[184,185,186,187,188],"claude-code","godot-engine","pixellab","meshy","blender","scope","complete-project","build-log","resource:meshy","resource","Connects AI model generation, humanoid rigging, and animation export for game asset workflows.","/resources/",{"_20":187,"_281":102,"_157":282,"_56":283,"_280":194,"_275":274,"_26":272,"_57":284,"_227":285,"_258":286,"_253":287,"_249":288,"_246":245},[199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217],"website/src/data/resources.json",{"_56":22,"_69":102,"_58":281,"_94":-7},{"_56":174,"_69":194,"_58":280,"_94":-7},{"_56":66,"_60":278,"_69":279,"_58":157,"_94":162},{"_56":66,"_60":276,"_69":277,"_58":56,"_94":162},{"_56":66,"_60":273,"_69":274,"_58":275,"_94":154},{"_56":57,"_60":119,"_62":270,"_58":26,"_94":-7},{"_56":57,"_60":265,"_62":266,"_58":57,"_94":-7},{"_56":85,"_60":256,"_144":164,"_62":257,"_58":258,"_94":-7},{"_56":85,"_60":251,"_144":164,"_62":252,"_58":253,"_94":-7},{"_56":85,"_60":247,"_144":164,"_62":248,"_58":249,"_94":-7},{"_56":66,"_60":244,"_69":245,"_58":246,"_94":162},{"_56":57,"_60":137,"_62":239,"_58":227,"_94":-7},{"_56":66,"_60":125,"_69":137,"_58":227,"_94":-7},{"_56":57,"_60":127,"_62":234,"_58":227,"_94":-7},{"_56":66,"_60":125,"_69":233,"_58":227,"_94":-7},{"_56":57,"_60":33,"_62":228,"_58":227,"_94":-7},{"_56":66,"_60":125,"_69":226,"_58":227,"_94":-7},{"_56":66,"_58":223,"_60":224,"_69":225},{"_56":57,"_58":218,"_60":219,"_62":220},"identitySource","Identity evidence",[221],{"_60":169,"_26":222},"https://www.meshy.ai/media-kit","identity","Identity & attribution","Original full-color Meshy brand mark downloaded from the official media kit; artwork and aspect ratio are preserved.","examples","access",[229],{"_60":230,"_26":231,"_115":232},"Cookbook example source","https://github.com/meshy-dev/meshy-cookbook","Public asset-generation recipes, not Meshy's model source or a complete game project.","interactive",[235],{"_60":236,"_26":237,"_115":238},"3D asset workspace","https://www.meshy.ai/workspace","Hosted generation and animation workspace; account access is required to generate assets. This is not a playable game.",[240],{"_60":241,"_26":242,"_115":243},"Image to animated character","https://www.meshy.ai/developers/cookbook/recipes/animate-3d-character/","Official guide with reference files, Python and TypeScript examples, and GLB/FBX outputs. API access uses credits.","Source reviewed","2026-10-18","verified","Tracks",[250],"dimensions","3D","Development stages",[254,255],"stages","Assets & animation","Engines & scenes","Topics",[259,260,261,262,263,264],"tags","Image-to-3D","Rigging","Character animation","GLB","FBX","Commercial service","Further reading",[267],{"_60":268,"_26":269},"Rigging requirements","https://docs.meshy.ai/en/api/rigging",[271],{"_60":119,"_26":272},"https://docs.meshy.ai/en","Why it belongs here","The official animated-character recipe turns a reference image into a textured, rigged character with idle, jump, and attack clips in GLB and FBX. The animation step applies motions from Meshy's library. API rigging works best with standard textured bipeds with clearly separated limbs. Generated assets still need engine import, collision, controls, and performance checks; the public cookbook supplies asset examples rather than complete gameplay.","detail","Resource type","Tool","Category","Game production","summary","name","production","tool",[295],{"_137":292,"_127":293,"_33":294},[259,260,261,262,263,264],[290,291],[289],"3d","assets","scene",{"_60":241,"_26":242,"_18":137,"_1