ode-agent-teams",[711,712,713,714],"Play the finished game and test rotation, hard drop, pause, and restart.","Read the original team prompt and the separate engine, renderer, and UI assignments.","Compare the shared state and event contract with each teammate’s completed module.","Review the coordination notes to see how parallel work was assigned and integrated.","The author documents a Claude Opus 4.6 agent team, shared scaffolding, separate file ownership, and the exact prompts assigned to each teammate.","Canvas 2D · JavaScript",[711,712,713,714],{"_66":708,"_34":709,"_26":169},{"_66":704,"_34":687,"_26":117,"_107":705},{"_66":699,"_34":700,"_107":701,"_167":168},{"_66":694,"_34":695,"_107":696},[323,166],"resource:playwright-mcp","resource","Microsoft's browser automation MCP server for exposing page structure, interactions, and browser feedback to agents.","/resources/",{"_28":166,"_789":97,"_147":790,"_62":791,"_788":725,"_783":782,"_34":748,"_765":792,"_760":793,"_757":794,"_754":753,"_90":795},[730,731,732,733,734,735,736,737,738,739,740,741,742],"website/src/data/resources.json",{"_62":30,"_68":97,"_64":789,"_94":-7},{"_62":156,"_68":725,"_64":788,"_94":-7},{"_62":63,"_66":786,"_68":787,"_64":147,"_94":152},{"_62":63,"_66":784,"_68":785,"_64":62,"_94":152},{"_62":63,"_66":781,"_68":782,"_64":783,"_94":144},{"_62":90,"_66":111,"_87":779,"_64":34,"_94":-7},{"_62":90,"_66":771,"_87":772,"_64":90,"_94":-7},{"_62":84,"_66":763,"_135":646,"_87":764,"_64":765,"_94":-7},{"_62":84,"_66":758,"_135":646,"_87":759,"_64":760,"_94":-7},{"_62":84,"_66":755,"_135":646,"_87":756,"_64":757,"_94":-7},{"_62":63,"_66":752,"_68":753,"_64":754,"_94":152},{"_62":63,"_64":749,"_66":750,"_68":751},{"_62":90,"_64":743,"_66":744,"_87":745},"identitySource","Identity evidence",[746],{"_66":747,"_34":748},"Microsoft / Playwright","https://github.com/microsoft/playwright-mcp","identity","Identity & attribution","Official Microsoft Playwright project. Use the real Playwright brand mark; it is a Microsoft-maintained MCP, unlike third-party engine bridges.","Source reviewed","2026-10-19","verified","Tracks",[150,314],"dimensions","Development stages",[761,762],"stages","Testing","Build & release","Topics",[766,767,768,769,770],"tags","Playwright","MCP","Browser testing","HUD","Canvas limitations","Further reading",[773,774],{"_66":777,"_34":778},{"_66":775,"_34":776},"Companion CLI + Skills","https://github.com/microsoft/playwright-cli","Pinned tools and security boundaries","https://github.com/microsoft/playwright-mcp/blob/b8b4183e099f136cbec0388a6088d4aa2f6b9685/README.md#security",[780],{"_66":111,"_34":748},"Why it belongs here","Useful for browser game menus, HUDs, launch flows, keyboard input, and screenshots. The default interface uses accessibility trees; coordinate-based mouse tools require the optional vision capability. Neither interface automatically exposes internal Canvas or WebGL state, so game debug instrumentation may be needed. The checked README warns that the server is not a security boundary and documents browser_run_code_unsafe as arbitrary JavaScript execution in the Playwright server process. The separate Playwright CLI repository provides a CLI + Skills workflow.","detail","Resource type","Tool","Category","Coding agents","summary","name","agents","tool",[766,767,768,769,770],[798,799],[157,316],[796,797],{"_66":777,"_34":778},{"_66":775,"_34":776},"test","ship",{"_801":802},"documents",{"_803":804,"_805":806},"en",[808,812,813,814,811,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,810,847,809,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865],"zh",[807,808,809,810,811],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contracts","asset-validation-contracts","asset-selection-feedback","visual-evidence-research","visual-feedback-mechanisms","game-development-evaluation","benchmark-reproducibility","gameplay-state-contracts","agent-interface-evidence","catalog-review-coverage","source-revision-notes","community-case-research","overview","catalog","contributing","media-sources","icon-sources","content-model","skills/level-design/SKILL","skills/level-design/LICENSE","skills/level-design/references/blockout-metrics","skills/level-design/references/case-studies","skills/level-design/references/combat-balance","skills/level-design/references/culture-history","skills/level-design/references/foundations","skills/level-design/references/learning","skills/level-design/references/lighting-art","skills/level-design/references/optimization-release","skills/level-design/references/scripting-doors","skills/level-design/references/source-map","skills/level-design/references/spatial-layout","skills/level-design/references/tools-quake","skills/level-design/references/wayfinding-playtesting","skills/level-design/templates/level-brief","skills/level-design/templates/playtest-report","skills/level-design/templates/review"]
