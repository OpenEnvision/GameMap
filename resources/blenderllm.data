,"Tracks","ordered",false,[78],"dimensions","3D","Development stages",[82,83],"stages","Assets & animation","Testing","Topics",[87,88,89,90],"tags","Text-to-bpy","CADBench","Dataset","Modeling benchmark","Further reading",[93,94,95,96],{"_52":102,"_25":103},{"_52":100,"_25":101},{"_52":88,"_25":99},{"_52":97,"_25":98},"Pinned release dataset description","https://github.com/FreedomIntelligence/BlenderLLM/blob/f778bfd6992ddd675f7615d0eaf965a8576f2879/README.md#L44-L50","https://huggingface.co/datasets/FreedomIntelligence/CADBench","BlendNet dataset","https://huggingface.co/datasets/FreedomIntelligence/BlendNet","Paper","https://arxiv.org/abs/2412.14203","Project source",[106],{"_52":104,"_25":58},"Why it belongs here","BlenderLLM generates bpy modeling scripts from user instructions. The repository and released dataset documentation report about 12K BlendNet pairs, and CADBench includes synthetic and forum-sourced tasks. Evaluation focuses on basic CAD-style modeling and instruction following. The README identifies limitations in advanced materials, multimodal input, and multi-turn collaboration; this is not a game creation benchmark.","detail","guidance","Resource type","Category","3D development","category","lead","summary","name","3d","paper",[127,128,129,130],[87,88,89,90],[125,126],[118],2024,"assets","test",{"_52":102,"_25":103},{"_52":100,"_25":101},{"_52":88,"_25":99},{"_52":97,"_25":98},{"_132":133},"documents",{"_134":135,"_136":137},"en",[139,143,144,145,142,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,141,178,140,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199],"zh",[138,139,140,141,142],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","resea