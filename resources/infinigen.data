ecording type","Original project recording","role","provenance","Track","3D","track","metadata","Related project",[90],"resourceId",{"_49":91,"_26":92},"Infinigen","/resources/infinigen/","What this recording shows","Procedurally generated articulated assets; this recording does not establish AI-authored gameplay.","limitations","Demo category","Asset generation","demoType","lead","source-recording","3d","assets","recordingId","infinigen","resource:infinigen","resource","Procedurally generates natural and indoor Blender scenes and synthetic data.","/resources/",{"_20":104,"_181":91,"_179":101,"_47":182,"_180":107,"_174":173,"_26":132,"_57":183,"_160":184,"_154":185,"_151":186,"_145":187,"_142":141},[112,113,114,115,116,117,118,119,120,121,122,123,124,125,126],"website/src/data/resources.json",{"_47":22,"_51":91,"_53":181,"_55":-7},{"_47":99,"_51":107,"_53":180,"_55":-7},{"_47":48,"_49":177,"_51":178,"_53":179,"_55":86},{"_47":48,"_49":175,"_51":176,"_53":47,"_55":86},{"_47":48,"_49":172,"_51":173,"_53":174,"_55":56},{"_47":57,"_49":169,"_59":170,"_53":26,"_55":-7},{"_47":57,"_49":165,"_59":166,"_53":57,"_55":-7},{"_47":146,"_49":158,"_148":149,"_59":159,"_53":160,"_55":-7},{"_47":146,"_49":152,"_148":149,"_59":153,"_53":154,"_55":-7},{"_47":146,"_49":147,"_148":149,"_59":150,"_53":151,"_55":-7},{"_47":48,"_49":143,"_51":144,"_53":145,"_55":86},{"_47":48,"_49":140,"_51":141,"_53":142,"_55":86},{"_47":136,"_53":137,"_49":138,"_70":72,"_78":139,"_33":63,"_54":52},{"_47":48,"_53":133,"_49":134,"_51":135},{"_47":57,"_53":127,"_49":128,"_59":129},"identitySource","Identity evidence",[130],{"_49":131,"_26":132},"Princeton University · Vision & Learning Lab","https://github.com/princeton-vl/infinigen","identity","Identity & attribution","The official repository is maintained by Princeton Vision & Learning Lab. The lab's official cs.princeton.edu homepage links this orange lab icon. It is the real lab identity rather than a reconstructed university seal.","image","projectMedia","Creator project media","Official Infinigen samples of procedurally generated forests, underwater scenes, deserts, and mountains","Source reviewed","2026-10-18","verified","Year","2023","year","list","Tracks","ordered",false,[84],"dimensions","Development stages",[155,156,157],"stages","Assets & animation","Engines & scenes","Testing","Topics",[161,162,163,164],"tags","Procedural generation","Blender","Synthetic data","Scenes","Further reading",[167],{"_49":168,"_26":63},"Project and paper","Project source",[171],{"_49":169,"_26":132},"Why it belongs here","Random seeds, parameters, and asset generators produce geometry, materials, scenes, and annotations, with export documentation for OBJ, OpenUSD, and other formats. This is a procedural system rather than a language model. It can provide controllable scenes and data for AI development workflows; real-time games still need optimization, collision, and gameplay integration.","detail","Resource type","Framework","Category","3D development","category","summary","name","framework",[190],[161,162,163,164],[102,188,189],[101],2023,"scene","test",{"_49":168,"_26":63},{"_192":193},"documents",{"_194":195,"_196":197},"en",[199,203,204,205,202,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,201,238,200,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256],"zh",[198,199,200,201,202],"reading-guide","practical-guide","level-design-skill","deployment","publishing-platforms","tutorials-and-demos","coding-agent-game-code","game-testing-library","agents-notes","engines-notes","game-ai-notes","cadle-repositories","world-model-notes","research-index","production-research-notes","engine-operation-contracts","production-work-orders","studio-production-case-studies","native-operation-details","production-debugging-contracts","production-coverage-gaps","generative-tools-research","generative-api-boundaries","generation-delivery-contrac