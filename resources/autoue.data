45,"_52":70,"_54":147,"_56":-7},{"_48":58,"_50":33,"_60":148,"_54":147,"_56":-7},{"_48":49,"_50":145,"_52":146,"_54":147,"_56":-7},{"_48":49,"_54":142,"_50":143,"_52":144},{"_48":58,"_54":137,"_50":138,"_60":139},"identitySource","Identity evidence",[140],{"_50":141,"_26":64},"Pluto156","identity","Identity & attribution","The public implementation is maintained by Pluto156. No independent project mark or institutional affiliation was verified from the repository. Show the real maintainer name; do not substitute an account portrait, identicon, or engine logo.","Access type","pipeline source","access",[149],{"_50":150,"_26":64,"_151":152},"Pipeline source","note","Public framework implementation; engine setup, model services, and dataset assets remain separate requirements.",[154],{"_50":155,"_26":156,"_151":157},"Game-generation video","https://github.com/Pluto156/AutoUE/blob/main/assets/show.mp4","Recorded demonstrations of generated Unreal games; no public browser-playable build verified.","tutorial",[160],{"_50":161,"_26":162,"_151":163},"Setup and usage","https://github.com/Pluto156/AutoUE#setup-and-usage","Author instructions for dependencies, service credentials, and running the Unreal generation pipeline.","Source reviewed","2026-10-19","verified","Year","2026","year","list","Tracks","ordered",false,[86],"dimensions","Development stages",[179,180,181,182,183],"stages","Planning","Gameplay & code","Assets & animation","Engines & scenes","Testing","Topics",[99,187,188,189],"tags","Game generation","Multi-agent","Research prototype","Further reading",[192,193,194],{"_50":199,"_26":200},{"_50":197,"_26":198},{"_50":195,"_26":196},"Pinned evaluation dispatcher","https://github.com/Pluto156/AutoUE/blob/8686a4d51c19813f2b3368bd73f685a940db7531/PCGGen_UE/Plugins/LLMEditor/Source/LLMEditor/Private/Core/EvaluateExecutor/EvaluateExecutor.cpp#L174-L186","Generated games and asset dataset","https://huggingface.co/datasets/Pluto156/AutoUE_DataSet","Paper","https://arxiv.or