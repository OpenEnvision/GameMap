Game%20v3.html","Complete single-file game with procedural scenery, characters, textures, and audio. Three.js loads from a public CDN, so network access is needed.",[1037],{"_841":1038,"_809":332,"_870":1039},"Play Midnight Pumpkin Hunt","Click to start. WASD moves, mouse looks, Shift sprints, F toggles the flashlight, and E lights a nearby pumpkin. Desktop WebGL browser required.",[1041],{"_841":1042,"_809":1029,"_870":-7},"Read the creator’s AI disclosure",[1044,1045,1046,1047],"Begin a hunt and test movement, flashlight, sprinting, and pumpkin interaction.","Read the author’s AI contribution disclosure.","Study procedural scenery, the stalker state, and its line-of-sight behavior.","Serve the HTML locally and adjust one visibility or stamina parameter.","The creator attributes the game collection to iterative Gemini and Claude development with minor manual balance edits. This individual game does not include a separate prompt log.","3D","Three.js · JavaScript","3d",[1044,1045,1046,1047],{"_841":1042,"_809":1029,"_802":891},{"_841":1038,"_809":332,"_802":974,"_870":1039},{"_841":1033,"_809":1034,"_870":1035,"_932":933},{"_841":1028,"_809":1029,"_870":1030},[931],"example:gemini-kymograph","Kymograph","A CRT-styled deduction puzzle: observe a signal, infer its hidden transformation rules, and construct the counter-signal.","/examples/gemini-kymograph/",{"_804":129,"_805":1059,"_807":1060,"_920":1104,"_916":922,"_912":923,"_908":1103,"_901":1105,"_892":1106,"_881":1107,"_816":1108,"_867":1109,"_857":1110},[1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081],{"_837":805,"_843":1059,"_839":805,"_858":-7},{"_837":921,"_843":1060,"_839":807,"_858":-7},{"_837":838,"_841":918,"_843":1104,"_839":920,"_858":909},{"_837":838,"_841":914,"_843":915,"_839":916,"_858":917},{"_837":838,"_841":910,"_843":911,"_839":912,"_858":913},{"_837":838,"_841":906,"_843":1103,"_839":908,"_858":909},{"_837":849,"_841":897,"_898":899,"_851":1098,"_839":90