 mechanic","A finished tower-defense game with time reversal and an extensive author-published prompt log covering mechanics, debugging, and polish.","/examples/tower-of-time-ai-build/",{"_804":179,"_805":3247,"_807":3248,"_920":1680,"_916":922,"_912":923,"_908":3300,"_901":3301,"_892":3302,"_881":3303,"_816":3304,"_867":3305,"_857":3306},[3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270],{"_837":805,"_843":3247,"_839":805,"_858":-7},{"_837":921,"_843":3248,"_839":807,"_858":-7},{"_837":838,"_841":918,"_843":1680,"_839":920,"_858":909},{"_837":838,"_841":914,"_843":915,"_839":916,"_858":917},{"_837":838,"_841":910,"_843":911,"_839":912,"_858":913},{"_837":838,"_841":906,"_843":3300,"_839":908,"_858":909},{"_837":849,"_841":897,"_898":899,"_851":3295,"_839":901,"_858":-7},{"_837":854,"_841":893,"_851":3291,"_839":892,"_858":-7},{"_837":838,"_841":890,"_843":2219,"_839":892,"_858":-7},{"_837":838,"_841":888,"_843":1794,"_839":881,"_858":-7},{"_837":854,"_841":882,"_851":3287,"_839":881,"_858":-7},{"_837":838,"_841":879,"_843":974,"_839":881,"_858":-7},{"_837":854,"_841":874,"_851":3283,"_839":816,"_858":-7},{"_837":838,"_841":872,"_843":873,"_839":816,"_858":-7},{"_837":854,"_841":865,"_851":3279,"_839":867,"_858":-7},{"_837":854,"_841":855,"_851":3274,"_839":857,"_858":-7},{"_837":849,"_839":11,"_841":850,"_851":3272},{"_837":844,"_839":845,"_841":223,"_191":3271,"_193":222,"_816":224,"_201":202,"_203":204,"_847":960},{"_837":838,"_839":840,"_841":842,"_843":200},"/GameMap/assets/media/learning/tower-of-time-ai-build.webp",[1257,3273],"Augment Code",[3275,3276],{"_841":1194,"_809":1195},{"_841":3277,"_809":3278},"Phaser · Examples","/resources/phaser-examples/",[3280],{"_841":2099,"_809":3281,"_870":3282},"https://github.com/maciej-trebacz/tower-of-time-game#vibe-coding-proof-of-concept","The author describes the AI tools used; the prompt log explicitly discloses manual code edits and scene work in Phaser Editor.",[3284],