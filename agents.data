s Cursor disclosure and the separate shooter README.","Open shooter/game.js and trace spawning, collisions, pickups, and game states.","Change one weapon or difficulty parameter, then replay through loss and restart.","Little Earth explicitly credits Cursor AI for development. The disclosure describes a family collaboration, rather than publishing a prompt transcript.",[1330,1331,1332,1333],{"_841":1042,"_809":1261,"_802":891},{"_841":1325,"_809":352,"_802":974,"_870":1326},{"_841":1320,"_809":1321,"_870":1322,"_932":933},{"_841":1315,"_809":1316,"_870":1317},[],"example:agent-arcade-copilot","Agent Arcade: Copilot builds desktop arcade games","A desktop arcade collection with a platformer and space shooters, wrapped in a transparent cross-platform overlay.","/examples/agent-arcade-copilot/",{"_804":141,"_805":1342,"_807":1343,"_920":1407,"_916":922,"_912":923,"_908":1406,"_901":1408,"_892":1409,"_881":1410,"_816":1411,"_867":1412,"_857":1413},[1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362,1363,1364,1365,1366],{"_837":805,"_843":1342,"_839":805,"_858":-7},{"_837":921,"_843":1343,"_839":807,"_858":-7},{"_837":838,"_841":918,"_843":1407,"_839":920,"_858":909},{"_837":838,"_841":914,"_843":915,"_839":916,"_858":917},{"_837":838,"_841":910,"_843":911,"_839":912,"_858":913},{"_837":838,"_841":906,"_843":1406,"_839":908,"_858":909},{"_837":849,"_841":897,"_898":899,"_851":1402,"_839":901,"_858":-7},{"_837":854,"_841":893,"_851":1398,"_839":892,"_858":-7},{"_837":838,"_841":890,"_843":1211,"_839":892,"_858":-7},{"_837":838,"_841":888,"_843":1397,"_839":881,"_858":-7},{"_837":854,"_841":882,"_851":1392,"_839":881,"_858":-7},{"_837":838,"_841":879,"_843":880,"_839":881,"_858":-7},{"_837":854,"_841":874,"_851":1387,"_839":816,"_858":-7},{"_837":838,"_841":872,"_843":873,"_839":816,"_858":-7},{"_837":854,"_841":865,"_851":1382,"_839":867,"_858":-7},{"_837":854,"_841":855,"_851":1377,"_839":857,"_858":-7},{"_837":849,"_839":11,"_841":850,"_851"